# CQ 13: Which resource plays which role in a control, and where does it sit in
# the chain?
#
# Reached through the inverse relations of the IEC 60050-351 pattern: a
# physical unit realises a functional unit, that unit is the source or the
# target of an action line, and the line is part of an action path.
#
# The role belongs to the functional unit, and one device may realise several,
# which the answer reports rather than resolves. A model wanting one role per
# device would have to assert a cardinality the standard does not state.
PREFIX aias:     <https://w3id.org/aias#>
PREFIX vdi3682:  <https://w3id.org/aias/odp/vdi3682#>
PREFIX iso7498:  <https://w3id.org/aias/odp/iso7498#>
PREFIX iec60050: <https://w3id.org/aias/odp/iec60050#>
PREFIX iso22989: <https://w3id.org/aias/odp/iso22989#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?resource ?unit ?line ?pathKind
WHERE {
  ?resource a ?rk . ?rk rdfs:subClassOf* aias:Resource .
  ?resource iec60050:realisesFunctionalUnit ?unit .
  OPTIONAL {
    { ?unit iec60050:isSourceOfActionLine ?line } UNION
    { ?unit iec60050:isTargetOfActionLine ?line }
    OPTIONAL { ?line iec60050:partOfActionPath ?path .
               ?path a ?pathKind .
               FILTER(?pathKind IN (iec60050:OpenActionPath, iec60050:ClosedActionPath)) }
  }
} ORDER BY ?resource ?unit
