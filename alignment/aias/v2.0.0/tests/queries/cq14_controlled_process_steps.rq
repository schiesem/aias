# CQ 14: Which process operators does a control act on?
#
# Ties the control subdomain to the technical process. IEC 60050-351 has a
# control act on a controlled system, which is a functional unit, and VDI 3682
# describes what happens there as a process operator. Neither standard states
# the connection, since neither knows the other.
PREFIX aias:     <https://w3id.org/aias#>
PREFIX vdi3682:  <https://w3id.org/aias/odp/vdi3682#>
PREFIX iso7498:  <https://w3id.org/aias/odp/iso7498#>
PREFIX iec60050: <https://w3id.org/aias/odp/iec60050#>
PREFIX iso22989: <https://w3id.org/aias/odp/iso22989#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?control ?controlKind ?step
WHERE {
  ?control aias:actsOnProcessOperator ?step .
  ?control a ?controlKind .
  ?controlKind rdfs:subClassOf* iec60050:Control .
  FILTER NOT EXISTS { ?control a ?n . ?n rdfs:subClassOf+ ?controlKind .
                      ?n rdfs:subClassOf* iec60050:Control }
} ORDER BY ?control ?step
