# CQ 08: On which kind of resource does each AI function run?
#
# Whether an inference runs on an edge device or in an external cloud is the
# architectural decision this model exists to record.
#
# Reading the two test cases beside each other is the point: case 1 answers
# with a cloud throughout, case 2 splits by the deadline the task imposes.
PREFIX aias:     <https://w3id.org/aias#>
PREFIX vdi3682:  <https://w3id.org/aias/odp/vdi3682#>
PREFIX iso7498:  <https://w3id.org/aias/odp/iso7498#>
PREFIX iec60050: <https://w3id.org/aias/odp/iec60050#>
PREFIX iso22989: <https://w3id.org/aias/odp/iso22989#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?function ?functionKind ?resource ?resourceKind
WHERE {
  ?assignment aias:assignedFunction ?function ;
              vdi3682:assignedResource ?resource .
  ?function a ?functionKind . ?functionKind rdfs:subClassOf* iso22989:AIFunction .
  FILTER NOT EXISTS { ?function a ?n . ?n rdfs:subClassOf+ ?functionKind .
                      ?n rdfs:subClassOf* iso22989:AIFunction }
  ?resource a ?resourceKind . ?resourceKind rdfs:subClassOf* aias:Resource .
  FILTER NOT EXISTS { ?resource a ?rn . ?rn rdfs:subClassOf+ ?resourceKind .
                      ?rn rdfs:subClassOf* aias:Resource }
} ORDER BY ?function
