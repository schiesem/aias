# CQ 21: Which data of a model originates from the technical process?
#
# Separates data measured in the plant from data brought in from elsewhere.
# The test is whether the acquisition that produced it is assigned to a
# resource, since an acquisition without one reaches nothing.
PREFIX aias:     <https://w3id.org/aias#>
PREFIX vdi3682:  <https://w3id.org/aias/odp/vdi3682#>
PREFIX iso7498:  <https://w3id.org/aias/odp/iso7498#>
PREFIX iec60050: <https://w3id.org/aias/odp/iec60050#>
PREFIX iso22989: <https://w3id.org/aias/odp/iso22989#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?data ?dataKind ?resource
WHERE {
  ?data a ?dataKind . ?dataKind rdfs:subClassOf iso22989:Data .
  ?data iso22989:isAcquiredBy ?acquisition .
  ?assignment aias:assignedFunction ?acquisition ;
              vdi3682:assignedResource ?resource .
} ORDER BY ?data
