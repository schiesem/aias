# CQ 04: Which resource performs a given function?
#
# The question the whole alignment is built for. An assignment ties a function
# to a resource, and because process operators and AI functions share a
# superclass, the same relation answers for both.
#
# VDI 3682 states the assignment from the process operator, which cannot reach
# an AI function. aias:assignedFunction closes that gap, and this query is
# where it earns its place.
PREFIX aias:     <https://w3id.org/aias#>
PREFIX vdi3682:  <https://w3id.org/aias/odp/vdi3682#>
PREFIX iso7498:  <https://w3id.org/aias/odp/iso7498#>
PREFIX iec60050: <https://w3id.org/aias/odp/iec60050#>
PREFIX iso22989: <https://w3id.org/aias/odp/iso22989#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
SELECT ?function ?resource
WHERE {
  ?assignment aias:assignedFunction ?function ;
              vdi3682:assignedResource ?resource .
} ORDER BY ?function
