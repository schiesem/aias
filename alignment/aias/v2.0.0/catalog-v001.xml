<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Maps the imported version IRIs onto the local files, so that Protégé and the
  OWL API resolve an import from the working copy rather than over the network.

  Written by hand. Protégé rewrites this file when its folder repository is
  active, and the entry it writes points every IRI at the ontology of this
  directory, which makes the import fail with "Ontology already exists".
  Turn that off under Preferences, New ontologies, Folder repository.
-->
<catalog prefer="public" xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
    <uri name="https://w3id.org/aias/odp/vdi3682/2.0.0"
         uri="../../../odps/vdi3682/v2.0.0/VDI3682.ttl"/>
    <uri name="https://w3id.org/aias/odp/iso7498/2.0.0"
         uri="../../../odps/iso7498/v2.0.0/ISO7498.ttl"/>
    <uri name="https://w3id.org/aias/odp/iso22989/2.0.0"
         uri="../../../odps/iso22989/v2.0.0/ISO22989.ttl"/>
    <uri name="https://w3id.org/aias/odp/iec60050/1.0.0"
         uri="../../../odps/iec60050/v1.0.0/IEC60050.ttl"/>
</catalog>
