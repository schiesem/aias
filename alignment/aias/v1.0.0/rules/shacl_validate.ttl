# Konsistenzregel: jede Funktion braucht eine Zuweisung.
#
# Listing "Beispiel fuer eine SHACL-Konsistenzregel" des
# Implementierungskapitels.
#
# Zwei Pfade, weil das Modell zwei Wege zur Zuweisung kennt: eine KI-Funktion
# erreicht sie ueber AIAS:isAssignedTo, ein ProcessOperator ueber
# VDI3682:isAssignedTo. sh:or laesst beide gelten, sonst meldete die Regel
# jeden Prozessoperator als Verletzung.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .

aias:FunctionShape
    a sh:NodeShape ;
    sh:targetClass aias:Function ;
    sh:or (
        [ sh:path aias:isAssignedTo    ; sh:node vdi3682:Assignment ; sh:minCount 1 ]
        [ sh:path vdi3682:isAssignedTo ; sh:node vdi3682:Assignment ; sh:minCount 1 ]
    ) ;
    sh:message "Jede Funktion muss mindestens einem Assignment zugewiesen bekommen haben." .
