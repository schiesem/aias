# V1  AISystem, Hochrisiko nach Anhang III
#
# Vorschriftenregel, severity sh:Info. Sie stellt keine Rechtslage fest,
# sondern weist auf eine Pruefpflicht hin.
#
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:V1_Shape
    a sh:NodeShape ;
    sh:targetClass iso22989:AISystem ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Es ist zu pruefen, ob das KI-System einer in Anhang III des EU AI Act genannten Anwendungskategorie zugeordnet ist oder als sicherheitsrelevante Funktion einer regulierten Anlage eingesetzt wird und damit als Hochrisiko-KI einzustufen ist." ;
        sh:select """
            SELECT $this
            WHERE {
                $this a iso22989:AISystem .
            }
        """ ;
    ] .
