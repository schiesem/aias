# V11  Inference und Automate auf demselben Geraet
#
# Vorschriftenregel, severity sh:Info. Sie stellt keine Rechtslage fest,
# sondern weist auf eine Pruefpflicht hin.
#
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:V11_Shape
    a sh:NodeShape ;
    sh:targetClass iso22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Inferenz und Automatisierung sind auf demselben Geraet eng gekoppelt. Pruefen, ob eine Hochrisikoeinstufung nach EU AI Act vorliegt." ;
        sh:select """
            SELECT $this ?resource ?automate
            WHERE {
                $this       aias:isAssignedTo    ?assignment .
                ?assignment vdi3682:isAssignedTo ?resource .
                ?automate   a iso22989:Automate ;
                            aias:isAssignedTo    ?a2 .
                ?a2         vdi3682:isAssignedTo ?resource .
            }
        """ ;
    ] .
