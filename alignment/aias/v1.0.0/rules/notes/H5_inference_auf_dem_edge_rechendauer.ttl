# H5  Inference auf dem Edge, Rechendauer
#
# Hinweisregel, severity sh:Info: kein Fehler, sondern ein Hinweis.
#

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:H5_Shape
    a sh:NodeShape ;
    sh:targetClass iso22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Die verfuegbare Rechenleistung auf dem Edge-Geraet ist eventuell nicht ausreichend, um das Modell in der geforderten Zeit auszufuehren. Bitte die Rechendauer pruefen." ;
        sh:select """
            SELECT $this ?resource
            WHERE {
                $this       aias:isAssignedTo    ?assignment .
                ?assignment vdi3682:isAssignedTo ?resource .
                ?resource a aias:EdgeDevice .
            }
        """ ;
    ] .
