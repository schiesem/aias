# H25  kein Training
#
# Hinweisregel, severity sh:Info.
#
# Existenzregeln zielen nicht auf einen Knoten, sondern auf das Modell als
# Ganzes. Traeger ist daher das AISystem: findet die Abfrage keine Instanz der
# gesuchten Klasse, meldet die Regel das System.
#
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:H25_Shape
    a sh:NodeShape ;
    sh:targetClass iso22989:AISystem ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Aktuell wird noch kein Modell trainiert. Wird auf ein Standardmodell zugegriffen oder fehlt das Training in der Modellierung?" ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?x a iso22989:Training }
            }
        """ ;
    ] .
