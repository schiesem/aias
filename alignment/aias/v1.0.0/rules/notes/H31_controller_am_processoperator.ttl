# H31  WENN eine Steuerung einem ProcessOperator zugewiesen ist
#
# Hinweisregel, severity sh:Info.
#
# Traeger ist die Ressource. Die Abfrage sucht eine Zuweisung, die sie mit
# einem Prozessoperator verbindet: das Geraet ist Teil des technischen
# Prozesses und wird zugleich Teil der KI-Anwendung.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:H31_Shape
    a sh:NodeShape ;
    sh:targetClass aias:Controller ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Bitte die Prozessverantwortlichen schriftlich informieren, dass die Steuerung des Prozessoperators Teil einer KI-Anwendung wird." ;
        sh:select """
            SELECT $this ?operator
            WHERE {
                ?assignment vdi3682:isAssignedTo $this .
                ?operator   vdi3682:isAssignedTo ?assignment ;
                            a                    vdi3682:ProcessOperator .
            }
        """ ;
    ] .
