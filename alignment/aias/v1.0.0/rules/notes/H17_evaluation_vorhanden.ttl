# H17  Evaluation vorhanden
#
# Hinweisregel, severity sh:Info. Gilt fuer jede Instanz der Klasse.
#
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .
@prefix iso22989: <https://w3id.org/aias/odp/iso22989#> .

aias:H17_Shape
    a sh:NodeShape ;
    sh:targetClass iso22989:Evaluation ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Bitte darauf achten, die Evaluation im Anlagenbetrieb in der richtigen Frequenz durchzufuehren oder ein Konzept im Lebenszyklus der KI-Anwendung zu erstellen." ;
        sh:select """
            SELECT $this WHERE { $this a iso22989:Evaluation }
        """ ;
    ] .
