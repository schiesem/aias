# S3  Jeder ProcessOperator muss mindestens mit einem Flow verbunden sein.
#
# Der Anhang nennt das eine Anpassung von S1: der Prozessoperator braucht
# keine Ressource, wohl aber einen Fluss. Beide Richtungen zaehlen, weil das
# Muster hasInput/isInput und hasOutput/isOutput als inverse Paare fuehrt und
# ein Modell die eine oder die andere Seite schreiben darf.

@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix aias:     <https://w3id.org/aias#> .
@prefix vdi3682:  <https://w3id.org/aias/odp/vdi3682#> .

aias:S3_ProcessOperatorShape
    a sh:NodeShape ;
    sh:targetClass vdi3682:ProcessOperator ;
    sh:property [
        sh:path [ sh:alternativePath (
            vdi3682:hasInput
            vdi3682:hasOutput
            [ sh:inversePath vdi3682:isInput ]
            [ sh:inversePath vdi3682:isOutput ]
        ) ] ;
        sh:class vdi3682:Flow ;
        sh:minCount 1 ;
        sh:message "S3: Jeder ProcessOperator muss mit mindestens einem Flow verbunden sein." ;
    ] .
