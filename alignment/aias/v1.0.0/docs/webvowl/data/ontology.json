    {
      "iri": "https://w3id.org/aias#Function",
      "baseIri": "https://w3id.org/aias",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "A construct of this work, following the system elements of Haberfellner et al., Systems Engineering, Springer 2019. The notion of a function is the general one of a purposeful transformation.\r\n\r\nWithout this class a process operator of VDI 3682 and an inference of ISO/IEC 22989 are unrelated things, and nothing can be said about both at once. Under one superclass they become comparable and are treated by the same mechanisms, above all the assignment to a component.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Funktion",
        "IRI-based": "Function",
        "en": "Function"
      },
      "subClasses": [
