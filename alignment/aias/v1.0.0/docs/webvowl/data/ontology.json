    {
      "iri": "https://w3id.org/aias#hasCommunication",
      "baseIri": "https://w3id.org/aias",
      "range": "4",
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "A communication describes the exchange of information between at least two resources, and an instance of it is tied to the components taking part, which makes the technical realisation of a data flow explicit.\r\n\r\nThe two relations below differentiate the direction. They are not subproperties of this one: a sensor that only sends carries hasOutputCommunication and nothing else, and a reasoner that inferred hasCommunication from it would report the sensor as bidirectional, which is the opposite of what the model states.\r\n\r\nThe domain is the component rather than the resource on purpose. A product may take part in a communication as well: a workpiece carrying an RFID tag or a barcode is read along the line, and restricting the relation to resources would rule that out.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "hat Kommunikation",
        "IRI-based": "hasCommunication",
        "en": "has communication"
      },
      "domain": "1",
      "comment": {
        "de": "Verbindet eine Komponente mit einer Kommunikation, an der sie teilnimmt. Definiert eine bidirektionale Nutzung.",
        "en": "Relates a component to a communication it takes part in. States a bidirectional use."
      },
      "attributes": [
        "object",
        "external"
      ],
      "id": "27"
    },
    {
      "iri": "https://w3id.org/aias#hasRelation",
      "baseIri": "https://w3id.org/aias",
      "range": "14",
      "label": {
        "de": "hat Relation",
        "IRI-based": "hasRelation",
        "en": "has relation"
      },
      "domain": "33",
      "comment": {
        "de": "Verbindet ein KI-System mit einer Verbindung zwischen seinen Funktionen und Komponenten.",
        "en": "Relates an AI system to a tie between its functions and its components."
      },
      "attributes": [
        "object",
        "external"
      ],
      "id": "32"
    },
