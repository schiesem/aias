        "7"
      ],
      "comment": {
        "de": "Beschreibt Transformationen, durch die Eingaben in Ausgaben überführt werden, um Systemziele zu erreichen.",
        "en": "Describes transformations by which inputs are turned into outputs in order to reach the objectives of a system."
      },
      "attributes": [
        "external"
