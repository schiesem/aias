    <!-- https://w3id.org/aias/odp/iec60050/instances#ControlRiseTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#ControlRiseTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">The interval after a step change of the reference variable or a disturbance variable, beginning when the controlled variable first leaves an agreed tolerance band around its desired value and ending when it first returns into that band.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Rise Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-46-01. English wording reconstructed from the German entry. It ends at the first return, whereas the control settling time requires the controlled variable to stay inside.</skos:note>
        <iec60050:symbol>T_cr</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#ControlSettlingTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#ControlSettlingTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">The interval after a step change of the reference variable or a disturbance variable, beginning when the controlled variable first leaves an agreed tolerance band around its desired value and ending when it returns into that band and remains within it.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Settling Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-46-02. English wording reconstructed from the German entry. The sharper of the two criteria, since it requires the controlled variable to stay inside the band.</skos:note>
        <iec60050:symbol>T_cs</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#DeadBand -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#DeadBand">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#QualityCharacteristic"/>
        <rdfs:comment xml:lang="en">A finite range of values of the input variable within which a variation of the input variable does not produce any measurable change in the output variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Dead Band</rdfs:label>
        <skos:altLabel xml:lang="en">dead zone</skos:altLabel>
        <skos:note xml:lang="en">IEC 60050-351, 351-45-15. The range in which an output has no effect, which matters when a control writes a value too small to act.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#DeadTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#DeadTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">In a dead-time element, the duration of the time interval by which the output variable is shifted relative to the input variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Dead Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-50-30. The interval by which a processing step delays what passes through it.</skos:note>
        <iec60050:symbol>T_t</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#EquivalentDeadTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#EquivalentDeadTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">In a step response, the interval between the step change of the input variable and the intersection of the inflection tangent with the horizontal axis of the initial value.</rdfs:comment>
        <rdfs:label xml:lang="en">Equivalent Dead Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-45-34. English wording reconstructed from the German entry, since the English text is interrupted by a formula figure in the printed standard. The entry notes that the definition holds only for systems without overshoot.</skos:note>
        <iec60050:symbol>T_u</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#GainMargin -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#GainMargin">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#QualityCharacteristic"/>
        <rdfs:comment xml:lang="en">The reciprocal of the gain response of the open control loop at the phase crossover angular frequency.</rdfs:comment>
        <rdfs:label xml:lang="en">Gain Margin</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-46-07. English wording reconstructed from the German entry. The second stability reserve, alongside the phase margin.</skos:note>
        <iec60050:symbol>G_m</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#InterruptReactionTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#InterruptReactionTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">The duration of the time interval that elapses between the arrival of an interrupt signal at the interrupt input unit and the instant of decision whether the interrupt is handled or not.</rdfs:comment>
        <rdfs:label xml:lang="en">Interrupt Reaction Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-54-18. The only latency measure the standard defines.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#ManipulatingTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#ManipulatingTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">The duration of the time interval in which the manipulated variable runs with the highest speed through its whole range.</rdfs:comment>
        <rdfs:label xml:lang="en">Manipulating Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-17. The time measure closest to a device, since it belongs to the manipulating equipment.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#Overshoot -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#Overshoot">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#QualityCharacteristic"/>
        <rdfs:comment xml:lang="en">In a step response, the largest transient deviation of the output variable from its final steady-state value, usually expressed as a percentage of the difference between its final and its initial steady-state value.</rdfs:comment>
        <rdfs:label xml:lang="en">Overshoot</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-45-38. English wording reconstructed from the German entry.</skos:note>
        <iec60050:symbol>X_m</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#PhaseMargin -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#PhaseMargin">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#QualityCharacteristic"/>
        <rdfs:comment xml:lang="en">The difference between the phase response of the open control loop at the gain crossover angular frequency and minus pi radians.</rdfs:comment>
        <rdfs:label xml:lang="en">Phase Margin</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-46-05. English wording reconstructed from the German entry. A stability reserve: how much additional phase lag a loop tolerates before it becomes unstable.</skos:note>
        <iec60050:symbol>phi_m</iec60050:symbol>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#SamplingPeriod -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#SamplingPeriod">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">The duration of the time interval between two consecutive observations in a periodic sampling control system.</rdfs:comment>
        <rdfs:label xml:lang="en">Sampling Period</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-16. The normative equivalent of what practice calls cycle time, a term the standard does not define.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#SettlingTime -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#SettlingTime">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">In a step response, the interval between the step change of the input variable and the instant from which the difference between the step response and its steady-state value stays smaller than the tolerance band.</rdfs:comment>
        <rdfs:label xml:lang="en">Settling Time</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-45-37. English wording reconstructed from the German entry.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050/instances#TimeConstant -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050/instances#TimeConstant">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#TimeCharacteristic"/>
        <rdfs:comment xml:lang="en">For a quantity growing or decaying exponentially towards a constant value, the duration of a time interval at the end of which the absolute difference to that value has decreased to 1/e of its initial amount.</rdfs:comment>
        <rdfs:label xml:lang="en">Time Constant</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-45-32.</skos:note>
        <iec60050:symbol>T</iec60050:symbol>
    </owl:NamedIndividual>
    


