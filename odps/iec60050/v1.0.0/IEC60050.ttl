@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix vann:     <http://purl.org/vocab/vann/> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <https://schema.org/> .

#################################################################
#    Ontology
#################################################################

<https://w3id.org/aias/odp/iec60050>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aias/odp/iec60050/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "IEC 60050-351 Ontology Design Pattern"@en ;
    dcterms:abstract """An ontology design pattern for the terminology of control technology, following DIN IEC 60050-351:2014, the International Electrotechnical Vocabulary. It models a control as a chain of action paths and actions, which is what allows open-loop and closed-loop control to be told apart by structure rather than by name: a closed-loop control requires a closed action, not merely a closed path. Around that it holds the variable quantities of a control loop, the items under consideration with their functional and physical units, the normative taxonomy of control functions, and the characteristics a device carries with their values and units. Seventy-nine classes drawn from 86 of the standard's 409 entries, with the selection documented entry by entry."""@en ;
    dcterms:created "2026-08-18"^^xsd:date ;
    dcterms:modified "2026-09-02"^^xsd:date ;
    dcterms:creator "Marvin Schieseck" ;
    dcterms:publisher "Helmut-Schmidt-Universität / Universität der Bundeswehr Hamburg" ;
    dcterms:rights """This research is funded by dtec.bw – Digitalization and Technology Research Center of the Bundeswehr. dtec.bw is funded by the European Union – NextGenerationEU"""@en ;
    foaf:fundedBy <https://dtecbw.de/> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source <https://www.dinmedia.de/de/norm/din-iec-60050-351/208013542> ;
    dcterms:subject "Control Technology"@en ;
    dcterms:subject "IEC 60050-351"@en ;
    dcterms:subject "Ontology Design Pattern"@en ;
    dcterms:subject "Closed-loop Control"@en ;
    dcterms:subject "Automation"@en ;
    schema:codeRepository <https://github.com/schiesem/aias> ;
    dcterms:hasVersion <https://w3id.org/aias/odp/iec60050> ;
    bibo:status "Draft"@en ;
    vann:preferredNamespaceUri "https://w3id.org/aias/odp/iec60050#" ;
    vann:preferredNamespacePrefix "iec60050" ;
    rdfs:comment """Normative basis: DIN IEC 60050-351:2014, identical to IEC 60050-351:2013.

The standard holds 409 entries and this pattern takes up 86 of them. REFERENCE.md lists every entry with the reason it is taken or left out, so the selection is checkable rather than asserted. Roughly 150 entries are the mathematical apparatus of control theory, such as transfer functions and Nyquist plots, which an engineering model names but never instantiates.

Three readings of the standard are easy to get wrong and are therefore stated here. An actuator, 351-49-07, is the signal side driving the final controlling element, not the element acting on the flow. The final controlling element, 351-49-08, belongs to the controlled system, which this pattern records as a relation so that another pattern may hold it as a resource without contradiction. And the standard defines no sensor: it says sensing element, 351-56-26, and grades further by accuracy and signal standardisation.

Terms the standard does not define, and which have to come from elsewhere: availability and reliability from IEC 60050-192, accuracy and resolution from IEC 60050-300, safety integrity from IEC 61508, and everything concerning data quality from ISO/IEC 22989."""@en .

dcterms:title a owl:AnnotationProperty .
dcterms:abstract a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:publisher a owl:AnnotationProperty .
dcterms:rights a owl:AnnotationProperty .
foaf:fundedBy a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:source a owl:AnnotationProperty .
dcterms:subject a owl:AnnotationProperty .
schema:codeRepository a owl:AnnotationProperty .
dcterms:hasVersion a owl:AnnotationProperty .
bibo:status a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
skos:note a owl:AnnotationProperty .
skos:altLabel a owl:AnnotationProperty .

#################################################################
#    Annotation properties
#################################################################


#################################################################
#    Control and automation
#################################################################

iec60050:Control
    a owl:Class ;
    rdfs:label "Control"@en ;
    rdfs:comment "Purposeful action on or in a process to meet specified objectives."@en ;
    skos:note """IEC 60050-351, 351-42-19. The German term is Leiten, which covers both open-loop and closed-loop control as well as the supervisory tasks around them. National footnote N1 of that entry states this explicitly: control is the general term here, and the narrower Regeln and Steuern belong to the entries below.

No class for automating sits between this class and the two kinds of control. The standard defines automating in 351-43 as a task, alongside measuring and monitoring, not in 351-47 as a kind of control, and 351-42-31 treats the degree of automation as a proportion of the functions of a system. A hand-operated closed-loop control is a closed-loop control by 351-47-01 without being automated, so a subclass axiom would state more than the standard does. Whether a control runs by itself is recorded through the AI pattern, where automation is a function, and the two are related in the alignment."""@en ;
    owl:disjointWith iec60050:ActionPath, iec60050:Action, iec60050:VariableQuantity,
                     iec60050:ItemUnderConsideration, iec60050:Characteristic, iec60050:CharacteristicValue .

iec60050:OpenLoopControl
    a owl:Class ;
    rdfs:label "Open-loop Control"@en ;
    rdfs:comment "A process whereby one or more variable quantities as input variables influence other variable quantities as output variables in accordance with the proper laws of the system."@en ;
    skos:note """IEC 60050-351, 351-47-02. Characteristic for open-loop control is the open action path, or in a closed action path the fact that the output variables being influenced by the input variables are not continuously or sequentially influencing themselves and not by the same input variables.

Deliberately **not** disjoint with closed-loop control: the standard admits open-loop control in a closed action path, so a disjointness axiom would contradict it. What separates the two is the action, not the path."""@en ;
    rdfs:subClassOf iec60050:Control .

iec60050:ClosedLoopControl
    a owl:Class ;
    rdfs:label "Closed-loop Control"@en ;
    skos:altLabel "feedback control"@en ;
    rdfs:comment "A process whereby one variable quantity, namely the controlled variable, is continuously or sequentially measured, compared with another variable quantity, namely the reference variable, and influenced in such a manner as to adjust to the reference variable."@en ;
    skos:note "IEC 60050-351, 351-47-01. Characteristic for closed-loop control is the closed action in which the controlled variable continuously or sequentially influences itself in the action path of the closed loop. The closed action is required, not merely a closed path."@en ;
    rdfs:subClassOf iec60050:Control .

#################################################################
#    Kinds of control, with the genus the standard states
#
#    Most definitions in 351-47 begin with "closed-loop control in which ..."
#    and thereby fix the genus. Where they do not, the class sits directly
#    under Control and a model may assign it either way.
#################################################################

iec60050:SamplingControl
    a owl:Class ;
    rdfs:label "Sampling Control"@en ;
    rdfs:comment "Closed-loop control in which the input variables of the controlling system are taken discontinuously in time to generate new values of the manipulated variable, which are updated discontinuously and maintained by holding elements between updates."@en ;
    skos:note "IEC 60050-351, 351-47-15. Its sampling period, 351-47-16, is the normative equivalent of what practice calls cycle time, a term the standard does not define."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:CascadeControl
    a owl:Class ;
    rdfs:label "Cascade Control"@en ;
    rdfs:comment "Closed-loop control in which the output variable of one controller is the reference variable of one or more secondary control loops."@en ;
    skos:note "IEC 60050-351, 351-47-25."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:ModelBasedControl
    a owl:Class ;
    rdfs:label "Model-based Control"@en ;
    rdfs:comment "Closed-loop control which includes explicitly in its structure a real-time model of the process expressing the static and dynamic relationships between manipulated variables and controlled variables."@en ;
    skos:note "IEC 60050-351, 351-47-33. The definition names a real-time model of the process, which is the natural place for a data driven process model in a control structure."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:MultivariableControl
    a owl:Class ;
    rdfs:label "Multivariable Control"@en ;
    rdfs:comment "Closed-loop control of several controlled variables of a multivariable system by several controllers."@en ;
    skos:note "IEC 60050-351, 351-47-35."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:AdaptiveControl
    a owl:Class ;
    rdfs:label "Adaptive Control"@en ;
    rdfs:comment "Closed-loop control with automatic modification of the structure or parameters of the controlling system to compensate for varying operating conditions and states."@en ;
    skos:note "IEC 60050-351, 351-47-42. The automatic modification is what a learning system performs online."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:RobustControl
    a owl:Class ;
    rdfs:label "Robust Control"@en ;
    rdfs:comment "Closed-loop control able to keep system properties within a prescribed area even if the properties of the controlled system or of the controller deviate from those assumed for the design."@en ;
    skos:note "IEC 60050-351, 351-47-45. The deviation from the properties assumed for the design is what a data driven model faces as a shift of its operating conditions."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:FuzzyControl
    a owl:Class ;
    rdfs:label "Fuzzy Control"@en ;
    rdfs:comment "Closed-loop control in which the control algorithm is expressed by fuzzy logic using facts, inference rules and quantifiers based on experience and intuition."@en ;
    skos:note "IEC 60050-351, 351-47-56."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:RuleBasedControl
    a owl:Class ;
    rdfs:label "Rule-based Control"@en ;
    rdfs:comment "Closed-loop control in which the control algorithm explicitly incorporates one or more sets of rules."@en ;
    skos:note "IEC 60050-351, 351-47-58. The standard assigns this to closed-loop control explicitly, so the pattern follows rather than leaving it open."@en ;
    rdfs:subClassOf iec60050:ClosedLoopControl .

iec60050:SequentialControl
    a owl:Class ;
    rdfs:label "Sequential Control"@en ;
    rdfs:comment "Open-loop control with stepwise control actions in which the transition from one step to the following is determined by a program in accordance with specified transition conditions."@en ;
    skos:note "IEC 60050-351, 351-47-59. The one kind in this group the standard assigns to open-loop control."@en ;
    rdfs:subClassOf iec60050:OpenLoopControl .

iec60050:OptimalControl
    a owl:Class ;
    rdfs:label "Optimal Control"@en ;
    rdfs:comment "A type of control for which the performance index reaches a largest or smallest value under specified conditions."@en ;
    skos:note "IEC 60050-351, 351-47-41. The standard says type of control rather than closed-loop control, so the class sits under Control and a model may assign it either way."@en ;
    rdfs:subClassOf iec60050:Control .

iec60050:ProgrammedControl
    a owl:Class ;
    rdfs:label "Programmed Control"@en ;
    rdfs:comment "Control the functions of which are defined by a program that was previously entered."@en ;
    skos:note "IEC 60050-351, 351-47-20. The standard states no genus beyond control, so the class sits under Control. Storage-programmable logic control, 351-47-22, is a kind of this, which is how the standard covers what practice calls a programmable logic controller."@en ;
    rdfs:subClassOf iec60050:Control .

iec60050:ComputerControl
    a owl:Class ;
    rdfs:label "Computer Control"@en ;
    rdfs:comment "A type of control in which a computer is used in the controlling system."@en ;
    skos:note "IEC 60050-351, 351-47-52. No genus beyond control is stated."@en ;
    rdfs:subClassOf iec60050:Control .

#################################################################
#    Action path and action: structure against behaviour
#
#    This is what the pattern exists for. The path says whether something
#    returns; the action says whether the return acts continuously. Only the
#    closed action makes a closed-loop control, 351-47-01.
#################################################################

iec60050:ActionPath
    a owl:Class ;
    rdfs:label "Action Path"@en ;
    rdfs:comment "A directed path within a control structure, which connects two selected variable quantities."@en ;
    skos:note "IEC 60050-351, 351-44-03. Structure, not behaviour."@en ;
    owl:disjointWith iec60050:Action, iec60050:VariableQuantity, iec60050:ItemUnderConsideration,
                     iec60050:Characteristic, iec60050:CharacteristicValue .

iec60050:OpenActionPath
    a owl:Class ;
    rdfs:label "Open Action Path"@en ;
    rdfs:comment "An action path between the input variable and the output variable at which no action path goes back from the output variable to the input variable."@en ;
    skos:note "IEC 60050-351, 351-47-05."@en ;
    rdfs:subClassOf iec60050:ActionPath ;
    owl:disjointWith iec60050:ClosedActionPath .

iec60050:ClosedActionPath
    a owl:Class ;
    rdfs:label "Closed Action Path"@en ;
    rdfs:comment "An action path between the input variable and the output variable at which an additional action path goes back from the output variable to the input variable."@en ;
    skos:note "IEC 60050-351, 351-47-03. A closed path alone does not make a closed-loop control: see the open action, 351-47-06."@en ;
    rdfs:subClassOf iec60050:ActionPath .

iec60050:Action
    a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "The influence of one variable quantity on another variable quantity."@en ;
    skos:note "IEC 60050-351, 351-42-24. Behaviour, not structure."@en ;
    owl:disjointWith iec60050:VariableQuantity, iec60050:ItemUnderConsideration,
                     iec60050:Characteristic, iec60050:CharacteristicValue .

iec60050:OpenAction
    a owl:Class ;
    rdfs:label "Open Action"@en ;
    rdfs:comment "An action in an open action path, or in a closed action path where the output variable influences the input variable only under certain non-permanently acting conditions."@en ;
    skos:note """IEC 60050-351, 351-47-06. The note to the entry states that a reset circuit, 351-47-62, has an open action although its structure has a closed action path.

This is the case that separates the pattern from the simplified reading that feedback alone makes a closed-loop control."""@en ;
    rdfs:subClassOf iec60050:Action ;
    owl:disjointWith iec60050:ClosedAction .

iec60050:ClosedAction
    a owl:Class ;
    rdfs:label "Closed Action"@en ;
    rdfs:comment "An action in a closed action path in which the output variable is continuously or sequentially influencing the input variable and thus continuously or sequentially influencing itself."@en ;
    skos:note "IEC 60050-351, 351-47-04. This, not the closed path, is what closed-loop control requires."@en ;
    rdfs:subClassOf iec60050:Action .

iec60050:ForwardPath
    a owl:Class ;
    rdfs:label "Forward Path"@en ;
    rdfs:comment "An action path connecting the output of a comparing element to the output of the controlled system."@en ;
    skos:note "IEC 60050-351, 351-47-07."@en ;
    rdfs:subClassOf iec60050:ActionPath .

iec60050:FeedbackPath
    a owl:Class ;
    rdfs:label "Feedback Path"@en ;
    rdfs:comment "An action path connecting an output of the controlled system to one of the inputs of the related comparing element."@en ;
    skos:note "IEC 60050-351, 351-47-08."@en ;
    rdfs:subClassOf iec60050:ActionPath .

#################################################################
#    Structure
#################################################################

iec60050:ControlLoop
    a owl:Class ;
    rdfs:label "Control Loop"@en ;
    rdfs:comment "A set of elements or systems incorporated in the closed action of a closed-loop control."@en ;
    skos:note "IEC 60050-351, 351-47-11."@en ;
    owl:disjointWith iec60050:ControlChain .

iec60050:ControlChain
    a owl:Class ;
    rdfs:label "Control Chain"@en ;
    rdfs:comment "A set of elements or systems which act upon one another in a series structure."@en ;
    skos:note "IEC 60050-351, 351-47-12. The arrangement of an open-loop control, as against the loop of a closed-loop control."@en .

iec60050:ActionLine
    a owl:Class ;
    rdfs:label "Action Line"@en ;
    rdfs:comment "A part of the action path between two functional units, the direction of action being indicated by an arrow."@en ;
    skos:note """IEC 60050-351, 351-44-04, drawn as the arrows of Figures 1 and 2.

The class resolves an action path into the units it runs through. Without it a path can only be asserted to be open or closed; with it the assertion becomes checkable against the units and the variables actually recorded.

Disjoint from the action path: a line is a part of a path, not a path of its own."""@en ;
    owl:disjointWith iec60050:ActionPath .

#################################################################
#    Variables and signals
#################################################################

iec60050:VariableQuantity
    a owl:Class ;
    rdfs:label "Variable Quantity"@en ;
    rdfs:comment "A physical quantity the value of which is subject to change and which can usually be measured."@en ;
    skos:note "IEC 60050-351, 351-41-01. The standard notes that the short form quantity is often used for it."@en ;
    owl:disjointWith iec60050:ItemUnderConsideration, iec60050:Characteristic, iec60050:CharacteristicValue .

iec60050:InputVariable
    a owl:Class ;
    rdfs:label "Input Variable"@en ;
    rdfs:comment "A variable quantity which is acting on a system from the outside and which is independent of the other variable quantities of the system."@en ;
    skos:note "IEC 60050-351, 351-41-06."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:OutputVariable
    a owl:Class ;
    rdfs:label "Output Variable"@en ;
    rdfs:comment "A recordable variable quantity generated by a system, influenced only by the system and via the system by its input variables."@en ;
    skos:note "IEC 60050-351, 351-41-07."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:StateVariable
    a owl:Class ;
    rdfs:label "State Variable"@en ;
    rdfs:comment "An element of the state vector of a system, from which together with the input variables the output variables are determined."@en ;
    skos:note "IEC 60050-351, 351-41-08. The entry states this through the state equation and the output equation; the wording here is the prose form of that."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:ControlledVariable
    a owl:Class ;
    rdfs:label "Controlled Variable"@en ;
    rdfs:comment "The output variable of the controlled system that will be acted upon by one or more manipulated variables."@en ;
    skos:note "IEC 60050-351, 351-48-01. Only a closed-loop control has one: it is what is measured and compared with the reference variable."@en ;
    rdfs:subClassOf iec60050:OutputVariable .

iec60050:ReferenceVariable
    a owl:Class ;
    rdfs:label "Reference Variable"@en ;
    rdfs:comment "An input variable to a comparing element in a controlling system, which sets the desired value of the controlled variable and is deducted from the command variable."@en ;
    skos:note "IEC 60050-351, 351-48-02."@en ;
    rdfs:subClassOf iec60050:InputVariable .

iec60050:FeedbackVariable
    a owl:Class ;
    rdfs:label "Feedback Variable"@en ;
    rdfs:comment "A variable quantity which represents the controlled variable and is returned to the comparing element."@en ;
    skos:note "IEC 60050-351, 351-48-03."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:ManipulatedVariable
    a owl:Class ;
    rdfs:label "Manipulated Variable"@en ;
    rdfs:comment "The output variable of the controlling system, which is also an input variable of the controlled system."@en ;
    skos:note "IEC 60050-351, 351-48-07. It is what carries the influence from the controlling side to the controlled side, in open-loop as in closed-loop control."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:DisturbanceVariable
    a owl:Class ;
    rdfs:label "Disturbance Variable"@en ;
    rdfs:comment "An undesired, independent and mostly unpredictable input variable acting from the outside on the system."@en ;
    skos:note "IEC 60050-351, 351-48-08."@en ;
    rdfs:subClassOf iec60050:InputVariable .

iec60050:CommandVariable
    a owl:Class ;
    rdfs:label "Command Variable"@en ;
    rdfs:comment "A variable quantity which is not influenced by the control but is introduced into the control system from outside with the aim of making the final controlled variable follow it."@en ;
    skos:note "IEC 60050-351, 351-48-09."@en ;
    rdfs:subClassOf iec60050:InputVariable .

iec60050:ControlDifferenceVariable
    a owl:Class ;
    rdfs:label "Control Difference Variable"@en ;
    rdfs:comment "The difference between the reference variable and the feedback variable."@en ;
    skos:note "IEC 60050-351, 351-48-05, marked e in Figure 2. It exists only where a comparison takes place, which is why it appears in the closed-loop figure alone."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:ControllerOutputVariable
    a owl:Class ;
    rdfs:label "Controller Output Variable"@en ;
    rdfs:comment "The output variable of the controlling element, which is the input variable of the actuator."@en ;
    skos:note "IEC 60050-351, 351-48-06, marked m in Figures 1 and 2."@en ;
    rdfs:subClassOf iec60050:OutputVariable .

iec60050:FinalControlledVariable
    a owl:Class ;
    rdfs:label "Final Controlled Variable"@en ;
    rdfs:comment "The variable quantity that the control is ultimately intended to influence, formed from the controlled variable."@en ;
    skos:note """IEC 60050-351, 351-48-10, marked q in Figures 1 and 2.

The entry adds that the final controlled variable need not belong to the control loop itself: where a mixture composition cannot be measured directly, a dependent property such as density or thermal conductivity is used as the controlled variable while the composition remains the final controlled variable."""@en ;
    rdfs:subClassOf iec60050:OutputVariable .

iec60050:Signal
    a owl:Class ;
    rdfs:label "Signal"@en ;
    rdfs:comment "A physical variable quantity, one or more parameters of which carry information about one or more variable quantities."@en ;
    skos:note "IEC 60050-351, 351-41-17. The separation of the carrier from the information it carries is what lets a model tell sensing hardware from the data point it produces."@en ;
    rdfs:subClassOf iec60050:VariableQuantity .

iec60050:InformationParameter
    a owl:Class ;
    rdfs:label "Information Parameter"@en ;
    rdfs:comment "A parameter of a signal that represents information according to a rule."@en ;
    skos:note "IEC 60050-351, 351-41-18."@en .

#################################################################
#    Items under consideration, units and devices
#
#    The standard specialises the item under consideration along two
#    orthogonal axes, by function and by construction. One physical unit may
#    realise several functional units and the other way round, which is the
#    distinction a pattern needs to tell a controller as a function from a
#    controller as a purchasable device.
#################################################################

iec60050:ItemUnderConsideration
    a owl:Class ;
    rdfs:label "Item under Consideration"@en ;
    rdfs:comment "An object under consideration defined according to function and scope."@en ;
    skos:note "IEC 60050-351, 351-56-01."@en ;
    owl:disjointWith iec60050:Characteristic, iec60050:CharacteristicValue .

iec60050:FunctionalUnit
    a owl:Class ;
    rdfs:label "Functional Unit"@en ;
    rdfs:comment "An item under consideration defined according to function or effect."@en ;
    skos:note "IEC 60050-351, 351-56-02. The functional view: what something does, irrespective of how it is built."@en ;
    rdfs:subClassOf iec60050:ItemUnderConsideration .

iec60050:PhysicalUnit
    a owl:Class ;
    rdfs:label "Physical Unit"@en ;
    rdfs:comment "An item under consideration defined according to construction or configuration."@en ;
    skos:note "IEC 60050-351, 351-56-03. The building view: the device as it is bought and installed. Not disjoint with the functional unit, since the two are views rather than kinds."@en ;
    rdfs:subClassOf iec60050:ItemUnderConsideration .

iec60050:ControlEquipment
    a owl:Class ;
    rdfs:label "Control Equipment"@en ;
    rdfs:comment "The entirety of devices and programs used for the task of controlling, and in a broader sense all instructions and programs used for it."@en ;
    skos:note "IEC 60050-351, 351-56-24. A note to the entry includes the process control station and the operating manuals, which is how the standard covers what practice calls a control room."@en ;
    rdfs:subClassOf iec60050:ItemUnderConsideration .

iec60050:ControlledSystem
    a owl:Class ;
    rdfs:label "Controlled System"@en ;
    rdfs:comment "A functional unit which is to be influenced according to the control task."@en ;
    skos:note "IEC 60050-351, 351-49-01. The German terms are Regelstrecke and Steuerstrecke, so the class covers the plant side of both kinds of control."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ControllingSystem
    a owl:Class ;
    rdfs:label "Controlling System"@en ;
    rdfs:comment "A functional unit that generates the manipulated variable at its output, from the command variable in open-loop control and from the reference variable and the feedback variable in closed-loop control."@en ;
    skos:note "IEC 60050-351, 351-49-02."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit ;
    owl:disjointWith iec60050:ControlledSystem .

iec60050:SensingElement
    a owl:Class ;
    rdfs:label "Sensing Element"@en ;
    rdfs:comment "A functional unit that senses the effect of a measurand at its input and places a corresponding measurement signal at its output."@en ;
    skos:note "IEC 60050-351, 351-56-26, with a thermocouple, a foil strain gauge and a pH electrode as its examples. The standard defines no term sensor; this is the entry practice means by it."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:MeasuringTransmitter
    a owl:Class ;
    rdfs:label "Measuring Transmitter"@en ;
    rdfs:comment "A measuring transducer the output variable of which is a standardized signal."@en ;
    skos:note "IEC 60050-351, 351-56-29. The standardised signal is where the communication subdomain begins, which makes this the handover point to the communication pattern."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:Actuator
    a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:comment "A functional unit that generates the manipulated variable, required to drive the final controlling element, from the output variable of the controlling element."@en ;
    skos:note """IEC 60050-351, 351-49-07.

The German term is Steller, and the entry is the signal side of the manipulating equipment, not the element acting on the flow. That element is the final controlling element, 351-49-08. The common rendering of the German Aktor as actuator conflates the two and would put the wrong class on a valve."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:FinalControllingElement
    a owl:Class ;
    rdfs:label "Final Controlling Element"@en ;
    rdfs:comment "A functional unit forming part of the controlled system and arranged at its input, driven by the manipulated variable and manipulating the mass flow or energy flow."@en ;
    skos:note """IEC 60050-351, 351-49-08. The German term is Stellglied, and a valve is the typical case.

The standard places it inside the controlled system. This pattern records that through the relation partOfControlledSystem rather than through a subclass axiom, so another pattern may hold the same valve as a resource executing a process operation without the two contradicting each other."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:FinalControlledVariableGeneration
    a owl:Class ;
    rdfs:label "Generation of the Final Controlled Variable"@en ;
    rdfs:comment "A functional unit that forms the final controlled variable from the controlled variable."@en ;
    skos:note """**Not a term of the standard.** IEC 60050-351 draws this unit at the right-hand edge of Figures 1 and 2, where x enters and q leaves the control system, but gives it no entry, no number and no index line. A search of the full text finds the wording only inside the two figures.

The class is nevertheless kept, because the final controlled variable it produces is a term of the standard, 351-48-10, and without a unit for it that variable would have no origin in a model. The last step of both figures would then go unrecorded.

Anyone aligning this pattern with another should treat the class as a construct of this work rather than as normative vocabulary. REFERENCE.md lists it under the elements taken from the figures instead of from the entries."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:Controller
    a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "A functional unit, consisting of a comparing element and a controlling element, that performs a specified control function."@en ;
    skos:note "IEC 60050-351, 351-49-11, where the full term is controller for closed-loop control."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ComparingElement
    a owl:Class ;
    rdfs:label "Comparing Element"@en ;
    rdfs:comment "A functional unit that forms the control difference variable from the reference variable and the feedback variable."@en ;
    skos:note "IEC 60050-351, 351-49-03. The summing point of Figure 2, and the place where a closed action path returns."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ControllingElement
    a owl:Class ;
    rdfs:label "Controlling Element"@en ;
    rdfs:comment "A functional unit that forms its output variable from the command variable in open-loop control and from the control difference variable in closed-loop control."@en ;
    skos:note """IEC 60050-351, 351-49-04. The German terms are Steuerglied and Regelglied, one entry for both.

The entry is the element that appears in Figure 1 as well as in Figure 2, which is why the same class serves an open-loop and a closed-loop control. What differs is the variable at its input, not the unit."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:MeasuringElement
    a owl:Class ;
    rdfs:label "Measuring Element"@en ;
    rdfs:comment "A functional unit that forms the feedback variable at its output from the controlled variable applied to its input."@en ;
    skos:note """IEC 60050-351, 351-49-05, where the full term is measuring element in control technology.

Not the same entry as the sensing element, 351-56-26. The sensing element responds to the measurand, whereas this element produces the feedback variable that closes the action path. A model may realise both through one physical unit."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ReferenceVariableGeneratingElement
    a owl:Class ;
    rdfs:label "Reference-variable Generating Element"@en ;
    rdfs:comment "A functional unit that, in closed-loop control, forms the reference variable at its output from the command variable at its input."@en ;
    skos:note "IEC 60050-351, 351-49-10. The German term is Fuehrungsgroessenbildner. Its note states that such an element often ensures that critical limits are not exceeded, for example by limiting the rate of change."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:FinalControllingEquipment
    a owl:Class ;
    rdfs:label "Final Controlling Equipment"@en ;
    rdfs:comment "A functional unit consisting of the actuator and the final controlling element."@en ;
    skos:note """IEC 60050-351, 351-49-09. The German term is Stelleinrichtung, drawn as the dashed grouping in Figures 1 and 2.

It groups the signal side, 351-49-07, and the element acting on the flow, 351-49-08, which the standard otherwise keeps apart. Membership is recorded through consistsOfUnit rather than through a subclass axiom, since the two parts stay units in their own right."""@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ControlSystem
    a owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:comment "A functional unit consisting of the controlling system and the controlled system."@en ;
    skos:note "IEC 60050-351, 351-49-06. The outermost frame of Figures 1 and 2, covering an open-loop and a closed-loop control alike."@en ;
    rdfs:subClassOf iec60050:FunctionalUnit .

iec60050:ProgrammableController
    a owl:Class ;
    rdfs:label "Programmable Controller"@en ;
    rdfs:comment "A microprocessor-based controller with a programmable memory for the internal storage of user-defined instructions."@en ;
    skos:note "IEC 60050-351, 351-56-25. The standard defines no programmable logic controller as a device; 351-47-22 covers that as a kind of control instead."@en ;
    rdfs:subClassOf iec60050:Controller .

#################################################################
#    Anchors to the neighbouring subdomains
#################################################################

iec60050:System
    a owl:Class ;
    rdfs:label "System"@en ;
    rdfs:comment "A set of interrelated elements considered in a defined context as a whole and separated from their environment."@en ;
    skos:note "IEC 60050-351, 351-42-08."@en .

iec60050:Plant
    a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:comment "A complete set of technical equipment and facilities for solving a defined technical task."@en ;
    skos:note "IEC 60050-351, 351-42-35. The technical process pattern has no class for the plant as a whole, only for its individual resources, so this fills a gap rather than duplicating one."@en ;
    rdfs:subClassOf iec60050:System .

iec60050:Model
    a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "A mathematical or physical representation of a system or a process, based with sufficient precision upon known laws, identification or specified suppositions."@en ;
    skos:note "IEC 60050-351, 351-42-26. The identification named in the definition is the data driven case, so the standard treats an identified model as an equal kind rather than as an exception."@en .

iec60050:Observer
    a owl:Class ;
    rdfs:label "Observer"@en ;
    rdfs:comment "A system for the complete reconstruction of the state of a controlled system from measured input and output variables, by means of a model of the controlled system."@en ;
    skos:note "IEC 60050-351, 351-47-31. Structurally the definition of what practice calls a soft sensor, without the standard assuming any particular technique."@en ;
    rdfs:subClassOf iec60050:System .

#################################################################
#    Functions of control technology, 351-43
#
#    The standard states these as verbs. They form a normative taxonomy of
#    tasks, so a model that maps its use cases onto them stays connected to
#    existing plant documentation instead of inventing categories.
#################################################################

iec60050:ControlFunction
    a owl:Class ;
    rdfs:label "Control Function"@en ;
    rdfs:comment "A task of control technology performed on or in a process."@en ;
    skos:note "Collecting class of this pattern for the tasks of 351-43. The standard lists them as verbs without naming a common superclass."@en .

iec60050:Measure a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Measure"@en ;
    rdfs:comment "To obtain experimentally one or more quantity values that can reasonably be attributed to a quantity."@en ;
    skos:note "IEC 60050-351, 351-43-01."@en .

iec60050:Monitor a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Monitor"@en ;
    rdfs:comment "To acquire a quantity value continuously or sequentially in order to check whether it is within normal operating limits and, where appropriate, to signal if it passes its tolerance boundaries."@en ;
    skos:note "IEC 60050-351, 351-43-03. One of the tasks data driven applications typically occupy."@en .

iec60050:Manipulate a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Manipulate"@en ;
    rdfs:comment "To change or set flows of mass, energy, or information by means of a final controlling element."@en ;
    skos:note "IEC 60050-351, 351-43-12."@en .

iec60050:Evaluate a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Evaluate"@en ;
    rdfs:comment "To determine characteristics of a process from measured or recorded variable quantities."@en ;
    skos:note "IEC 60050-351, 351-43-13."@en .

iec60050:Optimize a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Optimize"@en ;
    rdfs:comment "To design a process or act upon a process such that the performance criterion used for evaluating the process states assumes a value either as large or as small as possible within given limitations."@en ;
    skos:note "IEC 60050-351, 351-43-14."@en .

iec60050:Intervene a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Intervene"@en ;
    rdfs:comment "To modify an automatic procedure by an input of the operator or a prioritized technical unit at an unscheduled instant."@en ;
    skos:note "IEC 60050-351, 351-43-15. The entry gives a normative form of what practice calls keeping a human in the loop, including the priority between units."@en .

iec60050:Notify a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Notify"@en ;
    rdfs:comment "To inform selected non-system clients about the occurrence of a specified event by a predefined message or indication."@en ;
    skos:note "IEC 60050-351, 351-43-05. Directed outside the system, as against alerting, 351-43-06, which is directed inside it."@en .

iec60050:Warn a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Warn"@en ;
    rdfs:comment "To indicate the entrance of the system into a state which is still inside the specified operating conditions, but from which without intervention there will be the risk of switching into a state outside them."@en ;
    skos:note "IEC 60050-351, 351-43-07. Still inside the operating conditions, which is what separates warning from alarming."@en .

iec60050:Alarm a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Alarm"@en ;
    rdfs:comment "To indicate that the system has switched or will immediately switch to a state which is outside the specified operating conditions."@en ;
    skos:note "IEC 60050-351, 351-43-08."@en .

iec60050:Operate a owl:NamedIndividual, iec60050:ControlFunction ; rdfs:label "Operate"@en ;
    rdfs:comment "To enter instructions to a process or system via interfaces."@en ;
    skos:note "IEC 60050-351, 351-43-24."@en .

# The ten functions are ten distinct tasks. Without this two of their names
# could denote one thing, and a query counting the functions of an item would
# not be answerable.
[] a owl:AllDifferent ;
   owl:distinctMembers ( iec60050:Measure iec60050:Monitor iec60050:Manipulate iec60050:Evaluate
                         iec60050:Optimize iec60050:Intervene iec60050:Notify iec60050:Warn
                         iec60050:Alarm iec60050:Operate ) .

#################################################################
#    System properties, faults and safety
#################################################################

iec60050:Stability
    a owl:Class ;
    rdfs:label "Stability"@en ;
    rdfs:comment "The property of a system implying that for a sufficiently small initial displacement from the rest position, or a sufficiently small disturbance, the state variables remain within a sufficiently small neighbourhood of the rest position."@en ;
    skos:note "IEC 60050-351, 351-42-20."@en .

iec60050:Controllability
    a owl:Class ;
    rdfs:label "Controllability"@en ;
    rdfs:comment "The property of a system implying that its state variables may be changed from an initial state into a desired final state within a finite time interval, via proper time variations of the input variables."@en ;
    skos:note "IEC 60050-351, 351-42-22. The formal precondition for any application that intervenes in a process."@en .

iec60050:Observability
    a owl:Class ;
    rdfs:label "Observability"@en ;
    rdfs:comment "The property of a system implying that its initial state may be determined from input and output variables observed within a finite time interval."@en ;
    skos:note "IEC 60050-351, 351-42-23. The formal precondition for reconstructing a state that is not measured, which is what an observer does."@en .

iec60050:Redundancy
    a owl:Class ;
    rdfs:label "Redundancy"@en ;
    rdfs:comment "In an item, the existence of more than one means for performing a required function."@en ;
    skos:note "IEC 60050-351, 351-42-28. Stated over an item, so it applies to any item under consideration."@en .

iec60050:RealTimeCapability
    a owl:Class ;
    rdfs:label "Real-time Capability"@en ;
    rdfs:comment "The capability to keep tasks in a runnable state, so that they are able to react to technical process events within a pre-determined time interval."@en ;
    skos:note """IEC 60050-351, 351-54-06, where the entry is stated for a process computer system.

Real time is a capability of a system with a stated interval, not a property of time itself. The pattern follows that reading, so a model states the capability and the interval separately rather than calling a duration real time."""@en .

iec60050:DegreeOfAutomation
    a owl:Class ;
    rdfs:label "Degree of Automation"@en ;
    rdfs:comment "The proportion of automatic functions to the entire set of functions of a system or plant."@en ;
    skos:note "IEC 60050-351, 351-42-31. May be given only for a defined system whose limits are specified. Full automatic operation means all functions except switching on and off are automated."@en .

iec60050:Fault
    a owl:Class ;
    rdfs:label "Fault"@en ;
    rdfs:comment "A fault in control equipment, classified by its effect on the output variables."@en ;
    skos:note "Collecting class of this pattern for 351-56-22 and 351-56-23, which the standard states individually."@en .

iec60050:ActiveFault
    a owl:Class ;
    rdfs:label "Active Fault"@en ;
    rdfs:comment "A fault that causes alterations of the output variables of the control equipment although the program-defined conditions for such alterations are not fulfilled."@en ;
    skos:note "IEC 60050-351, 351-56-22."@en ;
    rdfs:subClassOf iec60050:Fault ;
    owl:disjointWith iec60050:PassiveFault .

iec60050:PassiveFault
    a owl:Class ;
    rdfs:label "Passive Fault"@en ;
    rdfs:comment "A fault that inhibits alterations of the output variables of the control equipment although all program-defined conditions for such alterations are fulfilled."@en ;
    skos:note "IEC 60050-351, 351-56-23."@en ;
    rdfs:subClassOf iec60050:Fault .

iec60050:FunctionalSafety
    a owl:Class ;
    rdfs:label "Functional Safety"@en ;
    rdfs:comment "The part of the overall safety that depends on functional and physical units operating correctly in response to their inputs."@en ;
    skos:note "IEC 60050-351, 351-57-06. The standard defines no safety integrity level; IEC 61508 does."@en .

#################################################################
#    Characteristics
#################################################################

iec60050:Characteristic
    a owl:Class ;
    rdfs:label "Characteristic"@en ;
    rdfs:comment "A named characteristic of the behaviour of a system or a transfer element, such as a settling time or an overshoot, to which a model assigns a value."@en ;
    skos:note "**Collecting class of this pattern.** The standard defines the individual characteristics in 351-45, 351-46 and 351-47 without naming a common superclass. Named individuals are supplied in IEC60050-instances.ttl."@en ;
    owl:disjointWith iec60050:CharacteristicValue .

iec60050:TimeCharacteristic
    a owl:Class ;
    rdfs:label "Time Characteristic"@en ;
    rdfs:comment "A characteristic expressed as a duration."@en ;
    skos:note "Grouping of this pattern, so that a model may ask for the time behaviour without listing every characteristic by name."@en ;
    rdfs:subClassOf iec60050:Characteristic .

iec60050:QualityCharacteristic
    a owl:Class ;
    rdfs:label "Quality Characteristic"@en ;
    rdfs:comment "A characteristic expressing how well a control performs, rather than how long it takes."@en ;
    skos:note "Grouping of this pattern, covering overshoot and the stability margins."@en ;
    rdfs:subClassOf iec60050:Characteristic .

iec60050:CharacteristicValue
    a owl:Class ;
    rdfs:label "Characteristic Value"@en ;
    rdfs:comment "The value a model assigns to one characteristic, together with its unit."@en ;
    skos:note "Reified so that a value can be referred to and annotated, in the same arrangement and for the same reason as the quality of service value of the ISO 7498 pattern."@en .

#################################################################
#    Object properties: automation and its structure
#################################################################

iec60050:runsOverActionPath
    a owl:ObjectProperty ;
    rdfs:label "runs over action path"@en ;
    rdfs:comment "Relates an automation to the action path it runs over."@en ;
    skos:note "The structural half of the distinction: whether something returns from the output to the input, 351-47-03 against 351-47-05."@en ;
    rdfs:domain iec60050:Control ;
    rdfs:range iec60050:ActionPath .

iec60050:hasAction
    a owl:ObjectProperty ;
    rdfs:label "has action"@en ;
    rdfs:comment "Relates an automation to the action taking place over its action path."@en ;
    skos:note """The behavioural half of the distinction. Closed-loop control requires the closed action, 351-47-04, not merely the closed path.

A model that states only the path cannot be told apart from a reset circuit, 351-47-62, which has a closed path and an open action and is therefore open-loop control."""@en ;
    rdfs:domain iec60050:Control ;
    rdfs:range iec60050:Action .

iec60050:actionOverPath
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "action over path"@en ;
    rdfs:comment "Relates an action to the action path it takes place over."@en ;
    skos:note "IEC 60050-351, 351-47-04 and 351-47-06 both define the action with respect to a path. Functional: one action belongs to one path."@en ;
    rdfs:domain iec60050:Action ;
    rdfs:range iec60050:ActionPath .

iec60050:hasForwardPath
    a owl:ObjectProperty ;
    rdfs:label "has forward path"@en ;
    rdfs:comment "Relates a control loop to its forward path."@en ;
    skos:note "IEC 60050-351, 351-47-07."@en ;
    rdfs:domain iec60050:ControlLoop ;
    rdfs:range iec60050:ForwardPath .

iec60050:hasFeedbackPath
    a owl:ObjectProperty ;
    rdfs:label "has feedback path"@en ;
    rdfs:comment "Relates a control loop to its feedback path."@en ;
    skos:note "IEC 60050-351, 351-47-08."@en ;
    rdfs:domain iec60050:ControlLoop ;
    rdfs:range iec60050:FeedbackPath .

iec60050:realisedBy
    a owl:ObjectProperty ;
    rdfs:label "realised by"@en ;
    rdfs:comment "Relates an automation to the arrangement of elements carrying it out, that is a control loop or a control chain."@en ;
    skos:note "IEC 60050-351, 351-47-11 and 351-47-12. A closed-loop control is carried by a loop, an open-loop control by a chain."@en ;
    rdfs:domain iec60050:Control ;
    rdfs:range [ a owl:Class ; owl:unionOf ( iec60050:ControlLoop iec60050:ControlChain ) ] .

#################################################################
#    Object properties: variables
#################################################################

iec60050:hasVariable
    a owl:ObjectProperty ;
    rdfs:label "has variable"@en ;
    rdfs:comment "Relates an automation or a system to a variable quantity involved in it."@en ;
    skos:note "Super property of the role specific relations below, so that a model may record a variable before its role is settled."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:Control iec60050:System iec60050:ItemUnderConsideration ) ] ;
    rdfs:range iec60050:VariableQuantity .

iec60050:hasControlledVariable
    a owl:ObjectProperty ;
    rdfs:label "has controlled variable"@en ;
    rdfs:comment "Relates a closed-loop control to the controlled variable it acts upon."@en ;
    skos:note "IEC 60050-351, 351-48-01. Only closed-loop control has one, since the controlled variable is what is measured and compared."@en ;
    rdfs:subPropertyOf iec60050:hasVariable ;
    rdfs:domain iec60050:Control ;
    rdfs:range iec60050:ControlledVariable .

iec60050:hasReferenceVariable
    a owl:ObjectProperty ;
    rdfs:label "has reference variable"@en ;
    rdfs:comment "Relates a closed-loop control to the reference variable the controlled variable is adjusted to."@en ;
    skos:note "IEC 60050-351, 351-48-02."@en ;
    rdfs:subPropertyOf iec60050:hasVariable ;
    rdfs:domain iec60050:Control ;
    rdfs:range iec60050:ReferenceVariable .

iec60050:hasManipulatedVariable
    a owl:ObjectProperty ;
    rdfs:label "has manipulated variable"@en ;
    rdfs:comment "Relates a control to the manipulated variable through which it acts on the controlled system."@en ;
    skos:note "IEC 60050-351, 351-48-07. Present in open-loop as in closed-loop control."@en ;
    rdfs:subPropertyOf iec60050:hasVariable ;
    rdfs:domain iec60050:Control ;
    rdfs:range iec60050:ManipulatedVariable .

iec60050:hasDisturbanceVariable
    a owl:ObjectProperty ;
    rdfs:label "has disturbance variable"@en ;
    rdfs:comment "Relates a system to a disturbance variable acting on it from the outside."@en ;
    skos:note "IEC 60050-351, 351-48-08."@en ;
    rdfs:subPropertyOf iec60050:hasVariable ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:Control iec60050:System iec60050:ItemUnderConsideration ) ] ;
    rdfs:range iec60050:DisturbanceVariable .

iec60050:carriesInformationParameter
    a owl:ObjectProperty ;
    rdfs:label "carries information parameter"@en ;
    rdfs:comment "Relates a signal to a parameter of it that represents information."@en ;
    skos:note "IEC 60050-351, 351-41-17 and 351-41-18."@en ;
    rdfs:domain iec60050:Signal ;
    rdfs:range iec60050:InformationParameter .

#################################################################
#    Object properties: units, devices and functions
#################################################################

iec60050:realisedByPhysicalUnit
    a owl:ObjectProperty ;
    rdfs:label "realised by physical unit"@en ;
    rdfs:comment "Relates a functional unit to a physical unit realising it."@en ;
    skos:note """IEC 60050-351, 351-56-02 and 351-56-03 define the two as views of one item under consideration, taken by function and by construction.

The relation is the axis the technical process pattern lacks, where a technical resource is atomic. One physical unit may realise several functional units and one functional unit may be spread over several physical units, so no cardinality is asserted."""@en ;
    rdfs:domain iec60050:FunctionalUnit ;
    rdfs:range iec60050:PhysicalUnit .

iec60050:partOfControlledSystem
    a owl:ObjectProperty ;
    rdfs:label "part of controlled system"@en ;
    rdfs:comment "Relates a final controlling element to the controlled system it forms part of."@en ;
    skos:note """IEC 60050-351, 351-49-08 places the final controlling element inside the controlled system.

Stated as a relation rather than a subclass axiom on purpose. VDI 3682 would hold the same valve as a technical resource executing a process operation, and a subclass axiom here would make the two readings contradict. As a relation both stand."""@en ;
    rdfs:domain iec60050:FinalControllingElement ;
    rdfs:range iec60050:ControlledSystem .

iec60050:performsFunction
    a owl:ObjectProperty ;
    rdfs:label "performs function"@en ;
    rdfs:comment "Relates an item under consideration to a function of control technology it performs."@en ;
    skos:note "IEC 60050-351, 351-43. Mapping an application onto the tasks the standard names keeps a model connected to existing plant documentation."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:ItemUnderConsideration iec60050:Control ) ] ;
    rdfs:range iec60050:ControlFunction .

iec60050:actsOn
    a owl:ObjectProperty ;
    rdfs:label "acts on"@en ;
    rdfs:comment "Relates a controlling system or an automation to the controlled system it influences."@en ;
    skos:note "IEC 60050-351, 351-49-01 and 351-49-02."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:Control iec60050:ControllingSystem ) ] ;
    rdfs:range iec60050:ControlledSystem .

iec60050:hasProperty
    a owl:ObjectProperty ;
    rdfs:label "has property"@en ;
    rdfs:comment "Relates an item or a system to a property it has, such as stability, observability or real-time capability."@en ;
    skos:note "Collects 351-42-20, -22, -23, -28, -31 and 351-54-06, which the standard states as properties of a system."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:ItemUnderConsideration iec60050:System iec60050:Control ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( iec60050:Stability iec60050:Controllability iec60050:Observability
                                             iec60050:Redundancy iec60050:RealTimeCapability
                                             iec60050:DegreeOfAutomation iec60050:FunctionalSafety ) ] .

iec60050:usesModel
    a owl:ObjectProperty ;
    rdfs:label "uses model"@en ;
    rdfs:comment "Relates a control or an observer to a model of the process it uses."@en ;
    skos:note "IEC 60050-351, 351-47-31 and 351-47-33. Both name a model of the controlled system as part of their structure."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:Control iec60050:Observer ) ] ;
    rdfs:range iec60050:Model .

#################################################################
#    Object properties: the functional diagram
#
#    The relations that resolve an action path into the units it runs through,
#    after Figures 1 and 2 of the standard.
#################################################################

iec60050:hasActionLine
    a owl:ObjectProperty ;
    rdfs:label "has action line"@en ;
    rdfs:comment "Relates an action path to a part of it running between two functional units."@en ;
    skos:note "IEC 60050-351, 351-44-03 and 351-44-04. An action path is composed of action lines, which is what makes the path traceable through the units."@en ;
    rdfs:domain iec60050:ActionPath ;
    rdfs:range iec60050:ActionLine .

iec60050:fromUnit
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "from unit"@en ;
    rdfs:comment "Relates an action line to the functional unit at which it starts."@en ;
    skos:note """The direction of action, IEC 60050-351, 351-44-05, is carried by this relation together with toUnit rather than by a class of its own.

Note 2 of that entry states that the direction of action need not agree with the direction of the mass or energy flow. Modelling it as a class would invite an alignment to equate it with the direction of a flow in the technical process pattern, where a flow does transport material."""@en ;
    rdfs:domain iec60050:ActionLine ;
    rdfs:range iec60050:FunctionalUnit .

iec60050:toUnit
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "to unit"@en ;
    rdfs:comment "Relates an action line to the functional unit at which it ends."@en ;
    skos:note "IEC 60050-351, 351-44-05. Together with fromUnit it carries the direction of action."@en ;
    rdfs:domain iec60050:ActionLine ;
    rdfs:range iec60050:FunctionalUnit .

iec60050:carriesVariable
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "carries variable"@en ;
    rdfs:comment "Relates an action line to the variable quantity transmitted along it."@en ;
    skos:note "The letters of the figure legends, c, w, e, m, y, x, q and r, are recorded through this relation. Functional: one line carries one variable quantity."@en ;
    rdfs:domain iec60050:ActionLine ;
    rdfs:range iec60050:VariableQuantity .

iec60050:consistsOfUnit
    a owl:ObjectProperty ;
    rdfs:label "consists of unit"@en ;
    rdfs:comment "Relates a functional unit to another functional unit it is composed of."@en ;
    skos:note """IEC 60050-351 composes several units from others: the final controlling equipment from actuator and final controlling element, 351-49-09, the controller from comparing and controlling element, 351-49-11, and the control system from controlling and controlled system, 351-49-06.

Stated as a relation rather than through subclass axioms, since the parts remain units in their own right and one part may belong to more than one whole."""@en ;
    rdfs:domain iec60050:FunctionalUnit ;
    rdfs:range iec60050:FunctionalUnit .

#################################################################
#    Object properties: characteristics
#################################################################

iec60050:hasCharacteristicValue
    a owl:ObjectProperty ;
    rdfs:label "has characteristic value"@en ;
    rdfs:comment "Relates an item, a system or a control to a value it states for one of its characteristics."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iec60050:ItemUnderConsideration iec60050:System iec60050:Control ) ] ;
    rdfs:range iec60050:CharacteristicValue .

iec60050:forCharacteristic
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "for characteristic"@en ;
    rdfs:comment "Relates a characteristic value to the characteristic it quantifies."@en ;
    skos:note "Functional: one value quantifies exactly one characteristic."@en ;
    rdfs:domain iec60050:CharacteristicValue ;
    rdfs:range iec60050:Characteristic .

#################################################################
#    Inverse relations
#
#    The relations above are stated in the direction the standard describes:
#    a functional unit is realised by a physical unit, 351-56-02 and -03, and
#    an action path is composed of action lines, 351-44-03 and -04.
#
#    A model asking from the other end, that is from a device rather than from
#    a function, could not follow them. These inverses close that gap. They add
#    no assertion of their own: the reasoner derives every one of them from a
#    statement already made.
#################################################################

iec60050:realisesFunctionalUnit
    a owl:ObjectProperty ;
    rdfs:label "realises functional unit"@en ;
    rdfs:comment "Relates a physical unit to a functional unit it realises."@en ;
    skos:note """The inverse of realisedByPhysicalUnit, so that a model can start from a device.

Note that the answer may name several units. IEC 60050-351 keeps the functional and the physical view apart on purpose, 351-56-02 against 351-56-03, and one device may realise a comparing element and a controlling element at once. A question asking what role a device plays therefore has more than one answer where the device carries more than one function, and that is the correct result rather than an ambiguity to remove."""@en ;
    owl:inverseOf iec60050:realisedByPhysicalUnit ;
    rdfs:domain iec60050:PhysicalUnit ;
    rdfs:range iec60050:FunctionalUnit .

iec60050:partOfActionPath
    a owl:ObjectProperty ;
    rdfs:label "part of action path"@en ;
    rdfs:comment "Relates an action line to the action path it forms part of."@en ;
    skos:note "The inverse of hasActionLine. With it a model can go from a line to the path and on to the control running over it, which is how a device reaches the kind of control it takes part in."@en ;
    owl:inverseOf iec60050:hasActionLine ;
    rdfs:domain iec60050:ActionLine ;
    rdfs:range iec60050:ActionPath .

iec60050:isSourceOfActionLine
    a owl:ObjectProperty ;
    rdfs:label "is source of action line"@en ;
    rdfs:comment "Relates a functional unit to an action line starting at it."@en ;
    skos:note "The inverse of fromUnit. Together with the next one it says where a unit sits in the chain, and therefore whether it lies in the forward or in the feedback branch."@en ;
    owl:inverseOf iec60050:fromUnit ;
    rdfs:domain iec60050:FunctionalUnit ;
    rdfs:range iec60050:ActionLine .

iec60050:isTargetOfActionLine
    a owl:ObjectProperty ;
    rdfs:label "is target of action line"@en ;
    rdfs:comment "Relates a functional unit to an action line ending at it."@en ;
    skos:note "The inverse of toUnit."@en ;
    owl:inverseOf iec60050:toUnit ;
    rdfs:domain iec60050:FunctionalUnit ;
    rdfs:range iec60050:ActionLine .

#################################################################
#    Data properties
#################################################################

iec60050:quantity
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "The numeric quantity of a characteristic value."@en ;
    rdfs:domain iec60050:CharacteristicValue ;
    rdfs:range xsd:decimal .

iec60050:unit
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit of a characteristic value, for example ms or percent."@en ;
    skos:note "A literal rather than a reference to a unit ontology, so that the pattern stays free of further imports."@en ;
    rdfs:domain iec60050:CharacteristicValue ;
    rdfs:range xsd:string .

iec60050:symbol
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "symbol"@en ;
    rdfs:comment "The formula symbol the standard gives for a characteristic, for example T_cs for the control settling time."@en ;
    skos:note "IEC 60050-351 states a formula symbol for most characteristics of 351-45 and 351-46, which makes a model checkable against the figures of the standard."@en ;
    rdfs:domain iec60050:Characteristic ;
    rdfs:range xsd:string .
