    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iec60050#actionOverPath -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#actionOverPath">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Action"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">Relates an action to the action path it takes place over.</rdfs:comment>
        <rdfs:label xml:lang="en">action over path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-04 and 351-47-06 both define the action with respect to a path. Functional: one action belongs to one path.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#actsOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#actsOn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ControllingSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ControlledSystem"/>
        <rdfs:comment xml:lang="en">Relates a controlling system or an automation to the controlled system it influences.</rdfs:comment>
        <rdfs:label xml:lang="en">acts on</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-01 and 351-49-02.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#carriesInformationParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#carriesInformationParameter">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Signal"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#InformationParameter"/>
        <rdfs:comment xml:lang="en">Relates a signal to a parameter of it that represents information.</rdfs:comment>
        <rdfs:label xml:lang="en">carries information parameter</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-17 and 351-41-18.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#carriesVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#carriesVariable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">Relates an action line to the variable quantity transmitted along it.</rdfs:comment>
        <rdfs:label xml:lang="en">carries variable</rdfs:label>
        <skos:note xml:lang="en">The letters of the figure legends, c, w, e, m, y, x, q and r, are recorded through this relation. Functional: one line carries one variable quantity.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#consistsOfUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#consistsOfUnit">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">Relates a functional unit to another functional unit it is composed of.</rdfs:comment>
        <rdfs:label xml:lang="en">consists of unit</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351 composes several units from others: the final controlling equipment from actuator and final controlling element, 351-49-09, the controller from comparing and controlling element, 351-49-11, and the control system from controlling and controlled system, 351-49-06.

Stated as a relation rather than through subclass axioms, since the parts remain units in their own right and one part may belong to more than one whole.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#forCharacteristic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#forCharacteristic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <rdfs:comment xml:lang="en">Relates a characteristic value to the characteristic it quantifies.</rdfs:comment>
        <rdfs:label xml:lang="en">for characteristic</rdfs:label>
        <skos:note xml:lang="en">Functional: one value quantifies exactly one characteristic.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#fromUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#fromUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">Relates an action line to the functional unit at which it starts.</rdfs:comment>
        <rdfs:label xml:lang="en">from unit</rdfs:label>
        <skos:note xml:lang="en">The direction of action, IEC 60050-351, 351-44-05, is carried by this relation together with toUnit rather than by a class of its own.

Note 2 of that entry states that the direction of action need not agree with the direction of the mass or energy flow. Modelling it as a class would invite an alignment to equate it with the direction of a flow in the technical process pattern, where a flow does transport material.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasAction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasAction">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#Action"/>
        <rdfs:comment xml:lang="en">Relates an automation to the action taking place over its action path.</rdfs:comment>
        <rdfs:label xml:lang="en">has action</rdfs:label>
        <skos:note xml:lang="en">The behavioural half of the distinction. Closed-loop control requires the closed action, 351-47-04, not merely the closed path.

A model that states only the path cannot be told apart from a reset circuit, 351-47-62, which has a closed path and an open action and is therefore open-loop control.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasActionLine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasActionLine">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:comment xml:lang="en">Relates an action path to a part of it running between two functional units.</rdfs:comment>
        <rdfs:label xml:lang="en">has action line</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-44-03 and 351-44-04. An action path is composed of action lines, which is what makes the path traceable through the units.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasCharacteristicValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasCharacteristicValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#System"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <rdfs:comment xml:lang="en">Relates an item, a system or a control to a value it states for one of its characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">has characteristic value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasControlledVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasControlledVariable">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/iec60050#hasVariable"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ControlledVariable"/>
        <rdfs:comment xml:lang="en">Relates a closed-loop control to the controlled variable it acts upon.</rdfs:comment>
        <rdfs:label xml:lang="en">has controlled variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-01. Only closed-loop control has one, since the controlled variable is what is measured and compared.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasDisturbanceVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasDisturbanceVariable">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/iec60050#hasVariable"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#System"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#DisturbanceVariable"/>
        <rdfs:comment xml:lang="en">Relates a system to a disturbance variable acting on it from the outside.</rdfs:comment>
        <rdfs:label xml:lang="en">has disturbance variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-08.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasFeedbackPath -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasFeedbackPath">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ControlLoop"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#FeedbackPath"/>
        <rdfs:comment xml:lang="en">Relates a control loop to its feedback path.</rdfs:comment>
        <rdfs:label xml:lang="en">has feedback path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-08.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasForwardPath -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasForwardPath">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ControlLoop"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ForwardPath"/>
        <rdfs:comment xml:lang="en">Relates a control loop to its forward path.</rdfs:comment>
        <rdfs:label xml:lang="en">has forward path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-07.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasManipulatedVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasManipulatedVariable">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/iec60050#hasVariable"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ManipulatedVariable"/>
        <rdfs:comment xml:lang="en">Relates a control to the manipulated variable through which it acts on the controlled system.</rdfs:comment>
        <rdfs:label xml:lang="en">has manipulated variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-07. Present in open-loop as in closed-loop control.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasProperty">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#System"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Controllability"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#DegreeOfAutomation"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#FunctionalSafety"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Observability"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#RealTimeCapability"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Redundancy"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Stability"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Relates an item or a system to a property it has, such as stability, observability or real-time capability.</rdfs:comment>
        <rdfs:label xml:lang="en">has property</rdfs:label>
        <skos:note xml:lang="en">Collects 351-42-20, -22, -23, -28, -31 and 351-54-06, which the standard states as properties of a system.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasReferenceVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasReferenceVariable">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/iec60050#hasVariable"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ReferenceVariable"/>
        <rdfs:comment xml:lang="en">Relates a closed-loop control to the reference variable the controlled variable is adjusted to.</rdfs:comment>
        <rdfs:label xml:lang="en">has reference variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-02.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#hasVariable -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#hasVariable">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#System"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">Relates an automation or a system to a variable quantity involved in it.</rdfs:comment>
        <rdfs:label xml:lang="en">has variable</rdfs:label>
        <skos:note xml:lang="en">Super property of the role specific relations below, so that a model may record a variable before its role is settled.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#isSourceOfActionLine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#isSourceOfActionLine">
        <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/iec60050#fromUnit"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:comment xml:lang="en">Relates a functional unit to an action line starting at it.</rdfs:comment>
        <rdfs:label xml:lang="en">is source of action line</rdfs:label>
        <skos:note xml:lang="en">The inverse of fromUnit. Together with the next one it says where a unit sits in the chain, and therefore whether it lies in the forward or in the feedback branch.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#isTargetOfActionLine -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#isTargetOfActionLine">
        <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/iec60050#toUnit"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:comment xml:lang="en">Relates a functional unit to an action line ending at it.</rdfs:comment>
        <rdfs:label xml:lang="en">is target of action line</rdfs:label>
        <skos:note xml:lang="en">The inverse of toUnit.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#partOfActionPath -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#partOfActionPath">
        <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/iec60050#hasActionLine"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">Relates an action line to the action path it forms part of.</rdfs:comment>
        <rdfs:label xml:lang="en">part of action path</rdfs:label>
        <skos:note xml:lang="en">The inverse of hasActionLine. With it a model can go from a line to the path and on to the control running over it, which is how a device reaches the kind of control it takes part in.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#partOfControlledSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#partOfControlledSystem">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#FinalControllingElement"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ControlledSystem"/>
        <rdfs:comment xml:lang="en">Relates a final controlling element to the controlled system it forms part of.</rdfs:comment>
        <rdfs:label xml:lang="en">part of controlled system</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-08 places the final controlling element inside the controlled system.

Stated as a relation rather than a subclass axiom on purpose. VDI 3682 would hold the same valve as a technical resource executing a process operation, and a subclass axiom here would make the two readings contradict. As a relation both stand.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#performsFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#performsFunction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">Relates an item under consideration to a function of control technology it performs.</rdfs:comment>
        <rdfs:label xml:lang="en">performs function</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43. Mapping an application onto the tasks the standard names keeps a model connected to existing plant documentation.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#realisedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#realisedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ControlChain"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#ControlLoop"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Relates an automation to the arrangement of elements carrying it out, that is a control loop or a control chain.</rdfs:comment>
        <rdfs:label xml:lang="en">realised by</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-11 and 351-47-12. A closed-loop control is carried by a loop, an open-loop control by a chain.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#realisedByPhysicalUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#realisedByPhysicalUnit">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#PhysicalUnit"/>
        <rdfs:comment xml:lang="en">Relates a functional unit to a physical unit realising it.</rdfs:comment>
        <rdfs:label xml:lang="en">realised by physical unit</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-02 and 351-56-03 define the two as views of one item under consideration, taken by function and by construction.

The relation is the axis the technical process pattern lacks, where a technical resource is atomic. One physical unit may realise several functional units and one functional unit may be spread over several physical units, so no cardinality is asserted.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#realisesFunctionalUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#realisesFunctionalUnit">
        <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/iec60050#realisedByPhysicalUnit"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#PhysicalUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">Relates a physical unit to a functional unit it realises.</rdfs:comment>
        <rdfs:label xml:lang="en">realises functional unit</rdfs:label>
        <skos:note xml:lang="en">The inverse of realisedByPhysicalUnit, so that a model can start from a device.

Note that the answer may name several units. IEC 60050-351 keeps the functional and the physical view apart on purpose, 351-56-02 against 351-56-03, and one device may realise a comparing element and a controlling element at once. A question asking what role a device plays therefore has more than one answer where the device carries more than one function, and that is the correct result rather than an ambiguity to remove.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#runsOverActionPath -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#runsOverActionPath">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">Relates an automation to the action path it runs over.</rdfs:comment>
        <rdfs:label xml:lang="en">runs over action path</rdfs:label>
        <skos:note xml:lang="en">The structural half of the distinction: whether something returns from the output to the input, 351-47-03 against 351-47-05.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#toUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#toUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#ActionLine"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">Relates an action line to the functional unit at which it ends.</rdfs:comment>
        <rdfs:label xml:lang="en">to unit</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-44-05. Together with fromUnit it carries the direction of action.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#usesModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iec60050#usesModel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Control"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iec60050#Observer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iec60050#Model"/>
        <rdfs:comment xml:lang="en">Relates a control or an observer to a model of the process it uses.</rdfs:comment>
        <rdfs:label xml:lang="en">uses model</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-31 and 351-47-33. Both name a model of the controlled system as part of their structure.</skos:note>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iec60050#quantity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iec60050#quantity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The numeric quantity of a characteristic value.</rdfs:comment>
        <rdfs:label xml:lang="en">quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#symbol -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iec60050#symbol">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The formula symbol the standard gives for a characteristic, for example T_cs for the control settling time.</rdfs:comment>
        <rdfs:label xml:lang="en">symbol</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351 states a formula symbol for most characteristics of 351-45 and 351-46, which makes a model checkable against the figures of the standard.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/aias/odp/iec60050#unit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iec60050#unit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unit of a characteristic value, for example ms or percent.</rdfs:comment>
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <skos:note xml:lang="en">A literal rather than a reference to a unit ontology, so that the pattern stays free of further imports.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iec60050#Action -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Action">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">The influence of one variable quantity on another variable quantity.</rdfs:comment>
        <rdfs:label xml:lang="en">Action</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-24. Behaviour, not structure.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ActionLine -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ActionLine">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">A part of the action path between two functional units, the direction of action being indicated by an arrow.</rdfs:comment>
        <rdfs:label xml:lang="en">Action Line</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-44-04, drawn as the arrows of Figures 1 and 2.

The class resolves an action path into the units it runs through. Without it a path can only be asserted to be open or closed; with it the assertion becomes checkable against the units and the variables actually recorded.

Disjoint from the action path: a line is a part of a path, not a path of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ActionPath -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ActionPath">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A directed path within a control structure, which connects two selected variable quantities.</rdfs:comment>
        <rdfs:label xml:lang="en">Action Path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-44-03. Structure, not behaviour.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ActiveFault -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ActiveFault">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Fault"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#PassiveFault"/>
        <rdfs:comment xml:lang="en">A fault that causes alterations of the output variables of the control equipment although the program-defined conditions for such alterations are not fulfilled.</rdfs:comment>
        <rdfs:label xml:lang="en">Active Fault</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-22.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Actuator -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Actuator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that generates the manipulated variable, required to drive the final controlling element, from the output variable of the controlling element.</rdfs:comment>
        <rdfs:label xml:lang="en">Actuator</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-07.

The German term is Steller, and the entry is the signal side of the manipulating equipment, not the element acting on the flow. That element is the final controlling element, 351-49-08. The common rendering of the German Aktor as actuator conflates the two and would put the wrong class on a valve.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#AdaptiveControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#AdaptiveControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control with automatic modification of the structure or parameters of the controlling system to compensate for varying operating conditions and states.</rdfs:comment>
        <rdfs:label xml:lang="en">Adaptive Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-42. The automatic modification is what a learning system performs online.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#CascadeControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#CascadeControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control in which the output variable of one controller is the reference variable of one or more secondary control loops.</rdfs:comment>
        <rdfs:label xml:lang="en">Cascade Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-25.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Characteristic -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Characteristic">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#CharacteristicValue"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A named characteristic of the behaviour of a system or a transfer element, such as a settling time or an overshoot, to which a model assigns a value.</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines the individual characteristics in 351-45, 351-46 and 351-47 without naming a common superclass. Named individuals are supplied in IEC60050-instances.ttl.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#CharacteristicValue -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#CharacteristicValue">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">The value a model assigns to one characteristic, together with its unit.</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic Value</rdfs:label>
        <skos:note xml:lang="en">Reified so that a value can be referred to and annotated, in the same arrangement and for the same reason as the quality of service value of the ISO 7498 pattern.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ClosedAction -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ClosedAction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Action"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#OpenAction"/>
        <rdfs:comment xml:lang="en">An action in a closed action path in which the output variable is continuously or sequentially influencing the input variable and thus continuously or sequentially influencing itself.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed Action</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-04. This, not the closed path, is what closed-loop control requires.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ClosedActionPath -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ClosedActionPath">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#OpenActionPath"/>
        <rdfs:comment xml:lang="en">An action path between the input variable and the output variable at which an additional action path goes back from the output variable to the input variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed Action Path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-03. A closed path alone does not make a closed-loop control: see the open action, 351-47-06.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ClosedLoopControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ClosedLoopControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:comment xml:lang="en">A process whereby one variable quantity, namely the controlled variable, is continuously or sequentially measured, compared with another variable quantity, namely the reference variable, and influenced in such a manner as to adjust to the reference variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Closed-loop Control</rdfs:label>
        <skos:altLabel xml:lang="en">feedback control</skos:altLabel>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-01. Characteristic for closed-loop control is the closed action in which the controlled variable continuously or sequentially influences itself in the action path of the closed loop. The closed action is required, not merely a closed path.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#CommandVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#CommandVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#InputVariable"/>
        <rdfs:comment xml:lang="en">A variable quantity which is not influenced by the control but is introduced into the control system from outside with the aim of making the final controlled variable follow it.</rdfs:comment>
        <rdfs:label xml:lang="en">Command Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-09.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ComparingElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ComparingElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that forms the control difference variable from the reference variable and the feedback variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Comparing Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-03. The summing point of Figure 2, and the place where a closed action path returns.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ComputerControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ComputerControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:comment xml:lang="en">A type of control in which a computer is used in the controlling system.</rdfs:comment>
        <rdfs:label xml:lang="en">Computer Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-52. No genus beyond control is stated.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Control -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Control">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">Purposeful action on or in a process to meet specified objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-19. The German term is Leiten, which covers both open-loop and closed-loop control as well as the supervisory tasks around them. National footnote N1 of that entry states this explicitly: control is the general term here, and the narrower Regeln and Steuern belong to the entries below.

No class for automating sits between this class and the two kinds of control. The standard defines automating in 351-43 as a task, alongside measuring and monitoring, not in 351-47 as a kind of control, and 351-42-31 treats the degree of automation as a proportion of the functions of a system. A hand-operated closed-loop control is a closed-loop control by 351-47-01 without being automated, so a subclass axiom would state more than the standard does. Whether a control runs by itself is recorded through the AI pattern, where automation is a function, and the two are related in the alignment.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlChain -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlChain">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ControlLoop"/>
        <rdfs:comment xml:lang="en">A set of elements or systems which act upon one another in a series structure.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Chain</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-12. The arrangement of an open-loop control, as against the loop of a closed-loop control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlDifferenceVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlDifferenceVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">The difference between the reference variable and the feedback variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Difference Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-05, marked e in Figure 2. It exists only where a comparison takes place, which is why it appears in the closed-loop figure alone.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlEquipment -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <rdfs:comment xml:lang="en">The entirety of devices and programs used for the task of controlling, and in a broader sense all instructions and programs used for it.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Equipment</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-24. A note to the entry includes the process control station and the operating manuals, which is how the standard covers what practice calls a control room.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlFunction -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlFunction">
        <rdfs:comment xml:lang="en">A task of control technology performed on or in a process.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Function</rdfs:label>
        <skos:note xml:lang="en">Collecting class of this pattern for the tasks of 351-43. The standard lists them as verbs without naming a common superclass.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlLoop -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlLoop">
        <rdfs:comment xml:lang="en">A set of elements or systems incorporated in the closed action of a closed-loop control.</rdfs:comment>
        <rdfs:label xml:lang="en">Control Loop</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-11.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlSystem -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit consisting of the controlling system and the controlled system.</rdfs:comment>
        <rdfs:label xml:lang="en">Control System</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-06. The outermost frame of Figures 1 and 2, covering an open-loop and a closed-loop control alike.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Controllability -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Controllability">
        <rdfs:comment xml:lang="en">The property of a system implying that its state variables may be changed from an initial state into a desired final state within a finite time interval, via proper time variations of the input variables.</rdfs:comment>
        <rdfs:label xml:lang="en">Controllability</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-22. The formal precondition for any application that intervenes in a process.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlledSystem -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlledSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#ControllingSystem"/>
        <rdfs:comment xml:lang="en">A functional unit which is to be influenced according to the control task.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlled System</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-01. The German terms are Regelstrecke and Steuerstrecke, so the class covers the plant side of both kinds of control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControlledVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControlledVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#OutputVariable"/>
        <rdfs:comment xml:lang="en">The output variable of the controlled system that will be acted upon by one or more manipulated variables.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlled Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-01. Only a closed-loop control has one: it is what is measured and compared with the reference variable.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Controller -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Controller">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit, consisting of a comparing element and a controlling element, that performs a specified control function.</rdfs:comment>
        <rdfs:label xml:lang="en">Controller</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-11, where the full term is controller for closed-loop control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControllerOutputVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControllerOutputVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#OutputVariable"/>
        <rdfs:comment xml:lang="en">The output variable of the controlling element, which is the input variable of the actuator.</rdfs:comment>
        <rdfs:label xml:lang="en">Controller Output Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-06, marked m in Figures 1 and 2.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControllingElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControllingElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that forms its output variable from the command variable in open-loop control and from the control difference variable in closed-loop control.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlling Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-04. The German terms are Steuerglied and Regelglied, one entry for both.

The entry is the element that appears in Figure 1 as well as in Figure 2, which is why the same class serves an open-loop and a closed-loop control. What differs is the variable at its input, not the unit.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ControllingSystem -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ControllingSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that generates the manipulated variable at its output, from the command variable in open-loop control and from the reference variable and the feedback variable in closed-loop control.</rdfs:comment>
        <rdfs:label xml:lang="en">Controlling System</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-02.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#DegreeOfAutomation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#DegreeOfAutomation">
        <rdfs:comment xml:lang="en">The proportion of automatic functions to the entire set of functions of a system or plant.</rdfs:comment>
        <rdfs:label xml:lang="en">Degree of Automation</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-31. May be given only for a defined system whose limits are specified. Full automatic operation means all functions except switching on and off are automated.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#DisturbanceVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#DisturbanceVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#InputVariable"/>
        <rdfs:comment xml:lang="en">An undesired, independent and mostly unpredictable input variable acting from the outside on the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Disturbance Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-08.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Fault -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Fault">
        <rdfs:comment xml:lang="en">A fault in control equipment, classified by its effect on the output variables.</rdfs:comment>
        <rdfs:label xml:lang="en">Fault</rdfs:label>
        <skos:note xml:lang="en">Collecting class of this pattern for 351-56-22 and 351-56-23, which the standard states individually.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FeedbackPath -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FeedbackPath">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">An action path connecting an output of the controlled system to one of the inputs of the related comparing element.</rdfs:comment>
        <rdfs:label xml:lang="en">Feedback Path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-08.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FeedbackVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FeedbackVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A variable quantity which represents the controlled variable and is returned to the comparing element.</rdfs:comment>
        <rdfs:label xml:lang="en">Feedback Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-03.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FinalControlledVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FinalControlledVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#OutputVariable"/>
        <rdfs:comment xml:lang="en">The variable quantity that the control is ultimately intended to influence, formed from the controlled variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Final Controlled Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-10, marked q in Figures 1 and 2.

The entry adds that the final controlled variable need not belong to the control loop itself: where a mixture composition cannot be measured directly, a dependent property such as density or thermal conductivity is used as the controlled variable while the composition remains the final controlled variable.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FinalControlledVariableGeneration -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FinalControlledVariableGeneration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that forms the final controlled variable from the controlled variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Generation of the Final Controlled Variable</rdfs:label>
        <skos:note xml:lang="en">**Not a term of the standard.** IEC 60050-351 draws this unit at the right-hand edge of Figures 1 and 2, where x enters and q leaves the control system, but gives it no entry, no number and no index line. A search of the full text finds the wording only inside the two figures.

The class is nevertheless kept, because the final controlled variable it produces is a term of the standard, 351-48-10, and without a unit for it that variable would have no origin in a model. The last step of both figures would then go unrecorded.

Anyone aligning this pattern with another should treat the class as a construct of this work rather than as normative vocabulary. REFERENCE.md lists it under the elements taken from the figures instead of from the entries.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FinalControllingElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FinalControllingElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit forming part of the controlled system and arranged at its input, driven by the manipulated variable and manipulating the mass flow or energy flow.</rdfs:comment>
        <rdfs:label xml:lang="en">Final Controlling Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-08. The German term is Stellglied, and a valve is the typical case.

The standard places it inside the controlled system. This pattern records that through the relation partOfControlledSystem rather than through a subclass axiom, so another pattern may hold the same valve as a resource executing a process operation without the two contradicting each other.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FinalControllingEquipment -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FinalControllingEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit consisting of the actuator and the final controlling element.</rdfs:comment>
        <rdfs:label xml:lang="en">Final Controlling Equipment</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-09. The German term is Stelleinrichtung, drawn as the dashed grouping in Figures 1 and 2.

It groups the signal side, 351-49-07, and the element acting on the flow, 351-49-08, which the standard otherwise keeps apart. Membership is recorded through consistsOfUnit rather than through a subclass axiom, since the two parts stay units in their own right.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ForwardPath -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ForwardPath">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">An action path connecting the output of a comparing element to the output of the controlled system.</rdfs:comment>
        <rdfs:label xml:lang="en">Forward Path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-07.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FunctionalSafety -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FunctionalSafety">
        <rdfs:comment xml:lang="en">The part of the overall safety that depends on functional and physical units operating correctly in response to their inputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional Safety</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-57-06. The standard defines no safety integrity level; IEC 61508 does.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FunctionalUnit -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FunctionalUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <rdfs:comment xml:lang="en">An item under consideration defined according to function or effect.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional Unit</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-02. The functional view: what something does, irrespective of how it is built.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#FuzzyControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#FuzzyControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control in which the control algorithm is expressed by fuzzy logic using facts, inference rules and quantifiers based on experience and intuition.</rdfs:comment>
        <rdfs:label xml:lang="en">Fuzzy Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-56.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#InformationParameter -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#InformationParameter">
        <rdfs:comment xml:lang="en">A parameter of a signal that represents information according to a rule.</rdfs:comment>
        <rdfs:label xml:lang="en">Information Parameter</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-18.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#InputVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#InputVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A variable quantity which is acting on a system from the outside and which is independent of the other variable quantities of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Input Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-06.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ItemUnderConsideration -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">An object under consideration defined according to function and scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Item under Consideration</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-01.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ManipulatedVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ManipulatedVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">The output variable of the controlling system, which is also an input variable of the controlled system.</rdfs:comment>
        <rdfs:label xml:lang="en">Manipulated Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-07. It is what carries the influence from the controlling side to the controlled side, in open-loop as in closed-loop control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#MeasuringElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#MeasuringElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that forms the feedback variable at its output from the controlled variable applied to its input.</rdfs:comment>
        <rdfs:label xml:lang="en">Measuring Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-05, where the full term is measuring element in control technology.

Not the same entry as the sensing element, 351-56-26. The sensing element responds to the measurand, whereas this element produces the feedback variable that closes the action path. A model may realise both through one physical unit.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#MeasuringTransmitter -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#MeasuringTransmitter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A measuring transducer the output variable of which is a standardized signal.</rdfs:comment>
        <rdfs:label xml:lang="en">Measuring Transmitter</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-29. The standardised signal is where the communication subdomain begins, which makes this the handover point to the communication pattern.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Model -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Model">
        <rdfs:comment xml:lang="en">A mathematical or physical representation of a system or a process, based with sufficient precision upon known laws, identification or specified suppositions.</rdfs:comment>
        <rdfs:label xml:lang="en">Model</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-26. The identification named in the definition is the data driven case, so the standard treats an identified model as an equal kind rather than as an exception.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ModelBasedControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ModelBasedControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control which includes explicitly in its structure a real-time model of the process expressing the static and dynamic relationships between manipulated variables and controlled variables.</rdfs:comment>
        <rdfs:label xml:lang="en">Model-based Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-33. The definition names a real-time model of the process, which is the natural place for a data driven process model in a control structure.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#MultivariableControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#MultivariableControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control of several controlled variables of a multivariable system by several controllers.</rdfs:comment>
        <rdfs:label xml:lang="en">Multivariable Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-35.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Observability -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Observability">
        <rdfs:comment xml:lang="en">The property of a system implying that its initial state may be determined from input and output variables observed within a finite time interval.</rdfs:comment>
        <rdfs:label xml:lang="en">Observability</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-23. The formal precondition for reconstructing a state that is not measured, which is what an observer does.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Observer -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Observer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#System"/>
        <rdfs:comment xml:lang="en">A system for the complete reconstruction of the state of a controlled system from measured input and output variables, by means of a model of the controlled system.</rdfs:comment>
        <rdfs:label xml:lang="en">Observer</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-31. Structurally the definition of what practice calls a soft sensor, without the standard assuming any particular technique.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#OpenAction -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#OpenAction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Action"/>
        <rdfs:comment xml:lang="en">An action in an open action path, or in a closed action path where the output variable influences the input variable only under certain non-permanently acting conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Open Action</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-06. The note to the entry states that a reset circuit, 351-47-62, has an open action although its structure has a closed action path.

This is the case that separates the pattern from the simplified reading that feedback alone makes a closed-loop control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#OpenActionPath -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#OpenActionPath">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ActionPath"/>
        <rdfs:comment xml:lang="en">An action path between the input variable and the output variable at which no action path goes back from the output variable to the input variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Open Action Path</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-05.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#OpenLoopControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#OpenLoopControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:comment xml:lang="en">A process whereby one or more variable quantities as input variables influence other variable quantities as output variables in accordance with the proper laws of the system.</rdfs:comment>
        <rdfs:label xml:lang="en">Open-loop Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-02. Characteristic for open-loop control is the open action path, or in a closed action path the fact that the output variables being influenced by the input variables are not continuously or sequentially influencing themselves and not by the same input variables.

Deliberately **not** disjoint with closed-loop control: the standard admits open-loop control in a closed action path, so a disjointness axiom would contradict it. What separates the two is the action, not the path.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#OptimalControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#OptimalControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:comment xml:lang="en">A type of control for which the performance index reaches a largest or smallest value under specified conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Optimal Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-41. The standard says type of control rather than closed-loop control, so the class sits under Control and a model may assign it either way.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#OutputVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#OutputVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A recordable variable quantity generated by a system, influenced only by the system and via the system by its input variables.</rdfs:comment>
        <rdfs:label xml:lang="en">Output Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-07.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#PassiveFault -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#PassiveFault">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Fault"/>
        <rdfs:comment xml:lang="en">A fault that inhibits alterations of the output variables of the control equipment although all program-defined conditions for such alterations are fulfilled.</rdfs:comment>
        <rdfs:label xml:lang="en">Passive Fault</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-23.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#PhysicalUnit -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#PhysicalUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ItemUnderConsideration"/>
        <rdfs:comment xml:lang="en">An item under consideration defined according to construction or configuration.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Unit</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-03. The building view: the device as it is bought and installed. Not disjoint with the functional unit, since the two are views rather than kinds.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Plant -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Plant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#System"/>
        <rdfs:comment xml:lang="en">A complete set of technical equipment and facilities for solving a defined technical task.</rdfs:comment>
        <rdfs:label xml:lang="en">Plant</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-35. The technical process pattern has no class for the plant as a whole, only for its individual resources, so this fills a gap rather than duplicating one.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ProgrammableController -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ProgrammableController">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Controller"/>
        <rdfs:comment xml:lang="en">A microprocessor-based controller with a programmable memory for the internal storage of user-defined instructions.</rdfs:comment>
        <rdfs:label xml:lang="en">Programmable Controller</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-25. The standard defines no programmable logic controller as a device; 351-47-22 covers that as a kind of control instead.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ProgrammedControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ProgrammedControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Control"/>
        <rdfs:comment xml:lang="en">Control the functions of which are defined by a program that was previously entered.</rdfs:comment>
        <rdfs:label xml:lang="en">Programmed Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-20. The standard states no genus beyond control, so the class sits under Control. Storage-programmable logic control, 351-47-22, is a kind of this, which is how the standard covers what practice calls a programmable logic controller.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#QualityCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#QualityCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <rdfs:comment xml:lang="en">A characteristic expressing how well a control performs, rather than how long it takes.</rdfs:comment>
        <rdfs:label xml:lang="en">Quality Characteristic</rdfs:label>
        <skos:note xml:lang="en">Grouping of this pattern, covering overshoot and the stability margins.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#RealTimeCapability -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#RealTimeCapability">
        <rdfs:comment xml:lang="en">The capability to keep tasks in a runnable state, so that they are able to react to technical process events within a pre-determined time interval.</rdfs:comment>
        <rdfs:label xml:lang="en">Real-time Capability</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-54-06, where the entry is stated for a process computer system.

Real time is a capability of a system with a stated interval, not a property of time itself. The pattern follows that reading, so a model states the capability and the interval separately rather than calling a duration real time.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Redundancy -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Redundancy">
        <rdfs:comment xml:lang="en">In an item, the existence of more than one means for performing a required function.</rdfs:comment>
        <rdfs:label xml:lang="en">Redundancy</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-28. Stated over an item, so it applies to any item under consideration.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ReferenceVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ReferenceVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#InputVariable"/>
        <rdfs:comment xml:lang="en">An input variable to a comparing element in a controlling system, which sets the desired value of the controlled variable and is deducted from the command variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Reference Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-48-02.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#ReferenceVariableGeneratingElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#ReferenceVariableGeneratingElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that, in closed-loop control, forms the reference variable at its output from the command variable at its input.</rdfs:comment>
        <rdfs:label xml:lang="en">Reference-variable Generating Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-49-10. The German term is Fuehrungsgroessenbildner. Its note states that such an element often ensures that critical limits are not exceeded, for example by limiting the rate of change.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#RobustControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#RobustControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control able to keep system properties within a prescribed area even if the properties of the controlled system or of the controller deviate from those assumed for the design.</rdfs:comment>
        <rdfs:label xml:lang="en">Robust Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-45. The deviation from the properties assumed for the design is what a data driven model faces as a shift of its operating conditions.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#RuleBasedControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#RuleBasedControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control in which the control algorithm explicitly incorporates one or more sets of rules.</rdfs:comment>
        <rdfs:label xml:lang="en">Rule-based Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-58. The standard assigns this to closed-loop control explicitly, so the pattern follows rather than leaving it open.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#SamplingControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#SamplingControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#ClosedLoopControl"/>
        <rdfs:comment xml:lang="en">Closed-loop control in which the input variables of the controlling system are taken discontinuously in time to generate new values of the manipulated variable, which are updated discontinuously and maintained by holding elements between updates.</rdfs:comment>
        <rdfs:label xml:lang="en">Sampling Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-15. Its sampling period, 351-47-16, is the normative equivalent of what practice calls cycle time, a term the standard does not define.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#SensingElement -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#SensingElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#FunctionalUnit"/>
        <rdfs:comment xml:lang="en">A functional unit that senses the effect of a measurand at its input and places a corresponding measurement signal at its output.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensing Element</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-56-26, with a thermocouple, a foil strain gauge and a pH electrode as its examples. The standard defines no term sensor; this is the entry practice means by it.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#SequentialControl -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#SequentialControl">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#OpenLoopControl"/>
        <rdfs:comment xml:lang="en">Open-loop control with stepwise control actions in which the transition from one step to the following is determined by a program in accordance with specified transition conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Sequential Control</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-47-59. The one kind in this group the standard assigns to open-loop control.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Signal -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Signal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">A physical variable quantity, one or more parameters of which carry information about one or more variable quantities.</rdfs:comment>
        <rdfs:label xml:lang="en">Signal</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-17. The separation of the carrier from the information it carries is what lets a model tell sensing hardware from the data point it produces.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#Stability -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#Stability">
        <rdfs:comment xml:lang="en">The property of a system implying that for a sufficiently small initial displacement from the rest position, or a sufficiently small disturbance, the state variables remain within a sufficiently small neighbourhood of the rest position.</rdfs:comment>
        <rdfs:label xml:lang="en">Stability</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-20.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#StateVariable -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#StateVariable">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#VariableQuantity"/>
        <rdfs:comment xml:lang="en">An element of the state vector of a system, from which together with the input variables the output variables are determined.</rdfs:comment>
        <rdfs:label xml:lang="en">State Variable</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-08. The entry states this through the state equation and the output equation; the wording here is the prose form of that.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#System -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#System">
        <rdfs:comment xml:lang="en">A set of interrelated elements considered in a defined context as a whole and separated from their environment.</rdfs:comment>
        <rdfs:label xml:lang="en">System</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-42-08.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#TimeCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#TimeCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iec60050#Characteristic"/>
        <rdfs:comment xml:lang="en">A characteristic expressed as a duration.</rdfs:comment>
        <rdfs:label xml:lang="en">Time Characteristic</rdfs:label>
        <skos:note xml:lang="en">Grouping of this pattern, so that a model may ask for the time behaviour without listing every characteristic by name.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iec60050#VariableQuantity -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iec60050#VariableQuantity">
        <rdfs:comment xml:lang="en">A physical quantity the value of which is subject to change and which can usually be measured.</rdfs:comment>
        <rdfs:label xml:lang="en">Variable Quantity</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-41-01. The standard notes that the short form quantity is often used for it.</skos:note>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iec60050#Alarm -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Alarm">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To indicate that the system has switched or will immediately switch to a state which is outside the specified operating conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Alarm</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-08.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Evaluate -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Evaluate">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To determine characteristics of a process from measured or recorded variable quantities.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluate</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-13.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Intervene -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Intervene">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To modify an automatic procedure by an input of the operator or a prioritized technical unit at an unscheduled instant.</rdfs:comment>
        <rdfs:label xml:lang="en">Intervene</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-15. The entry gives a normative form of what practice calls keeping a human in the loop, including the priority between units.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Manipulate -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Manipulate">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To change or set flows of mass, energy, or information by means of a final controlling element.</rdfs:comment>
        <rdfs:label xml:lang="en">Manipulate</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-12.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Measure -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Measure">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To obtain experimentally one or more quantity values that can reasonably be attributed to a quantity.</rdfs:comment>
        <rdfs:label xml:lang="en">Measure</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-01.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Monitor -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Monitor">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To acquire a quantity value continuously or sequentially in order to check whether it is within normal operating limits and, where appropriate, to signal if it passes its tolerance boundaries.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitor</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-03. One of the tasks data driven applications typically occupy.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Notify -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Notify">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To inform selected non-system clients about the occurrence of a specified event by a predefined message or indication.</rdfs:comment>
        <rdfs:label xml:lang="en">Notify</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-05. Directed outside the system, as against alerting, 351-43-06, which is directed inside it.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Operate -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Operate">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To enter instructions to a process or system via interfaces.</rdfs:comment>
        <rdfs:label xml:lang="en">Operate</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-24.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Optimize -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Optimize">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To design a process or act upon a process such that the performance criterion used for evaluating the process states assumes a value either as large or as small as possible within given limitations.</rdfs:comment>
        <rdfs:label xml:lang="en">Optimize</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-14.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iec60050#Warn -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iec60050#Warn">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iec60050#ControlFunction"/>
        <rdfs:comment xml:lang="en">To indicate the entrance of the system into a state which is still inside the specified operating conditions, but from which without intervention there will be the risk of switching into a state outside them.</rdfs:comment>
        <rdfs:label xml:lang="en">Warn</rdfs:label>
        <skos:note xml:lang="en">IEC 60050-351, 351-43-07. Still inside the operating conditions, which is what separates warning from alarming.</skos:note>
    </owl:NamedIndividual>
    


