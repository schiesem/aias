<https://schema.org/codeRepository> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/aias/odp/iso22989#basedOnAlgorithm
:basedOnAlgorithm rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Evaluation
                                              :Inference
                                              :Model
                                              :Training
                                            )
                              ] ;
                  rdfs:range :Algorithm ;
                  rdfs:comment "Relates a model to the model algorithm describing its structure, and a function to the algorithm it runs."@en ,
                               "Verbindet ein Modell mit dem Modellalgorithmus, der seine Struktur beschreibt, sowie eine Funktion mit dem Algorithmus, den sie ausführt."@de ;
                  rdfs:label "based on algorithm"@en ,
                             "basiert auf Algorithmus"@de .


###  https://w3id.org/aias/odp/iso22989#basedOnLearning
:basedOnLearning rdf:type owl:ObjectProperty ;
                 rdfs:domain :MLAlgorithm ;
                 rdfs:range :LearningType ;
                 rdfs:comment "Relates a machine learning algorithm to the kind of learning it performs."@en ,
                              "Verbindet einen ML-Algorithmus mit der Lernart, die er ausführt."@de ;
                 rdfs:label "based on learning"@en ,
                            "basiert auf Lernart"@de .


###  https://w3id.org/aias/odp/iso22989#consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            rdfs:domain :AISystem ;
            rdfs:range :AIComponent ;
            rdfs:comment "Relates an AI system to a component it is built from."@en ,
                         "Verbindet ein KI-System mit einer Komponente, aus der es aufgebaut ist."@de ;
            rdfs:label "besteht aus"@de ,
                       "consists of"@en .


###  https://w3id.org/aias/odp/iso22989#creates
:creates rdf:type owl:ObjectProperty ;
         rdfs:domain :Inference ;
         rdfs:range :Prediction ;
         rdfs:comment "Relates an inference to the prediction it produces."@en ,
                      "Verbindet eine Inferenz mit der Vorhersage, die sie erzeugt."@de ;
         rdfs:label "creates"@en ,
                    "erzeugt"@de .


###  https://w3id.org/aias/odp/iso22989#createsProcessedData
:createsProcessedData rdf:type owl:ObjectProperty ;
                      rdfs:domain :DataProcess ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( :Data
                                                 :DataSet
                                                 :Sample
                                               )
                                 ] ;
                      rdfs:comment "Relates a data process to the data it produces."@en ,
                                   "Verbindet einen Datenprozess mit den Daten, die er erzeugt."@de ;
                      rdfs:label "creates processed data"@en ,
                                 "erzeugt verarbeitete Daten"@de .


###  https://w3id.org/aias/odp/iso22989#determines
:determines rdf:type owl:ObjectProperty ;
            rdfs:domain :Training ;
            rdfs:range :ModelParameter ;
            rdfs:comment "Relates a training to the model parameters it determines."@en ,
                         "Verbindet ein Training mit den Modellparametern, die es bestimmt."@de ;
            rdfs:label "bestimmt"@de ,
                       "determines"@en .


###  https://w3id.org/aias/odp/iso22989#executes
:executes rdf:type owl:ObjectProperty ;
          rdfs:domain :Model ;
          rdfs:range :Inference ;
          rdfs:comment "Relates a model to the inference it carries out."@en ,
                       "Verbindet ein Modell mit der Inferenz, die es ausführt."@de ;
          rdfs:label "executes"@en ,
                     "führt aus"@de .


###  https://w3id.org/aias/odp/iso22989#fulfillsTask
:fulfillsTask rdf:type owl:ObjectProperty ;
              rdfs:domain :Prediction ;
              rdfs:range :AITask ;
              rdfs:comment "Relates a prediction to the task it addresses."@en ,
                           "Verbindet eine Vorhersage mit der Aufgabe, die sie adressiert."@de ;
              rdfs:label "erfüllt Aufgabe"@de ,
                         "fulfills task"@en .


###  https://w3id.org/aias/odp/iso22989#hasDataSink
:hasDataSink rdf:type owl:ObjectProperty ;
             rdfs:domain :Storing ;
             rdfs:range :DataSink ;
             rdfs:comment "Relates a storing to the sink it persists data to."@en ,
                          "Verbindet eine Speicherung mit der Senke, in der sie Daten ablegt."@de ;
             rdfs:label "has data sink"@en ,
                        "hat Datensenke"@de .


###  https://w3id.org/aias/odp/iso22989#hasDataSource
:hasDataSource rdf:type owl:ObjectProperty ;
               rdfs:domain :Acquisition ;
               rdfs:range :DataSource ;
               rdfs:comment "Relates an acquisition to the source it obtains data from."@en ,
                            "Verbindet eine Erfassung mit der Quelle, aus der sie Daten gewinnt."@de ;
               rdfs:label "has data source"@en ,
                          "hat Datenquelle"@de .


###  https://w3id.org/aias/odp/iso22989#hasDesign
:hasDesign rdf:type owl:ObjectProperty ;
           rdfs:domain :AISystem ;
           rdfs:range :SystemDesign ;
           rdfs:comment "Relates an AI system to where it runs."@en ,
                        "Verbindet ein KI-System mit dem Ort seiner Ausführung."@de ;
           rdfs:label "has design"@en ,
                      "hat Auslegung"@de .


###  https://w3id.org/aias/odp/iso22989#hasFunction
:hasFunction rdf:type owl:ObjectProperty ;
             rdfs:domain :AIComponent ;
             rdfs:range :AIFunction ;
             rdfs:comment "Relates an AI component to a function it performs."@en ,
                          "Verbindet eine KI-Komponente mit einer Funktion, die sie ausführt."@de ;
             rdfs:label "has function"@en ,
                        "hat Funktion"@de .


###  https://w3id.org/aias/odp/iso22989#hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Algorithm
                                          :Model
                                        )
                          ] ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Hyperparameter
                                         :ModelParameter
                                       )
                         ] ;
              rdfs:comment "Relates an algorithm to a hyperparameter governing it, and a model to a parameter determined for it."@en ,
                           "Verbindet einen Algorithmus mit einem ihn steuernden Hyperparameter sowie ein Modell mit einem für es bestimmten Parameter."@de ;
              rdfs:label "has parameter"@en ,
                         "hat Parameter"@de ;
              <http://www.w3.org/2004/02/skos/core#note> "One relation with two domains. The hyperparameter is defined on the algorithm superclass, so a training algorithm, a model algorithm and an evaluation algorithm may each carry one."@en .


###  https://w3id.org/aias/odp/iso22989#hasTask
:hasTask rdf:type owl:ObjectProperty ;
         rdfs:domain :AISystem ;
         rdfs:range :AITask ;
         rdfs:comment "Relates an AI system to a task it fulfils."@en ,
                      "Verbindet ein KI-System mit einer Aufgabe, die es erfüllt."@de ;
         rdfs:label "has task"@en ,
                    "hat Aufgabe"@de .


###  https://w3id.org/aias/odp/iso22989#hasType
:hasType rdf:type owl:ObjectProperty ;
         rdfs:domain :AISystem ;
         rdfs:range :AIType ;
         rdfs:comment "Relates an AI system to the kind of AI it employs, that is symbolic, subsymbolic or a combination of the two."@en ,
                      "Verbindet ein KI-System mit der Art der eingesetzten KI, also symbolisch, subsymbolisch oder kombiniert."@de ;
         rdfs:label "has type"@en ,
                    "hat Art"@de ;
         <http://www.w3.org/2004/02/skos/core#note> "Relates a system to the kind of AI it is built on, symbolic or subsymbolic."@en .


###  https://w3id.org/aias/odp/iso22989#isAcquiredBy
:isAcquiredBy rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Data
                                          :DataSet
                                          :Sample
                                        )
                          ] ;
              rdfs:range :Acquisition ;
              rdfs:comment "Relates data to the acquisition that obtained it."@en ,
                           "Verbindet Daten mit der Erfassung, die sie gewonnen hat."@de ;
              rdfs:label "is acquired by"@en ,
                         "wird erfasst durch"@de .


###  https://w3id.org/aias/odp/iso22989#isComposedOf
:isComposedOf rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Data
                                          :DataSet
                                        )
                          ] ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Data
                                         :Sample
                                       )
                         ] ;
              rdfs:comment "Relates a dataset to the data it collects, and data to the samples it consists of."@en ,
                           "Verbindet einen Datensatz mit den Daten, die er sammelt, sowie Daten mit den Datenelementen, aus denen sie bestehen."@de ;
              rdfs:label "besteht aus"@de ,
                         "is composed of"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "One relation used at two levels: a dataset is composed of data, and data of samples. Its domain and range are therefore unions, since each covers both levels."@en .


###  https://w3id.org/aias/odp/iso22989#isCreatedBy
:isCreatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Model ;
             rdfs:range :Training ;
             rdfs:comment "Relates a model to the training that produced it."@en ,
                          "Verbindet ein Modell mit dem Training, das es erzeugt hat."@de ;
             rdfs:label "is created by"@en ,
                        "wird erzeugt durch"@de .


###  https://w3id.org/aias/odp/iso22989#isEvaluatedBy
:isEvaluatedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Model ;
               rdfs:range :Evaluation ;
               rdfs:comment "Relates a model to the evaluation assessing it."@en ,
                            "Verbindet ein Modell mit der Evaluation, die es bewertet."@de ;
               rdfs:label "is evaluated by"@en ,
                          "wird evaluiert durch"@de .


###  https://w3id.org/aias/odp/iso22989#isPerformedBy
:isPerformedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Training ;
               rdfs:range :MachineLearning ;
               rdfs:comment "Relates a training to the machine learning carrying it out."@en ,
                            "Verbindet ein Training mit dem maschinellen Lernen, das es durchführt."@de ;
               rdfs:label "is performed by"@en ,
                          "wird durchgeführt durch"@de ;
               <http://www.w3.org/2004/02/skos/core#note> "A training is performed by a machine learning, not the other way round, so the relation is directed rather than symmetric."@en .


###  https://w3id.org/aias/odp/iso22989#isProcessedBy
:isProcessedBy rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Data
                                           :DataSet
                                           :Sample
                                         )
                           ] ;
               rdfs:range :DataProcess ;
               rdfs:comment "Relates data to the data process acting on it."@en ,
                            "Verbindet Daten mit dem Datenprozess, der auf ihnen arbeitet."@de ;
               rdfs:label "is processed by"@en ,
                          "wird verarbeitet durch"@de .


###  https://w3id.org/aias/odp/iso22989#isStoredBy
:isStoredBy rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Data
                                        :DataSet
                                        :Sample
                                      )
                        ] ;
            rdfs:range :Storing ;
            rdfs:comment "Relates data to the storing that persisted it."@en ,
                         "Verbindet Daten mit der Speicherung, die sie abgelegt hat."@de ;
            rdfs:label "is stored by"@en ,
                       "wird gespeichert durch"@de .


###  https://w3id.org/aias/odp/iso22989#isValidatedBy
:isValidatedBy rdf:type owl:ObjectProperty ;
               rdfs:domain :Model ;
               rdfs:range :Validation ;
               rdfs:comment "Relates a model to the validation confirming it."@en ,
                            "Verbindet ein Modell mit der Validierung, die es bestätigt."@de ;
               rdfs:label "is validated by"@en ,
                          "wird validiert durch"@de .


###  https://w3id.org/aias/odp/iso22989#usesData
:usesData rdf:type owl:ObjectProperty ;
          rdfs:domain :AIFunction ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Data
                                     :DataSet
                                     :Sample
                                   )
                     ] ;
          rdfs:comment "Relates a function to the data it works on."@en ,
                       "Verbindet eine Funktion mit den Daten, auf denen sie arbeitet."@de ;
          rdfs:label "nutzt Daten"@de ,
                     "uses data"@en .


###  https://w3id.org/aias/odp/iso22989#usesMetric
:usesMetric rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Evaluation
                                        :EvaluationAlgorithm
                                      )
                        ] ;
            rdfs:range :EvaluationMetric ;
            rdfs:comment "Relates an evaluation, or the algorithm it runs, to the metric it measures against."@en ,
                         "Verbindet eine Evaluation oder den von ihr ausgeführten Algorithmus mit der Metrik, gegen die gemessen wird."@de ;
            rdfs:label "nutzt Metrik"@de ,
                       "uses metric"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/aias/odp/iso22989#AIComponent
:AIComponent rdf:type owl:Class ;
             rdfs:comment "A functional element that together with further components constitutes an AI system."@en ,
                          "Ein funktionales Element, das zusammen mit weiteren Komponenten ein KI-System bildet."@de ;
             rdfs:label "AI Component"@en ,
                        "KI-Komponente"@de ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.2."@en .


###  https://w3id.org/aias/odp/iso22989#AIFunction
:AIFunction rdf:type owl:Class ;
            rdfs:comment "A function transforming inputs into outputs and thereby representing one step of the AI life cycle."@en ,
                         "Funktion, die Eingaben in Ausgaben transformiert und dabei einen Schritt des KI-Lebenszyklus abbildet."@de ;
            rdfs:label "AI Function"@en ,
                       "KI-Funktion"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A collecting class of this model for the eight functions below."@en .


###  https://w3id.org/aias/odp/iso22989#AISystem
:AISystem rdf:type owl:Class ;
          rdfs:comment "An engineered system that generates outputs such as predictions, recommendations or decisions from data in order to support human-defined objectives."@en ,
                       "Ein konstruiertes System, das auf Basis von Daten Ausgaben wie Vorhersagen, Empfehlungen oder Entscheidungen erzeugt, um menschlich definierte Ziele zu unterstützen."@de ;
          rdfs:label "AI System"@en ,
                     "KI-System"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.4."@en .


###  https://w3id.org/aias/odp/iso22989#AITask
:AITask rdf:type owl:Class ;
        rdfs:comment "A task to be carried out by the AI in order to reach a given objective."@en ,
                     "Eine durch die KI auszuführende Aufgabe zur Erreichung eines bestimmten Ziels."@de ;
        rdfs:label "AI Task"@en ,
                   "KI-Aufgabe"@de ;
        <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.35."@en .


###  https://w3id.org/aias/odp/iso22989#AIType
:AIType rdf:type owl:Class ;
        rdfs:comment "Characterises the kind of AI employed."@en ,
                     "Charakterisiert die Art der eingesetzten KI."@de ;
        rdfs:label "AI Type"@en ,
                   "KI-Art"@de ;
        <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A collecting class of this model for the two kinds the standard defines separately."@en .


###  https://w3id.org/aias/odp/iso22989#Accuracy
:Accuracy rdf:type owl:Class ;
          rdfs:subClassOf :EvaluationMetric ;
          rdfs:comment "Anteil der korrekten Ergebnisse an allen Ergebnissen."@de ,
                       "The proportion of correct results among all results."@en ;
          rdfs:label "Accuracy"@en ,
                     "Genauigkeit"@de .


###  https://w3id.org/aias/odp/iso22989#Acquisition
:Acquisition rdf:type owl:Class ;
             rdfs:subClassOf :AIFunction ;
             rdfs:comment "Gewinnung von Daten aus Datenquellen."@de ,
                          "Obtaining data from data sources."@en ;
             rdfs:label "Acquisition"@en ,
                        "Datenerfassung"@de ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#Algorithm
:Algorithm rdf:type owl:Class ;
           rdfs:comment "Oberklasse für parametrisierbare mathematische Verfahren."@de ,
                        "Superclass of parameterisable mathematical procedures."@en ;
           rdfs:label "Algorithm"@en ,
                      "Algorithmus"@de ;
           <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989, which defines the machine learning algorithm alone, 3.3.6. The superclass and two of the three specialisations are constructs of this model."@en .


###  https://w3id.org/aias/odp/iso22989#Annotation
:Annotation rdf:type owl:Class ;
            rdfs:subClassOf :DataProcess ;
            rdfs:comment "Addition of significant information as metadata, for example labels or provenance."@en ,
                         "Ergänzung signifikanter Informationen als Metadaten, etwa Labels oder Herkunftsinformationen."@de ;
            rdfs:label "Annotation"@de ,
                       "Annotation"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#Augmentation
:Augmentation rdf:type owl:Class ;
              rdfs:subClassOf :DataProcess ;
              rdfs:comment "Creation of additional data by transforming existing data in order to enlarge a dataset."@en ,
                           "Erzeugung zusätzlicher Daten durch Transformation vorhandener Daten, um einen Datensatz zu erweitern."@de ;
              rdfs:label "Augmentation"@en ,
                         "Augmentierung"@de ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#Automate
:Automate rdf:type owl:Class ;
          rdfs:subClassOf :AIFunction ;
          rdfs:comment "Ausführung eines Vorgangs ohne menschliches Eingreifen."@de ,
                       "Carrying out a procedure without human intervention."@en ;
          rdfs:label "Automate"@en ,
                     "Automatisieren"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. Definition 3.1.7 defines automatic as an adjective, not as a thing a model instantiates. The class is kept for the function it names in a plant."@en .


###  https://w3id.org/aias/odp/iso22989#Classification
:Classification rdf:type owl:Class ;
                rdfs:subClassOf :AITask ;
                rdfs:comment "Assignment of inputs to discrete classes."@en ,
                             "Zuordnung von Eingaben zu diskreten Klassen."@de ;
                rdfs:label "Classification"@en ,
                           "Klassifikation"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 9."@en .


###  https://w3id.org/aias/odp/iso22989#Cloud
:Cloud rdf:type owl:Class ;
       rdfs:subClassOf :SystemDesign ;
       rdfs:comment "An AI system running on cloud infrastructure."@en ,
                    "Ein KI-System, das auf Cloud-Infrastruktur ausgeführt wird."@de ;
       rdfs:label "Cloud"@de ,
                  "Cloud"@en .


###  https://w3id.org/aias/odp/iso22989#Clustering
:Clustering rdf:type owl:Class ;
            rdfs:subClassOf :AITask ;
            rdfs:comment "Identification of groups of similar examples."@en ,
                         "Identifikation von Gruppen ähnlicher Beispiele."@de ;
            rdfs:label "Clustering"@de ,
                       "Clustering"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.11.2."@en .


###  https://w3id.org/aias/odp/iso22989#Data
:Data rdf:type owl:Class ;
      rdfs:comment "A reinterpretable representation of information in a formalised manner suitable for communication, interpretation or processing."@en ,
                   "Reinterpretierbare Darstellung von Information in formalisierter Weise, geeignet zur Kommunikation, Interpretation oder Verarbeitung."@de ;
      rdfs:label "Data"@en ,
                 "Daten"@de ;
      <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.3."@en .


###  https://w3id.org/aias/odp/iso22989#DataProcess
:DataProcess rdf:type owl:Class ;
             rdfs:subClassOf :AIFunction ;
             rdfs:comment "A step transforming input data into output data."@en ,
                          "Ein Schritt, der Eingabedaten in Ausgabedaten umwandelt."@de ;
             rdfs:label "Data Process"@en ,
                        "Datenprozess"@de ;
             <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A collecting class of this model for the steps of clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#DataProcessing
:DataProcessing rdf:type owl:Class ;
                rdfs:subClassOf :AIFunction ;
                rdfs:comment "Transformation of input data into output data."@en ,
                             "Umwandlung von Eingangsdaten in Ausgangsdaten."@de ;
                rdfs:label "Data Processing"@en ,
                           "Datenverarbeitung"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#DataSet
:DataSet rdf:type owl:Class ;
         rdfs:comment "A collection of data with a shared format."@en ,
                      "Sammlung von Daten mit gemeinsamem Format."@de ;
         rdfs:label "Data Set"@en ,
                    "Datensatz"@de ;
         <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.5."@en .


###  https://w3id.org/aias/odp/iso22989#DataSink
:DataSink rdf:type owl:Class ;
          rdfs:comment "Ort, an dem Daten abgelegt werden."@de ,
                       "Where data is persisted to."@en ;
          rdfs:label "Data Sink"@en ,
                     "Datensenke"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A construct of this model, needed by the storing."@en .


###  https://w3id.org/aias/odp/iso22989#DataSource
:DataSource rdf:type owl:Class ;
            rdfs:comment "Ort, aus dem Daten gewonnen werden."@de ,
                         "Where data is obtained from."@en ;
            rdfs:label "Data Source"@en ,
                       "Datenquelle"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A construct of this model, needed by the acquisition."@en .


###  https://w3id.org/aias/odp/iso22989#Edge
:Edge rdf:type owl:Class ;
      rdfs:subClassOf :SystemDesign ;
      rdfs:comment "An AI system running close to the process it serves."@en ,
                   "Ein KI-System, das prozessnah ausgeführt wird."@de ;
      rdfs:label "Edge"@de ,
                 "Edge"@en .


###  https://w3id.org/aias/odp/iso22989#Evaluation
:Evaluation rdf:type owl:Class ;
            rdfs:subClassOf :AIFunction ;
            rdfs:comment "Assessment of the performance of an AI system before it is deployed."@en ,
                         "Bewertung der Leistung des KI-Systems vor dem Einsatz."@de ;
            rdfs:label "Evaluation"@de ,
                       "Evaluation"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#EvaluationAlgorithm
:EvaluationAlgorithm rdf:type owl:Class ;
                     rdfs:subClassOf :Algorithm ;
                     rdfs:comment "A procedure assessing a model against an evaluation metric."@en ,
                                  "Verfahren zur Bewertung eines Modells anhand einer Evaluationsmetrik."@de ;
                     rdfs:label "Evaluation Algorithm"@en ,
                                "Evaluationsalgorithmus"@de ;
                     <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A construct of this model."@en .


###  https://w3id.org/aias/odp/iso22989#EvaluationData
:EvaluationData rdf:type owl:Class ;
                owl:equivalentClass :TestData ;
                rdfs:subClassOf :Data ;
                rdfs:comment "Data used to assess the performance of a final model, disjoint from training and validation data."@en ,
                             "Daten, die zur Beurteilung der Leistung eines finalen Modells verwendet werden und disjunkt zu Trainings- und Validierungsdaten sind."@de ;
                rdfs:label "Evaluation Data"@en ,
                           "Evaluationsdaten"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.14."@en .


###  https://w3id.org/aias/odp/iso22989#EvaluationMetric
:EvaluationMetric rdf:type owl:Class ;
                  rdfs:comment "A measure against which the performance of a model is assessed."@en ,
                               "Maß, anhand dessen die Leistung eines Modells bewertet wird."@de ;
                  rdfs:label "Evaluation Metric"@en ,
                             "Evaluationsmetrik"@de ;
                  <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A construct of this model."@en .


###  https://w3id.org/aias/odp/iso22989#F1Score
:F1Score rdf:type owl:Class ;
         rdfs:subClassOf :EvaluationMetric ;
         rdfs:comment "Harmonisches Mittel aus Präzision und Trefferquote."@de ,
                      "The harmonic mean of precision and recall."@en ;
         rdfs:label "F1 Score"@en ,
                    "F1-Maß"@de .


###  https://w3id.org/aias/odp/iso22989#Filtering
:Filtering rdf:type owl:Class ;
           rdfs:subClassOf :DataProcess ;
           rdfs:comment "Entfernung unerwünschter Daten."@de ,
                        "Removal of unwanted data."@en ;
           rdfs:label "Filtering"@en ,
                      "Filterung"@de ;
           <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#Generation
:Generation rdf:type owl:Class ;
            rdfs:subClassOf :AITask ;
            rdfs:comment "Creation of new outputs such as text, images or audio from learned representations."@en ,
                         "Erzeugung neuer Ausgaben, etwa Texte, Bilder oder Audio, auf Basis gelernter Repräsentationen."@de ;
            rdfs:label "Generation"@en ,
                       "Generierung"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 9.2."@en .


###  https://w3id.org/aias/odp/iso22989#Hybrid
:Hybrid rdf:type owl:Class ;
        rdfs:subClassOf :SystemDesign ;
        rdfs:comment "An AI system split between cloud infrastructure and the edge."@en ,
                     "Ein KI-System, das auf Cloud und Edge verteilt ausgeführt wird."@de ;
        rdfs:label "Hybrid"@de ,
                   "Hybrid"@en .


###  https://w3id.org/aias/odp/iso22989#Hyperparameter
:Hyperparameter rdf:type owl:Class ;
                rdfs:comment "A property of an algorithm governing its behaviour."@en ,
                             "Eigenschaft eines Algorithmus, die dessen Verhalten steuert."@de ;
                rdfs:label "Hyperparameter"@de ,
                           "Hyperparameter"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.4. Placed on the algorithm superclass, so that a training algorithm, a model algorithm and an evaluation algorithm may each carry one: a learning rate, the number of layers of a network, the threshold of a metric."@en .


###  https://w3id.org/aias/odp/iso22989#Imputation
:Imputation rdf:type owl:Class ;
            rdfs:subClassOf :DataProcess ;
            rdfs:comment "Ersetzung fehlender Daten durch geschätzte oder modellierte Werte."@de ,
                         "Replacement of missing data by estimated or modelled values."@en ;
            rdfs:label "Imputation"@de ,
                       "Imputation"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.8."@en .


###  https://w3id.org/aias/odp/iso22989#Inference
:Inference rdf:type owl:Class ;
           rdfs:subClassOf :AIFunction ;
           rdfs:comment "Reasoning by which results are derived from given premises or data."@en ,
                        "Schlussfolgern, bei dem aus gegebenen Prämissen beziehungsweise Daten Ergebnisse abgeleitet werden."@de ;
           rdfs:label "Inference"@en ,
                      "Inferenz"@de ;
           <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.17."@en .


###  https://w3id.org/aias/odp/iso22989#Labeling
:Labeling rdf:type owl:Class ;
          rdfs:subClassOf :DataProcess ;
          rdfs:comment "Assignment of a label to a data element."@en ,
                       "Zuordnung eines Labels zu einem Datenelement."@de ;
          rdfs:label "Kennzeichnung"@de ,
                     "Labeling"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10, where labelling is discussed as part of the annotation rather than defined as a process of its own."@en .


###  https://w3id.org/aias/odp/iso22989#LearningType
:LearningType rdf:type owl:Class ;
              rdfs:comment "Art des maschinellen Lernens."@de ,
                           "The kind of machine learning employed."@en ;
              rdfs:label "Learning Type"@en ,
                         "Lernart"@de ;
              <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A collecting class of this model for the four kinds the standard defines separately."@en .


###  https://w3id.org/aias/odp/iso22989#MLAlgorithm
:MLAlgorithm rdf:type owl:Class ;
             rdfs:subClassOf :TrainingAlgorithm ;
             rdfs:comment "A specialisation of the training algorithm for machine learning, to which a kind of learning is assigned."@en ,
                          "Spezialisierung des Trainingsalgorithmus für das maschinelle Lernen, dem eine Lernart zugeordnet ist."@de ;
             rdfs:label "ML-Algorithmus"@de ,
                        "Machine Learning Algorithm"@en ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.6."@en .


###  https://w3id.org/aias/odp/iso22989#MachineLearning
:MachineLearning rdf:type owl:Class ;
                 rdfs:comment "A process optimising the parameters of a model by computational means so that its behaviour reflects the underlying data or experience."@en ,
                              "Prozess zur Optimierung von Modellparametern durch rechnergestützte Verfahren, sodass das Verhalten des Modells die zugrunde liegenden Daten oder Erfahrungen widerspiegelt."@de ;
                 rdfs:label "Machine Learning"@en ,
                            "Maschinelles Lernen"@de ;
                 <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.5."@en .


###  https://w3id.org/aias/odp/iso22989#Merging
:Merging rdf:type owl:Class ;
         rdfs:subClassOf :DataProcess ;
         rdfs:comment "Combination of several data sources into one."@en ,
                      "Zusammenführung mehrerer Datenquellen zu einer."@de ;
         rdfs:label "Merging"@en ,
                    "Zusammenführung"@de ;
         <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. A construct of this model, for the step that joins several datasets into one."@en .


###  https://w3id.org/aias/odp/iso22989#Model
:Model rdf:type owl:Class ;
       rdfs:comment "A mathematical construction generating inference or predictions from input data."@en ,
                    "Mathematische Konstruktion, die auf Basis von Eingangsdaten Inferenz oder Vorhersagen erzeugt."@de ;
       rdfs:label "Model"@en ,
                  "Modell"@de ;
       <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.7. A model is a parameterised instance of an algorithm: the model algorithm describes the procedure without learned parameters, the model carries them."@en .


###  https://w3id.org/aias/odp/iso22989#ModelAlgorithm
:ModelAlgorithm rdf:type owl:Class ;
                rdfs:subClassOf :Algorithm ;
                rdfs:comment "A procedure describing the structure of a model, for example the architecture of a neural network."@en ,
                             "Verfahren zur Beschreibung der Struktur eines Modells, etwa die Architektur eines neuronalen Netzes."@de ;
                rdfs:label "Model Algorithm"@en ,
                           "Modellalgorithmus"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "Derived from ISO/IEC 22989, definition 3.3.7."@en .


###  https://w3id.org/aias/odp/iso22989#ModelParameter
:ModelParameter rdf:type owl:Class ;
                rdfs:comment "An internal variable of a model affecting how its outputs are computed."@en ,
                             "Interne Variable eines Modells, die beeinflusst, wie dessen Ausgaben berechnet werden."@de ;
                rdfs:label "Model Parameter"@en ,
                           "Modellparameter"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.8."@en .


###  https://w3id.org/aias/odp/iso22989#Normalization
:Normalization rdf:type owl:Class ;
               rdfs:subClassOf :DataProcess ;
               rdfs:comment "Adjustment of data values to a common scale so that they become mathematically comparable."@en ,
                            "Anpassung von Datenwerten auf eine gemeinsame Skala, um sie mathematisch vergleichbar zu machen."@de ;
               rdfs:label "Normalisierung"@de ,
                          "Normalization"@en ;
               <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#Precision
:Precision rdf:type owl:Class ;
           rdfs:subClassOf :EvaluationMetric ;
           rdfs:comment "Anteil der korrekten Ergebnisse an den als positiv gemeldeten."@de ,
                        "The proportion of correct results among those reported positive."@en ;
           rdfs:label "Precision"@en ,
                      "Präzision"@de .


###  https://w3id.org/aias/odp/iso22989#Prediction
:Prediction rdf:type owl:Class ;
            rdfs:comment "Primäre Ausgabe eines KI-Systems, wenn Eingabedaten verarbeitet werden."@de ,
                         "The primary output of an AI system when input data is processed."@en ;
            rdfs:label "Prediction"@en ,
                       "Vorhersage"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.27."@en .


###  https://w3id.org/aias/odp/iso22989#ProductionData
:ProductionData rdf:type owl:Class ;
                rdfs:subClassOf :Data ;
                rdfs:comment "Data arising during the operation of a deployed AI system, for which the system computes inferences."@en ,
                             "Daten, die in der Betriebsphase eines eingesetzten KI-Systems anfallen und für die das System Inferenzen berechnet."@de ;
                rdfs:label "Betriebsdaten"@de ,
                           "Production Data"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.12."@en .


###  https://w3id.org/aias/odp/iso22989#Recall
:Recall rdf:type owl:Class ;
        rdfs:subClassOf :EvaluationMetric ;
        rdfs:comment "Anteil der gefundenen an allen positiven Fällen."@de ,
                     "The proportion of positive cases that were found."@en ;
        rdfs:label "Recall"@en ,
                   "Trefferquote"@de .


###  https://w3id.org/aias/odp/iso22989#Regression
:Regression rdf:type owl:Class ;
            rdfs:subClassOf :AITask ;
            rdfs:comment "Prediction of continuous quantities."@en ,
                         "Vorhersage kontinuierlicher Größen."@de ;
            rdfs:label "Regression"@de ,
                       "Regression"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 9."@en .


###  https://w3id.org/aias/odp/iso22989#ReinforcementLearning
:ReinforcementLearning rdf:type owl:Class ;
                       rdfs:subClassOf :LearningType ;
                       rdfs:comment "Machine learning that learns an optimal sequence of actions by interacting with an environment in order to maximise a reward."@en ,
                                    "Maschinelles Lernen, das eine optimale Abfolge von Aktionen durch Interaktion mit einer Umgebung erlernt, um eine maximale Belohnung zu erzielen."@de ;
                       rdfs:label "Bestärkendes Lernen"@de ,
                                  "Reinforcement Learning"@en ;
                       <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.9."@en .


###  https://w3id.org/aias/odp/iso22989#Sample
:Sample rdf:type owl:Class ;
        rdfs:comment "An atomic data element processed in large numbers by an ML algorithm or an AI system."@en ,
                     "Atomares Datenelement, das von einem ML-Algorithmus oder KI-System in großer Zahl verarbeitet wird."@de ;
        rdfs:label "Datenelement"@de ,
                   "Sample"@en ;
        <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.13."@en .


###  https://w3id.org/aias/odp/iso22989#Sampling
:Sampling rdf:type owl:Class ;
          rdfs:subClassOf :DataProcess ;
          rdfs:comment "Auswahl einer repräsentativen Teilmenge der Daten."@de ,
                       "Selection of a representative subset of the data."@en ;
          rdfs:label "Sampling"@en ,
                     "Stichprobenziehung"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.4."@en .


###  https://w3id.org/aias/odp/iso22989#SemiSupervisedLearning
:SemiSupervisedLearning rdf:type owl:Class ;
                        rdfs:subClassOf :LearningType ;
                        rdfs:comment "Machine learning using both labelled and unlabelled data during training."@en ,
                                     "Maschinelles Lernen, das während des Trainings sowohl gekennzeichnete als auch nicht gekennzeichnete Daten nutzt."@de ;
                        rdfs:label "Semi-supervised Learning"@en ,
                                   "Teilüberwachtes Lernen"@de ;
                        <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.11."@en .


###  https://w3id.org/aias/odp/iso22989#Storing
:Storing rdf:type owl:Class ;
         rdfs:subClassOf :AIFunction ;
         rdfs:comment "Ablage von Daten in einer Datensenke."@de ,
                      "Persisting data to a data sink."@en ;
         rdfs:label "Speicherung"@de ,
                    "Storing"@en ;
         <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, clause 5.10."@en .


###  https://w3id.org/aias/odp/iso22989#SubSymbolicAI
:SubSymbolicAI rdf:type owl:Class ;
               rdfs:subClassOf :AIType ;
               owl:disjointWith :SymbolicAI ;
               rdfs:comment "Techniken, deren Repräsentationen implizit aus Daten oder Erfahrung abgeleitet werden."@de ,
                            "Techniques whose representations are derived implicitly from data or experience."@en ;
               rdfs:label "Subsymbolic AI"@en ,
                          "Subsymbolische KI"@de ;
               <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.34."@en .


###  https://w3id.org/aias/odp/iso22989#SupervisedLearning
:SupervisedLearning rdf:type owl:Class ;
                    rdfs:subClassOf :LearningType ;
                    rdfs:comment "Machine learning using labelled data only during training."@en ,
                                 "Maschinelles Lernen, das während des Trainings ausschließlich gekennzeichnete Daten verwendet."@de ;
                    rdfs:label "Supervised Learning"@en ,
                               "Überwachtes Lernen"@de ;
                    <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.12."@en .


###  https://w3id.org/aias/odp/iso22989#SymbolicAI
:SymbolicAI rdf:type owl:Class ;
            rdfs:subClassOf :AIType ;
            rdfs:comment "Techniken, die mit expliziten Symbolen und Regeln arbeiten, um Schlussfolgerungen zu ziehen."@de ,
                         "Techniques working with explicit symbols and rules in order to draw inferences."@en ;
            rdfs:label "Symbolic AI"@en ,
                       "Symbolische KI"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.1.33."@en .


###  https://w3id.org/aias/odp/iso22989#SystemDesign
:SystemDesign rdf:type owl:Class ;
              rdfs:comment "Where an AI system runs, that is on cloud infrastructure, near the process at the edge, or split between the two."@en ,
                           "Wo ein KI-System ausgeführt wird, also auf Cloud-Infrastruktur, prozessnah am Edge oder auf beide verteilt."@de ;
              rdfs:label "System Design"@en ,
                         "Systemauslegung"@de ;
              <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 22989. Clause 8.6.2 discusses cloud and edge computing without defining the choice between them."@en .


###  https://w3id.org/aias/odp/iso22989#TestData
:TestData rdf:type owl:Class ;
          rdfs:subClassOf :Data ;
          rdfs:comment "Data used to assess the performance of a final model."@en ,
                       "Daten, die zur Beurteilung der Leistung eines finalen Modells verwendet werden."@de ;
          rdfs:label "Test Data"@en ,
                     "Testdaten"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "Equivalent to the evaluation data: the two name the same thing, one in the wording of the standard and one in the wording of practice."@en .


###  https://w3id.org/aias/odp/iso22989#Training
:Training rdf:type owl:Class ;
          rdfs:subClassOf :AIFunction ;
          rdfs:comment "Bestimmung oder Verbesserung der Parameter eines Modells anhand von Trainingsdaten."@de ,
                       "Determining or improving the parameters of a model from training data."@en ;
          rdfs:label "Training"@de ,
                     "Training"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.15."@en .


###  https://w3id.org/aias/odp/iso22989#TrainingAlgorithm
:TrainingAlgorithm rdf:type owl:Class ;
                   rdfs:subClassOf :Algorithm ;
                   rdfs:comment "A procedure determining the parameters of a model from data according to given criteria."@en ,
                                "Verfahren zur Bestimmung der Parameter eines Modells aus Daten nach vorgegebenen Kriterien."@de ;
                   rdfs:label "Training Algorithm"@en ,
                              "Trainingsalgorithmus"@de ;
                   <http://www.w3.org/2004/02/skos/core#note> "Derived from ISO/IEC 22989, definition 3.3.6. A particular procedure such as gradient descent is recorded as a named instance of this class rather than as a class of its own."@en .


###  https://w3id.org/aias/odp/iso22989#TrainingData
:TrainingData rdf:type owl:Class ;
              rdfs:subClassOf :Data ;
              rdfs:comment "Data used to determine the parameters of a model during training."@en ,
                           "Daten, die zur Bestimmung der Parameter eines Modells im Trainingsprozess verwendet werden."@de ;
              rdfs:label "Training Data"@en ,
                         "Trainingsdaten"@de ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.16."@en .


###  https://w3id.org/aias/odp/iso22989#UnsupervisedLearning
:UnsupervisedLearning rdf:type owl:Class ;
                      rdfs:subClassOf :LearningType ;
                      rdfs:comment "Machine learning using unlabelled data only during training."@en ,
                                   "Maschinelles Lernen, das während des Trainings ausschließlich nicht gekennzeichnete Daten verwendet."@de ;
                      rdfs:label "Unsupervised Learning"@en ,
                                 "Unüberwachtes Lernen"@de ;
                      <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.3.17."@en .


###  https://w3id.org/aias/odp/iso22989#Validation
:Validation rdf:type owl:Class ;
            rdfs:subClassOf :AIFunction ;
            rdfs:comment "Confirmation that the requirements for an intended use are met."@en ,
                         "Nachweis, dass die Anforderungen für einen vorgesehenen Verwendungszweck erfüllt sind."@de ;
            rdfs:label "Validation"@en ,
                       "Validierung"@de ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.5.18."@en .


###  https://w3id.org/aias/odp/iso22989#ValidationData
:ValidationData rdf:type owl:Class ;
                rdfs:subClassOf :Data ;
                rdfs:comment "Data used to compare the performance of candidate models, for example when selecting hyperparameters or models."@en ,
                             "Daten, die zum Vergleich der Leistung verschiedener Kandidatenmodelle genutzt werden, etwa zur Auswahl von Hyperparametern oder Modellen."@de ;
                rdfs:label "Validation Data"@en ,
                           "Validierungsdaten"@de ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, definition 3.2.15."@en .


