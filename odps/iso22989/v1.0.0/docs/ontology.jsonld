}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Generation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Creation of new outputs such as text, images or audio from learned representations."
  }, {
    "@language" : "de",
    "@value" : "Erzeugung neuer Ausgaben, etwa Texte, Bilder oder Audio, auf Basis gelernter Repräsentationen."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Generation"
  }, {
    "@language" : "de",
    "@value" : "Generierung"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
