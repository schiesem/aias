  }, {
    "@language" : "en",
    "@value" : "Machine Learning"
  }, {
    "@language" : "en",
    "@value" : "Ontology Design Pattern"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989 Ontology Design Pattern"
  } ],
  "http://purl.org/ontology/bibo/doi" : [ {
    "@value" : "10.1109/ETFA61755.2024.10710890"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@language" : "en",
    "@value" : "Draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "iso22989"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/aias/odp/iso22989#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Normative basis: ISO/IEC 22989:2022.\r\n\r\nThree views: the system with its components, functions and tasks, the algorithms, models and parameters, and the data with the processes acting on them.\r\n\r\nEvery definition carries a German wording alongside its English translation.\r\n\r\nScope: the AI system with its life cycle, the machine learning model with its data, and the tasks a model addresses. The qualities of clause 3.5 with their values, controllability and risk are not covered."
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.0.0"
  } ],
  "http://xmlns.com/foaf/0.1/fundedBy" : [ {
    "@id" : "https://dtecbw.de/"
  } ],
  "https://schema.org/codeRepository" : [ {
    "@id" : "https://github.com/schiesem/aias"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#AIComponent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A functional element that together with further components constitutes an AI system."
  }, {
    "@language" : "de",
    "@value" : "Ein funktionales Element, das zusammen mit weiteren Komponenten ein KI-System bildet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AI Component"
  }, {
    "@language" : "de",
    "@value" : "KI-Komponente"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.1.2."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#AIFunction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A function transforming inputs into outputs and thereby representing one step of the AI life cycle."
  }, {
    "@language" : "de",
    "@value" : "Funktion, die Eingaben in Ausgaben transformiert und dabei einen Schritt des KI-Lebenszyklus abbildet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
