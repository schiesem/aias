    "@language" : "de",
    "@value" : "Trefferquote"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#EvaluationMetric"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Regression",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Prediction of continuous quantities."
  }, {
    "@language" : "de",
    "@value" : "Vorhersage kontinuierlicher Größen."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Regression"
  }, {
    "@language" : "en",
    "@value" : "Regression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#AITask"
