  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An AI system split between cloud infrastructure and the edge."
  }, {
    "@language" : "de",
    "@value" : "Ein KI-System, das auf Cloud und Edge verteilt ausgeführt wird."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Hybrid"
  }, {
    "@language" : "en",
    "@value" : "Hybrid"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#SystemDesign"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Hyperparameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property of an algorithm governing its behaviour."
  }, {
    "@language" : "de",
    "@value" : "Eigenschaft eines Algorithmus, die dessen Verhalten steuert."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Hyperparameter"
  }, {
    "@language" : "en",
    "@value" : "Hyperparameter"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.3.4. Placed on the algorithm superclass, so that a training algorithm, a model algorithm and an evaluation algorithm may each carry one: a learning rate, the number of layers of a network, the threshold of a metric."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Imputation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Ersetzung fehlender Daten durch geschätzte oder modellierte Werte."
  }, {
    "@language" : "en",
    "@value" : "Replacement of missing data by estimated or modelled values."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Imputation"
  }, {
    "@language" : "en",
