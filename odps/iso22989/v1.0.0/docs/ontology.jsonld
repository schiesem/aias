    "@value" : "F1-Maß"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#EvaluationMetric"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Filtering",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Entfernung unerwünschter Daten."
  }, {
    "@language" : "en",
    "@value" : "Removal of unwanted data."
  } ],
