    "@language" : "en",
    "@value" : "Derived from ISO/IEC 22989, definition 3.3.6. A particular procedure such as gradient descent is recorded as a named instance of this class rather than as a class of its own."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#TrainingData",
