    "@value" : "System Design"
  }, {
    "@language" : "de",
    "@value" : "Systemauslegung"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 22989. Clause 8.6.2 discusses cloud and edge computing without defining the choice between them."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#TestData",
