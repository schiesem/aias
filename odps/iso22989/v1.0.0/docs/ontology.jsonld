  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 22989. A construct of this model."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#F1Score",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Harmonisches Mittel aus Präzision und Trefferquote."
