  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Kennzeichnung"
  }, {
    "@language" : "en",
    "@value" : "Labeling"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#DataProcess"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, clause 5.10, where labelling is discussed as part of the annotation rather than defined as a process of its own."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#LearningType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Art des maschinellen Lernens."
  }, {
    "@language" : "en",
    "@value" : "The kind of machine learning employed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Learning Type"
  }, {
    "@language" : "de",
    "@value" : "Lernart"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 22989. A collecting class of this model for the four kinds the standard defines separately."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#MLAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A specialisation of the training algorithm for machine learning, to which a kind of learning is assigned."
  }, {
    "@language" : "de",
    "@value" : "Spezialisierung des Trainingsalgorithmus für das maschinelle Lernen, dem eine Lernart zugeordnet ist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "ML-Algorithmus"
  }, {
    "@language" : "en",
    "@value" : "Machine Learning Algorithm"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#TrainingAlgorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.3.6."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#MachineLearning",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A process optimising the parameters of a model by computational means so that its behaviour reflects the underlying data or experience."
  }, {
    "@language" : "de",
    "@value" : "Prozess zur Optimierung von Modellparametern durch rechnergestützte Verfahren, sodass das Verhalten des Modells die zugrunde liegenden Daten oder Erfahrungen widerspiegelt."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Machine Learning"
  }, {
    "@language" : "de",
    "@value" : "Maschinelles Lernen"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.3.5."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Merging",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Combination of several data sources into one."
  }, {
    "@language" : "de",
    "@value" : "Zusammenführung mehrerer Datenquellen zu einer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Merging"
  }, {
    "@language" : "de",
    "@value" : "Zusammenführung"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#DataProcess"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 22989. A construct of this model, for the step that joins several datasets into one."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Model",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A mathematical construction generating inference or predictions from input data."
  }, {
    "@language" : "de",
    "@value" : "Mathematische Konstruktion, die auf Basis von Eingangsdaten Inferenz oder Vorhersagen erzeugt."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Model"
  }, {
    "@language" : "de",
    "@value" : "Modell"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.3.7. A model is a parameterised instance of an algorithm: the model algorithm describes the procedure without learned parameters, the model carries them."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#ModelAlgorithm",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A procedure describing the structure of a model, for example the architecture of a neural network."
  }, {
    "@language" : "de",
    "@value" : "Verfahren zur Beschreibung der Struktur eines Modells, etwa die Architektur eines neuronalen Netzes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Model Algorithm"
  }, {
    "@language" : "de",
    "@value" : "Modellalgorithmus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#Algorithm"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Derived from ISO/IEC 22989, definition 3.3.7."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#ModelParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An internal variable of a model affecting how its outputs are computed."
  }, {
    "@language" : "de",
    "@value" : "Interne Variable eines Modells, die beeinflusst, wie dessen Ausgaben berechnet werden."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Model Parameter"
  }, {
    "@language" : "de",
    "@value" : "Modellparameter"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.3.8."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Normalization",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Adjustment of data values to a common scale so that they become mathematically comparable."
  }, {
    "@language" : "de",
    "@value" : "Anpassung von Datenwerten auf eine gemeinsame Skala, um sie mathematisch vergleichbar zu machen."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Normalisierung"
  }, {
    "@language" : "en",
    "@value" : "Normalization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#DataProcess"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, clause 5.10."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Precision",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Anteil der korrekten Ergebnisse an den als positiv gemeldeten."
  }, {
    "@language" : "en",
    "@value" : "The proportion of correct results among those reported positive."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Precision"
  }, {
    "@language" : "de",
    "@value" : "Präzision"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#EvaluationMetric"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Prediction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Primäre Ausgabe eines KI-Systems, wenn Eingabedaten verarbeitet werden."
  }, {
    "@language" : "en",
    "@value" : "The primary output of an AI system when input data is processed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Prediction"
  }, {
    "@language" : "de",
    "@value" : "Vorhersage"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.1.27."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#ProductionData",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data arising during the operation of a deployed AI system, for which the system computes inferences."
  }, {
    "@language" : "de",
    "@value" : "Daten, die in der Betriebsphase eines eingesetzten KI-Systems anfallen und für die das System Inferenzen berechnet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "Betriebsdaten"
  }, {
    "@language" : "en",
    "@value" : "Production Data"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#Data"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.2.12."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Recall",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Anteil der gefundenen an allen positiven Fällen."
  }, {
    "@language" : "en",
    "@value" : "The proportion of positive cases that were found."
