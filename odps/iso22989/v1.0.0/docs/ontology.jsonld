  "@id" : "https://schema.org/codeRepository",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "An ontology design pattern for describing an artificial intelligence application, following the terminology of ISO/IEC 22989. It covers three views of the same system: the AI system with the functions of its life cycle and the tasks it addresses, the algorithms and models with the parameters that configure them, and the data with the processes that acquire, prepare and store it. The three meet where a training consumes a dataset and produces a model, which is what lets a model be traced back to the data it was built from. Sixty-two classes and twenty-five relations. The pattern is one of three subdomain patterns of the AIAS information model and is meant to be imported and aligned rather than used on its own."
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "M. Schieseck, P. Topalis, L. Reinpold, F. Gehlhoff and A. Fay, \"A Formal Model for Artificial Intelligence Applications in Automation Systems,\" 2024 IEEE 29th International Conference on Emerging Technologies and Factory Automation (ETFA), Padova, Italy, IEEE, September 2024. DOI 10.1109/ETFA61755.2024.10710890"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-09-01"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Alexander Fay"
  }, {
    "@value" : "Felix Gehlhoff"
  }, {
    "@value" : "Lasse Reinpold"
  }, {
    "@value" : "Marvin Schieseck"
  }, {
    "@value" : "Philip Topalis"
  } ],
  "http://purl.org/dc/terms/hasVersion" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-02"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "Helmut-Schmidt-Universität / Universität der Bundeswehr Hamburg"
  } ],
  "http://purl.org/dc/terms/rights" : [ {
    "@language" : "en",
    "@value" : "This research is funded by dtec.bw – Digitalization and Technology Research Center of the Bundeswehr. dtec.bw is funded by the European Union – NextGenerationEU"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://www.iso.org/standard/74296.html"
  } ],
