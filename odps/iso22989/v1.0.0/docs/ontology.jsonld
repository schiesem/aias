  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/aias/odp/iso22989#DataProcess"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.2.8."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Inference",
