  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#AISystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An engineered system that generates outputs such as predictions, recommendations or decisions from data in order to support human-defined objectives."
  }, {
    "@language" : "de",
    "@value" : "Ein konstruiertes System, das auf Basis von Daten Ausgaben wie Vorhersagen, Empfehlungen oder Entscheidungen erzeugt, um menschlich definierte Ziele zu unterstützen."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AI System"
