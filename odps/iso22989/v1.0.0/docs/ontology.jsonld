  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, definition 3.1.17."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#Labeling",
