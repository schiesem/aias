  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 22989, clause 9."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso22989#ReinforcementLearning",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Machine learning that learns an optimal sequence of actions by interacting with an environment in order to maximise a reward."
  }, {
    "@language" : "de",
    "@value" : "Maschinelles Lernen, das eine optimale Abfolge von Aktionen durch Interaktion mit einer Umgebung erlernt, um eine maximale Belohnung zu erzielen."
  } ],
