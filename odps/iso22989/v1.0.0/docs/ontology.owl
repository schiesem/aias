    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
    <rdfs:comment xml:lang="en">A procedure assessing a model against an evaluation metric.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verfahren zur Bewertung eines Modells anhand einer Evaluationsmetrik.</rdfs:comment>
    <rdfs:label xml:lang="en">Evaluation Algorithm</rdfs:label>
    <rdfs:label xml:lang="de">Evaluationsalgorithmus</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A construct of this model.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Labeling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="en">Assignment of a label to a data element.</rdfs:comment>
    <rdfs:comment xml:lang="de">Zuordnung eines Labels zu einem Datenelement.</rdfs:comment>
    <rdfs:label xml:lang="de">Kennzeichnung</rdfs:label>
    <rdfs:label xml:lang="en">Labeling</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10, where labelling is discussed as part of the annotation rather than defined as a process of its own.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#ProductionData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdfs:comment xml:lang="en">Data arising during the operation of a deployed AI system, for which the system computes inferences.</rdfs:comment>
    <rdfs:comment xml:lang="de">Daten, die in der Betriebsphase eines eingesetzten KI-Systems anfallen und für die das System Inferenzen berechnet.</rdfs:comment>
    <rdfs:label xml:lang="de">Betriebsdaten</rdfs:label>
    <rdfs:label xml:lang="en">Production Data</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.12.</skos:note>
  </rdf:Description>
