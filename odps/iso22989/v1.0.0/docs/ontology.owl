  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Annotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="en">Addition of significant information as metadata, for example labels or provenance.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ergänzung signifikanter Informationen als Metadaten, etwa Labels oder Herkunftsinformationen.</rdfs:comment>
    <rdfs:label xml:lang="de">Annotation</rdfs:label>
    <rdfs:label xml:lang="en">Annotation</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/subject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Normalization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="en">Adjustment of data values to a common scale so that they become mathematically comparable.</rdfs:comment>
    <rdfs:comment xml:lang="de">Anpassung von Datenwerten auf eine gemeinsame Skala, um sie mathematisch vergleichbar zu machen.</rdfs:comment>
    <rdfs:label xml:lang="de">Normalisierung</rdfs:label>
    <rdfs:label xml:lang="en">Normalization</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N37799eb49b354cf795a59d6f559a7af2">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Acquisition"/>
    <rdf:rest rdf:nodeID="N5eeb414b4b604435afc6462029528989"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Imputation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="de">Ersetzung fehlender Daten durch geschätzte oder modellierte Werte.</rdfs:comment>
    <rdfs:comment xml:lang="en">Replacement of missing data by estimated or modelled values.</rdfs:comment>
    <rdfs:label xml:lang="de">Imputation</rdfs:label>
    <rdfs:label xml:lang="en">Imputation</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.8.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Merging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="en">Combination of several data sources into one.</rdfs:comment>
    <rdfs:comment xml:lang="de">Zusammenführung mehrerer Datenquellen zu einer.</rdfs:comment>
    <rdfs:label xml:lang="en">Merging</rdfs:label>
    <rdfs:label xml:lang="de">Zusammenführung</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A construct of this model, for the step that joins several datasets into one.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd81df7c6b76e41a3b71af81b9e6f6bd6">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdf:rest rdf:nodeID="Ne6034aa3700345499842ba96373ae6fb"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#ReinforcementLearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
    <rdfs:comment xml:lang="en">Machine learning that learns an optimal sequence of actions by interacting with an environment in order to maximise a reward.</rdfs:comment>
    <rdfs:comment xml:lang="de">Maschinelles Lernen, das eine optimale Abfolge von Aktionen durch Interaktion mit einer Umgebung erlernt, um eine maximale Belohnung zu erzielen.</rdfs:comment>
    <rdfs:label xml:lang="de">Bestärkendes Lernen</rdfs:label>
    <rdfs:label xml:lang="en">Reinforcement Learning</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.9.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#DataProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="en">A step transforming input data into output data.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein Schritt, der Eingabedaten in Ausgabedaten umwandelt.</rdfs:comment>
    <rdfs:label xml:lang="en">Data Process</rdfs:label>
    <rdfs:label xml:lang="de">Datenprozess</rdfs:label>
    <skos:altLabel xml:lang="de">Datenverarbeitung</skos:altLabel>
    <skos:altLabel xml:lang="en">data processing</skos:altLabel>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10, which describes the transformation of input data into output data without giving it an entry of its own. The class collects the steps that transformation is made of, and carries the wording of the standard as an alternative label.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#consistsOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIComponent"/>
    <rdfs:comment xml:lang="en">Relates an AI system to a component it is built from.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein KI-System mit einer Komponente, aus der es aufgebaut ist.</rdfs:comment>
    <rdfs:label xml:lang="de">besteht aus</rdfs:label>
    <rdfs:label xml:lang="en">consists of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Acquisition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="de">Gewinnung von Daten aus Datenquellen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Obtaining data from data sources.</rdfs:comment>
    <rdfs:label xml:lang="en">Acquisition</rdfs:label>
    <rdfs:label xml:lang="de">Datenerfassung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#isEvaluatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Evaluation"/>
    <rdfs:comment xml:lang="en">Relates a model to the evaluation assessing it.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein Modell mit der Evaluation, die es bewertet.</rdfs:comment>
    <rdfs:label xml:lang="en">is evaluated by</rdfs:label>
    <rdfs:label xml:lang="de">wird evaluiert durch</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6aa16b32c452485d8116fe3c03d96cb5">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationAlgorithm"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AISystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An engineered system that generates outputs such as predictions, recommendations or decisions from data in order to support human-defined objectives.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein konstruiertes System, das auf Basis von Daten Ausgaben wie Vorhersagen, Empfehlungen oder Entscheidungen erzeugt, um menschlich definierte Ziele zu unterstützen.</rdfs:comment>
    <rdfs:label xml:lang="en">AI System</rdfs:label>
    <rdfs:label xml:lang="de">KI-System</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.1.4.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Generation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AITask"/>
    <rdfs:comment xml:lang="en">Creation of new outputs such as text, images or audio from learned representations.</rdfs:comment>
    <rdfs:comment xml:lang="de">Erzeugung neuer Ausgaben, etwa Texte, Bilder oder Audio, auf Basis gelernter Repräsentationen.</rdfs:comment>
    <rdfs:label xml:lang="en">Generation</rdfs:label>
    <rdfs:label xml:lang="de">Generierung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 9.2.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N695736e37c2148d0898bb9ab21ca3a59">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#ReinforcementLearning"/>
    <rdf:rest rdf:nodeID="N63e4a2e994324bb2aab441725909dc31"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#basedOnLearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#MLAlgorithm"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
    <rdfs:comment xml:lang="en">Relates a machine learning algorithm to the kind of learning it performs.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet einen ML-Algorithmus mit der Lernart, die er ausführt.</rdfs:comment>
    <rdfs:label xml:lang="en">based on learning</rdfs:label>
    <rdfs:label xml:lang="de">basiert auf Lernart</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#ModelAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
    <rdfs:comment xml:lang="en">A procedure describing the structure of a model, for example the architecture of a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verfahren zur Beschreibung der Struktur eines Modells, etwa die Architektur eines neuronalen Netzes.</rdfs:comment>
    <rdfs:label xml:lang="en">Model Algorithm</rdfs:label>
    <rdfs:label xml:lang="de">Modellalgorithmus</rdfs:label>
    <skos:note xml:lang="en">Derived from ISO/IEC 22989, definition 3.3.7.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#TrainingAlgorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
    <rdfs:comment xml:lang="en">A procedure determining the parameters of a model from data according to given criteria.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verfahren zur Bestimmung der Parameter eines Modells aus Daten nach vorgegebenen Kriterien.</rdfs:comment>
    <rdfs:label xml:lang="en">Training Algorithm</rdfs:label>
    <rdfs:label xml:lang="de">Trainingsalgorithmus</rdfs:label>
    <skos:note xml:lang="en">Derived from ISO/IEC 22989, definition 3.3.6. A particular procedure such as gradient descent is recorded as a named instance of this class rather than as a class of its own.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Cloud">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
    <rdfs:comment xml:lang="en">An AI system running on cloud infrastructure.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein KI-System, das auf Cloud-Infrastruktur ausgeführt wird.</rdfs:comment>
    <rdfs:label xml:lang="de">Cloud</rdfs:label>
    <rdfs:label xml:lang="en">Cloud</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Clustering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AITask"/>
    <rdfs:comment xml:lang="en">Identification of groups of similar examples.</rdfs:comment>
    <rdfs:comment xml:lang="de">Identifikation von Gruppen ähnlicher Beispiele.</rdfs:comment>
    <rdfs:label xml:lang="de">Clustering</rdfs:label>
    <rdfs:label xml:lang="en">Clustering</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.11.2.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#isStoredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="Nff9c6f1aeecc46bc84fda318329b10c5"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Storage"/>
    <rdfs:comment xml:lang="en">Relates data to the storing that persisted it.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet Daten mit der Speicherung, die sie abgelegt hat.</rdfs:comment>
    <rdfs:label xml:lang="en">is stored by</rdfs:label>
    <rdfs:label xml:lang="de">wird gespeichert durch</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Oberklasse für parametrisierbare mathematische Verfahren.</rdfs:comment>
    <rdfs:comment xml:lang="en">Superclass of parameterisable mathematical procedures.</rdfs:comment>
    <rdfs:label xml:lang="en">Algorithm</rdfs:label>
    <rdfs:label xml:lang="de">Algorithmus</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989, which defines the machine learning algorithm alone, 3.3.6. The superclass and two of the three specialisations are constructs of this model.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N65bb2090a3b34e9ab8da872f3c319464">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Generation"/>
    <rdf:rest rdf:nodeID="Na51d62e88f6b40818829d155afff3185"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6b3d206c01b842bc96de8ab80ab2ac06">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
    <rdf:rest rdf:nodeID="N3a07673f3748421b9f2cd7e9e9c2de3c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#SemiSupervisedLearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
    <rdfs:comment xml:lang="en">Machine learning using both labelled and unlabelled data during training.</rdfs:comment>
    <rdfs:comment xml:lang="de">Maschinelles Lernen, das während des Trainings sowohl gekennzeichnete als auch nicht gekennzeichnete Daten nutzt.</rdfs:comment>
    <rdfs:label xml:lang="en">Semi-supervised Learning</rdfs:label>
    <rdfs:label xml:lang="de">Teilüberwachtes Lernen</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.11.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#usesData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:range rdf:nodeID="N5889c1519acf4b58b282ced048525462"/>
    <rdfs:comment xml:lang="en">Relates a function to the data it works on.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Funktion mit den Daten, auf denen sie arbeitet.</rdfs:comment>
    <rdfs:label xml:lang="de">nutzt Daten</rdfs:label>
    <rdfs:label xml:lang="en">uses data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/aias/odp/iso22989/1.0.0"/>
    <dcterms:abstract xml:lang="en">An ontology design pattern for describing an artificial intelligence application, following the terminology of ISO/IEC 22989. It covers three views of the same system: the AI system with the functions of its life cycle and the tasks it addresses, the algorithms and models with the parameters that configure them, and the data with the processes that acquire, prepare and store it. The three meet where a training consumes a dataset and produces a model, which is what lets a model be traced back to the data it was built from. Sixty-one classes and twenty-five relations. The pattern is one of three subdomain patterns of the AIAS information model and is meant to be imported and aligned rather than used on its own.</dcterms:abstract>
    <dcterms:bibliographicCitation xml:lang="en">M. Schieseck, P. Topalis, L. Reinpold, F. Gehlhoff and A. Fay, "A Formal Model for Artificial Intelligence Applications in Automation Systems," 2024 IEEE 29th International Conference on Emerging Technologies and Factory Automation (ETFA), Padova, Italy, IEEE, September 2024. DOI 10.1109/ETFA61755.2024.10710890</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-01</dcterms:created>
    <dcterms:creator>Alexander Fay</dcterms:creator>
    <dcterms:creator>Felix Gehlhoff</dcterms:creator>
    <dcterms:creator>Lasse Reinpold</dcterms:creator>
    <dcterms:creator>Marvin Schieseck</dcterms:creator>
    <dcterms:creator>Philip Topalis</dcterms:creator>
    <dcterms:hasVersion rdf:resource="https://w3id.org/aias/odp/iso22989"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-03</dcterms:modified>
    <dcterms:publisher>Helmut-Schmidt-Universität / Universität der Bundeswehr Hamburg</dcterms:publisher>
    <dcterms:rights xml:lang="en">This research is funded by dtec.bw – Digitalization and Technology Research Center of the Bundeswehr. dtec.bw is funded by the European Union – NextGenerationEU</dcterms:rights>
    <dcterms:source rdf:resource="https://www.iso.org/standard/74296.html"/>
    <dcterms:subject xml:lang="en">AI Life Cycle</dcterms:subject>
    <dcterms:subject xml:lang="en">Artificial Intelligence</dcterms:subject>
    <dcterms:subject xml:lang="en">ISO/IEC 22989</dcterms:subject>
    <dcterms:subject xml:lang="en">Machine Learning</dcterms:subject>
    <dcterms:subject xml:lang="en">Ontology Design Pattern</dcterms:subject>
    <dcterms:title xml:lang="en">ISO/IEC 22989 Ontology Design Pattern</dcterms:title>
    <bibo:doi>10.1109/ETFA61755.2024.10710890</bibo:doi>
    <bibo:status xml:lang="en">Draft</bibo:status>
    <vann:preferredNamespacePrefix>iso22989</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/aias/odp/iso22989#</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Normative basis: ISO/IEC 22989:2022.

Three views: the system with its components, functions and tasks, the algorithms, models and parameters, and the data with the processes acting on them.

Every definition carries a German wording alongside its English translation.

Scope: the AI system with its life cycle, the machine learning model with its data, and the tasks a model addresses. The qualities of clause 3.5 with their values, controllability and risk are not covered.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <foaf:fundedBy rdf:resource="https://dtecbw.de/"/>
    <schema:codeRepository rdf:resource="https://github.com/schiesem/aias"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#isPerformedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#MachineLearning"/>
    <rdfs:comment xml:lang="en">Relates a training to the machine learning carrying it out.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein Training mit dem maschinellen Lernen, das es durchführt.</rdfs:comment>
    <rdfs:label xml:lang="en">is performed by</rdfs:label>
    <rdfs:label xml:lang="de">wird durchgeführt durch</rdfs:label>
    <skos:note xml:lang="en">A training is performed by a machine learning, not the other way round, so the relation is directed rather than symmetric.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6c19563d0c0c42949ba4cd289ccc4879">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Clustering"/>
    <rdf:rest rdf:nodeID="N65bb2090a3b34e9ab8da872f3c319464"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasDataSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Acquisition"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataSource"/>
    <rdfs:comment xml:lang="en">Relates an acquisition to the source it obtains data from.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Erfassung mit der Quelle, aus der sie Daten gewinnt.</rdfs:comment>
    <rdfs:label xml:lang="en">has data source</rdfs:label>
    <rdfs:label xml:lang="de">hat Datenquelle</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AIComponent"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="en">Relates an AI component to a function it performs.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine KI-Komponente mit einer Funktion, die sie ausführt.</rdfs:comment>
    <rdfs:label xml:lang="en">has function</rdfs:label>
    <rdfs:label xml:lang="de">hat Funktion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Filtering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="de">Entfernung unerwünschter Daten.</rdfs:comment>
    <rdfs:comment xml:lang="en">Removal of unwanted data.</rdfs:comment>
    <rdfs:label xml:lang="en">Filtering</rdfs:label>
    <rdfs:label xml:lang="de">Filterung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#determines">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#ModelParameter"/>
    <rdfs:comment xml:lang="en">Relates a training to the model parameters it determines.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein Training mit den Modellparametern, die es bestimmt.</rdfs:comment>
    <rdfs:label xml:lang="de">bestimmt</rdfs:label>
    <rdfs:label xml:lang="en">determines</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#SymbolicAI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
    <rdfs:comment xml:lang="de">Techniken, die mit expliziten Symbolen und Regeln arbeiten, um Schlussfolgerungen zu ziehen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Techniques working with explicit symbols and rules in order to draw inferences.</rdfs:comment>
    <rdfs:label xml:lang="en">Symbolic AI</rdfs:label>
    <rdfs:label xml:lang="de">Symbolische KI</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.1.33.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AITask"/>
    <rdfs:comment xml:lang="en">Assignment of inputs to discrete classes.</rdfs:comment>
    <rdfs:comment xml:lang="de">Zuordnung von Eingaben zu diskreten Klassen.</rdfs:comment>
    <rdfs:label xml:lang="en">Classification</rdfs:label>
    <rdfs:label xml:lang="de">Klassifikation</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 9.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#SystemDesign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Where an AI system runs, that is on cloud infrastructure, near the process at the edge, or split between the two.</rdfs:comment>
    <rdfs:comment xml:lang="de">Wo ein KI-System ausgeführt wird, also auf Cloud-Infrastruktur, prozessnah am Edge oder auf beide verteilt.</rdfs:comment>
    <rdfs:label xml:lang="en">System Design</rdfs:label>
    <rdfs:label xml:lang="de">Systemauslegung</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. Clause 8.6.2 discusses cloud and edge computing without defining the choice between them.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#creates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Inference"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Prediction"/>
    <rdfs:comment xml:lang="en">Relates an inference to the prediction it produces.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Inferenz mit der Vorhersage, die sie erzeugt.</rdfs:comment>
    <rdfs:label xml:lang="en">creates</rdfs:label>
    <rdfs:label xml:lang="de">erzeugt</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A function transforming inputs into outputs and thereby representing one step of the AI life cycle.</rdfs:comment>
    <rdfs:comment xml:lang="de">Funktion, die Eingaben in Ausgaben transformiert und dabei einen Schritt des KI-Lebenszyklus abbildet.</rdfs:comment>
    <rdfs:label xml:lang="en">AI Function</rdfs:label>
    <rdfs:label xml:lang="de">KI-Funktion</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A collecting class of this model for the eight functions below.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#ModelParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An internal variable of a model affecting how its outputs are computed.</rdfs:comment>
    <rdfs:comment xml:lang="de">Interne Variable eines Modells, die beeinflusst, wie dessen Ausgaben berechnet werden.</rdfs:comment>
    <rdfs:label xml:lang="en">Model Parameter</rdfs:label>
    <rdfs:label xml:lang="de">Modellparameter</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.8.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Precision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationMetric"/>
    <rdfs:comment xml:lang="de">Anteil der korrekten Ergebnisse an den als positiv gemeldeten.</rdfs:comment>
    <rdfs:comment xml:lang="en">The proportion of correct results among those reported positive.</rdfs:comment>
    <rdfs:label xml:lang="en">Precision</rdfs:label>
    <rdfs:label xml:lang="de">Präzision</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Storage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="de">Ablage von Daten in einer Datensenke.</rdfs:comment>
    <rdfs:comment xml:lang="en">Persisting data to a data sink.</rdfs:comment>
    <rdfs:label xml:lang="de">Speicherung</rdfs:label>
    <rdfs:label xml:lang="en">Storage</rdfs:label>
    <skos:altLabel xml:lang="en">storing</skos:altLabel>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10, which names the step "storing". The class carries that wording as an alternative label and is named for the thing the step produces, which is how the literature of engineering practice refers to it.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3f2d975a0e4845e98116cec9ad19bdcf">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#TrainingAlgorithm"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#executes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Inference"/>
    <rdfs:comment xml:lang="en">Relates a model to the inference it carries out.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein Modell mit der Inferenz, die es ausführt.</rdfs:comment>
    <rdfs:label xml:lang="en">executes</rdfs:label>
    <rdfs:label xml:lang="de">führt aus</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd6c07333f762484ba33c9b19ad9eaa91">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#TrainingData"/>
    <rdf:rest rdf:nodeID="N375f47b282c9439598bbc2050b49ded2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#DataSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Ort, aus dem Daten gewonnen werden.</rdfs:comment>
    <rdfs:comment xml:lang="en">Where data is obtained from.</rdfs:comment>
    <rdfs:label xml:lang="en">Data Source</rdfs:label>
    <rdfs:label xml:lang="de">Datenquelle</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A construct of this model, needed by the acquisition.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N13f705dae9584cb78942a4135b969244">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Evaluation"/>
    <rdf:rest rdf:nodeID="Nd4979c082abe4c78b37ebcdffecfc338"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:resource="https://w3id.org/aias/odp/iso22989#TestData"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdfs:comment xml:lang="en">Data used to assess the performance of a final model, disjoint from training and validation data.</rdfs:comment>
    <rdfs:comment xml:lang="de">Daten, die zur Beurteilung der Leistung eines finalen Modells verwendet werden und disjunkt zu Trainings- und Validierungsdaten sind.</rdfs:comment>
    <rdfs:label xml:lang="en">Evaluation Data</rdfs:label>
    <rdfs:label xml:lang="de">Evaluationsdaten</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.14.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndf87ef3b050544e5a0e4d9256eb3503f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N2ae3bf47cf7f45d280128804715fd028"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N169a6111d447413bb4e318eebbdf8d41">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Imputation"/>
    <rdf:rest rdf:nodeID="Nb017ac4158e5455d9a63121b25f75e5d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A measure against which the performance of a model is assessed.</rdfs:comment>
    <rdfs:comment xml:lang="de">Maß, anhand dessen die Leistung eines Modells bewertet wird.</rdfs:comment>
    <rdfs:label xml:lang="en">Evaluation Metric</rdfs:label>
    <rdfs:label xml:lang="de">Evaluationsmetrik</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A construct of this model.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A mathematical construction generating inference or predictions from input data.</rdfs:comment>
    <rdfs:comment xml:lang="de">Mathematische Konstruktion, die auf Basis von Eingangsdaten Inferenz oder Vorhersagen erzeugt.</rdfs:comment>
    <rdfs:label xml:lang="en">Model</rdfs:label>
    <rdfs:label xml:lang="de">Modell</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.7. A model is a parameterised instance of an algorithm: the model algorithm describes the procedure without learned parameters, the model carries them.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Hybrid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
    <rdfs:comment xml:lang="en">An AI system split between cloud infrastructure and the edge.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein KI-System, das auf Cloud und Edge verteilt ausgeführt wird.</rdfs:comment>
    <rdfs:label xml:lang="de">Hybrid</rdfs:label>
    <rdfs:label xml:lang="en">Hybrid</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#SupervisedLearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
    <rdfs:comment xml:lang="en">Machine learning using labelled data only during training.</rdfs:comment>
    <rdfs:comment xml:lang="de">Maschinelles Lernen, das während des Trainings ausschließlich gekennzeichnete Daten verwendet.</rdfs:comment>
    <rdfs:label xml:lang="en">Supervised Learning</rdfs:label>
    <rdfs:label xml:lang="de">Überwachtes Lernen</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.12.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#LearningType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Art des maschinellen Lernens.</rdfs:comment>
    <rdfs:comment xml:lang="en">The kind of machine learning employed.</rdfs:comment>
    <rdfs:label xml:lang="en">Learning Type</rdfs:label>
    <rdfs:label xml:lang="de">Lernart</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A collecting class of this model for the four kinds the standard defines separately.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc2cfd2bbfeb64936b1e1e737d1da938c">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Normalization"/>
    <rdf:rest rdf:nodeID="N0ee9caae3a87474c90faddfe4f4d309f"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#note">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2f27be12261d48418c82c53a8c36a8c2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N62accfe3ef66410fa0bb70936d78237c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6c878e731e4743439aa9e82e3661419f">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdf:rest rdf:nodeID="N80794c38f4df44f0b685c4388360f553"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1490352998bb4dd0ae8f52b1d9d56a92">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#F1Score"/>
    <rdf:rest rdf:nodeID="N491cb41137d44623a16090f9fcbbf33e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
    <rdfs:comment xml:lang="en">Relates an AI system to the kind of AI it employs, that is symbolic, subsymbolic or a combination of the two.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein KI-System mit der Art der eingesetzten KI, also symbolisch, subsymbolisch oder kombiniert.</rdfs:comment>
    <rdfs:label xml:lang="en">has type</rdfs:label>
    <rdfs:label xml:lang="de">hat Art</rdfs:label>
    <skos:note xml:lang="en">Relates a system to the kind of AI it is built on, symbolic or subsymbolic.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#usesMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="Nc0650f45669f4324be67368a9c538704"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationMetric"/>
    <rdfs:comment xml:lang="en">Relates an evaluation, or the algorithm it runs, to the metric it measures against.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Evaluation oder den von ihr ausgeführten Algorithmus mit der Metrik, gegen die gemessen wird.</rdfs:comment>
    <rdfs:label xml:lang="de">nutzt Metrik</rdfs:label>
    <rdfs:label xml:lang="en">uses metric</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc0650f45669f4324be67368a9c538704">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N8e52fa8a91484340af43b74a07c84c9e"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/hasVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N14a593fbacff443d90fc5b328605c0f4"/>
    <rdfs:range rdf:nodeID="Nf7d5417de8524536974e2150aa43180d"/>
    <rdfs:comment xml:lang="en">Relates an algorithm to a hyperparameter governing it, and a model to a parameter determined for it.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet einen Algorithmus mit einem ihn steuernden Hyperparameter sowie ein Modell mit einem für es bestimmten Parameter.</rdfs:comment>
    <rdfs:label xml:lang="en">has parameter</rdfs:label>
    <rdfs:label xml:lang="de">hat Parameter</rdfs:label>
    <skos:note xml:lang="en">One relation with two domains. The hyperparameter is defined on the algorithm superclass, so a training algorithm, a model algorithm and an evaluation algorithm may each carry one.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="en">Reasoning by which results are derived from given premises or data.</rdfs:comment>
    <rdfs:comment xml:lang="de">Schlussfolgern, bei dem aus gegebenen Prämissen beziehungsweise Daten Ergebnisse abgeleitet werden.</rdfs:comment>
    <rdfs:label xml:lang="en">Inference</rdfs:label>
    <rdfs:label xml:lang="de">Inferenz</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.1.17.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Prediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Primäre Ausgabe eines KI-Systems, wenn Eingabedaten verarbeitet werden.</rdfs:comment>
    <rdfs:comment xml:lang="en">The primary output of an AI system when input data is processed.</rdfs:comment>
    <rdfs:label xml:lang="en">Prediction</rdfs:label>
    <rdfs:label xml:lang="de">Vorhersage</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.1.27.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#TestData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdfs:comment xml:lang="en">Data used to assess the performance of a final model.</rdfs:comment>
    <rdfs:comment xml:lang="de">Daten, die zur Beurteilung der Leistung eines finalen Modells verwendet werden.</rdfs:comment>
    <rdfs:label xml:lang="en">Test Data</rdfs:label>
    <rdfs:label xml:lang="de">Testdaten</rdfs:label>
    <skos:note xml:lang="en">Equivalent to the evaluation data: the two name the same thing, one in the wording of the standard and one in the wording of practice.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#createsProcessedData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:range rdf:nodeID="N6032cf48f01c4526b42e7b4215631691"/>
    <rdfs:comment xml:lang="en">Relates a data process to the data it produces.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet einen Datenprozess mit den Daten, die er erzeugt.</rdfs:comment>
    <rdfs:label xml:lang="en">creates processed data</rdfs:label>
    <rdfs:label xml:lang="de">erzeugt verarbeitete Daten</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd85351d2d0f849d196d774be01fcac72">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="Nec6a9117304e4910b2d50832895a0234"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5a00484ac6854e0dacec066e7591f612">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#TrainingData"/>
    <rdf:rest rdf:nodeID="N800f55b39abc421dacd049f764b9da23"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/fundedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#SubSymbolicAI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#SymbolicAI"/>
    <rdfs:comment xml:lang="de">Techniken, deren Repräsentationen implizit aus Daten oder Erfahrung abgeleitet werden.</rdfs:comment>
    <rdfs:comment xml:lang="en">Techniques whose representations are derived implicitly from data or experience.</rdfs:comment>
    <rdfs:label xml:lang="en">Subsymbolic AI</rdfs:label>
    <rdfs:label xml:lang="de">Subsymbolische KI</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.1.34.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Augmentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="en">Creation of additional data by transforming existing data in order to enlarge a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="de">Erzeugung zusätzlicher Daten durch Transformation vorhandener Daten, um einen Datensatz zu erweitern.</rdfs:comment>
    <rdfs:label xml:lang="en">Augmentation</rdfs:label>
    <rdfs:label xml:lang="de">Augmentierung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N90bb3418a2a04be1a99ce658537ab2ef">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A reinterpretable representation of information in a formalised manner suitable for communication, interpretation or processing.</rdfs:comment>
    <rdfs:comment xml:lang="de">Reinterpretierbare Darstellung von Information in formalisierter Weise, geeignet zur Kommunikation, Interpretation oder Verarbeitung.</rdfs:comment>
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <rdfs:label xml:lang="de">Daten</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.3.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Validation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="en">Confirmation that the requirements for an intended use are met.</rdfs:comment>
    <rdfs:comment xml:lang="de">Nachweis, dass die Anforderungen für einen vorgesehenen Verwendungszweck erfüllt sind.</rdfs:comment>
    <rdfs:label xml:lang="en">Validation</rdfs:label>
    <rdfs:label xml:lang="de">Validierung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.5.18.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N701fe18a80eb409ab300020f51455e77">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N6fbbfe2a62924f828e3098418a3457cf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N32449f3b3f614b6fb4f02b4f1a2c7aa4">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Sample"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#F1Score">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationMetric"/>
    <rdfs:comment xml:lang="de">Harmonisches Mittel aus Präzision und Trefferquote.</rdfs:comment>
    <rdfs:comment xml:lang="en">The harmonic mean of precision and recall.</rdfs:comment>
    <rdfs:label xml:lang="en">F1 Score</rdfs:label>
    <rdfs:label xml:lang="de">F1-Maß</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4bd7432969f441afb584df370b6a120d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N9f2a726a3f0f43908f8460dd24d30163"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbb9b99434ff54c46910761c842320693">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Edge"/>
    <rdf:rest rdf:nodeID="Ne58bd1fcfa1c4523a4558b4f593f492c"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="en">Assessment of the performance of an AI system before it is deployed.</rdfs:comment>
    <rdfs:comment xml:lang="de">Bewertung der Leistung des KI-Systems vor dem Einsatz.</rdfs:comment>
    <rdfs:label xml:lang="de">Evaluation</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, clause 5.10.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N62accfe3ef66410fa0bb70936d78237c">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#ProductionData"/>
    <rdf:rest rdf:nodeID="Nd6c07333f762484ba33c9b19ad9eaa91"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="de">Bestimmung oder Verbesserung der Parameter eines Modells anhand von Trainingsdaten.</rdfs:comment>
    <rdfs:comment xml:lang="en">Determining or improving the parameters of a model from training data.</rdfs:comment>
    <rdfs:label xml:lang="de">Training</rdfs:label>
    <rdfs:label xml:lang="en">Training</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.15.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasDataSink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Storage"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataSink"/>
    <rdfs:comment xml:lang="en">Relates a storing to the sink it persists data to.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Speicherung mit der Senke, in der sie Daten ablegt.</rdfs:comment>
    <rdfs:label xml:lang="en">has data sink</rdfs:label>
    <rdfs:label xml:lang="de">hat Datensenke</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N61920be7c433486c981389f3c017e641">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdf:rest rdf:nodeID="N5b31ebc7341047b68f32420f0bd7e14d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#ValidationData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdfs:comment xml:lang="en">Data used to compare the performance of candidate models, for example when selecting hyperparameters or models.</rdfs:comment>
    <rdfs:comment xml:lang="de">Daten, die zum Vergleich der Leistung verschiedener Kandidatenmodelle genutzt werden, etwa zur Auswahl von Hyperparametern oder Modellen.</rdfs:comment>
    <rdfs:label xml:lang="en">Validation Data</rdfs:label>
    <rdfs:label xml:lang="de">Validierungsdaten</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.15.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#fulfillsTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Prediction"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AITask"/>
    <rdfs:comment xml:lang="en">Relates a prediction to the task it addresses.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Vorhersage mit der Aufgabe, die sie adressiert.</rdfs:comment>
    <rdfs:label xml:lang="de">erfüllt Aufgabe</rdfs:label>
    <rdfs:label xml:lang="en">fulfills task</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne58bd1fcfa1c4523a4558b4f593f492c">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Hybrid"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N25555e0d0cee4342b0292c4e8b19080c">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Annotation"/>
    <rdf:rest rdf:nodeID="Nbf7720dceb974aeb83b29213278e04e5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Sample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An atomic data element processed in large numbers by an ML algorithm or an AI system.</rdfs:comment>
    <rdfs:comment xml:lang="de">Atomares Datenelement, das von einem ML-Algorithmus oder KI-System in großer Zahl verarbeitet wird.</rdfs:comment>
    <rdfs:label xml:lang="de">Datenelement</rdfs:label>
    <rdfs:label xml:lang="en">Sample</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.13.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#isComposedOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N854511314edf41f798f7193d049133ae"/>
    <rdfs:range rdf:nodeID="N630947289b87479c8e1a13531d4c97df"/>
    <rdfs:comment xml:lang="en">Relates a dataset to the data it collects, and data to the samples it consists of.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet einen Datensatz mit den Daten, die er sammelt, sowie Daten mit den Datenelementen, aus denen sie bestehen.</rdfs:comment>
    <rdfs:label xml:lang="de">besteht aus</rdfs:label>
    <rdfs:label xml:lang="en">is composed of</rdfs:label>
    <skos:note xml:lang="en">One relation used at two levels: a dataset is composed of data, and data of samples. Its domain and range are therefore unions, since each covers both levels.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N63e4a2e994324bb2aab441725909dc31">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#SemiSupervisedLearning"/>
    <rdf:rest rdf:nodeID="N84cc2757f4894167b70c3e4e5d59a116"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/rights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Hyperparameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A property of an algorithm governing its behaviour.</rdfs:comment>
    <rdfs:comment xml:lang="de">Eigenschaft eines Algorithmus, die dessen Verhalten steuert.</rdfs:comment>
    <rdfs:label xml:lang="de">Hyperparameter</rdfs:label>
    <rdfs:label xml:lang="en">Hyperparameter</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.4. Placed on the algorithm superclass, so that a training algorithm, a model algorithm and an evaluation algorithm may each carry one: a learning rate, the number of layers of a network, the threshold of a metric.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#TrainingData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
    <rdfs:comment xml:lang="en">Data used to determine the parameters of a model during training.</rdfs:comment>
    <rdfs:comment xml:lang="de">Daten, die zur Bestimmung der Parameter eines Modells im Trainingsprozess verwendet werden.</rdfs:comment>
    <rdfs:label xml:lang="en">Training Data</rdfs:label>
    <rdfs:label xml:lang="de">Trainingsdaten</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.16.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Automate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
    <rdfs:comment xml:lang="de">Ausführung eines Vorgangs ohne menschliches Eingreifen.</rdfs:comment>
    <rdfs:comment xml:lang="en">Carrying out a procedure without human intervention.</rdfs:comment>
    <rdfs:label xml:lang="en">Automate</rdfs:label>
    <rdfs:label xml:lang="de">Automatisieren</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. Definition 3.1.7 defines automatic as an adjective, not as a thing a model instantiates. The class is kept for the function it names in a plant.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Sampling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
    <rdfs:comment xml:lang="de">Auswahl einer repräsentativen Teilmenge der Daten.</rdfs:comment>
    <rdfs:comment xml:lang="en">Selection of a representative subset of the data.</rdfs:comment>
    <rdfs:label xml:lang="en">Sampling</rdfs:label>
    <rdfs:label xml:lang="de">Stichprobenziehung</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.2.4.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N630947289b87479c8e1a13531d4c97df">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Nd81df7c6b76e41a3b71af81b9e6f6bd6"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Naab83e7452904b4aabab14200f6d8cb8">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#UnsupervisedLearning"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Characterises the kind of AI employed.</rdfs:comment>
    <rdfs:comment xml:lang="de">Charakterisiert die Art der eingesetzten KI.</rdfs:comment>
    <rdfs:label xml:lang="en">AI Type</rdfs:label>
    <rdfs:label xml:lang="de">KI-Art</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 22989. A collecting class of this model for the two kinds the standard defines separately.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nca7cd44367954ea89a2be85290c1248c">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#MachineLearning"/>
    <rdf:rest rdf:nodeID="N3d11106cc0c8404e9dcb636fb085df41"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Edge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
    <rdfs:comment xml:lang="en">An AI system running close to the process it serves.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ein KI-System, das prozessnah ausgeführt wird.</rdfs:comment>
    <rdfs:label xml:lang="de">Edge</rdfs:label>
    <rdfs:label xml:lang="en">Edge</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#UnsupervisedLearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
    <rdfs:comment xml:lang="en">Machine learning using unlabelled data only during training.</rdfs:comment>
    <rdfs:comment xml:lang="de">Maschinelles Lernen, das während des Trainings ausschließlich nicht gekennzeichnete Daten verwendet.</rdfs:comment>
    <rdfs:label xml:lang="en">Unsupervised Learning</rdfs:label>
    <rdfs:label xml:lang="de">Unüberwachtes Lernen</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 22989, definition 3.3.17.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nec6a9117304e4910b2d50832895a0234">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Accuracy"/>
    <rdf:rest rdf:nodeID="N1490352998bb4dd0ae8f52b1d9d56a92"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncfc8936c0b0f44c58ac7dbeaa6a985ed">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso22989#Filtering"/>
    <rdf:rest rdf:nodeID="N169a6111d447413bb4e318eebbdf8d41"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb97e4b6e60545e2b9e20d5b2e4e25c5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N695736e37c2148d0898bb9ab21ca3a59"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf6d3651681d14500a36f640d1a259bb5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N37799eb49b354cf795a59d6f559a7af2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#hasDesign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
    <rdfs:comment xml:lang="en">Relates an AI system to where it runs.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet ein KI-System mit dem Ort seiner Ausführung.</rdfs:comment>
    <rdfs:label xml:lang="en">has design</rdfs:label>
    <rdfs:label xml:lang="de">hat Auslegung</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Accuracy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationMetric"/>
    <rdfs:comment xml:lang="de">Anteil der korrekten Ergebnisse an allen Ergebnissen.</rdfs:comment>
    <rdfs:comment xml:lang="en">The proportion of correct results among all results.</rdfs:comment>
    <rdfs:label xml:lang="en">Accuracy</rdfs:label>
    <rdfs:label xml:lang="de">Genauigkeit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#basedOnAlgorithm">
