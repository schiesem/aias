    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Availability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Availability">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The property of being accessible and usable on demand by an authorized entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Availability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.3, taken from ISO/IEC 27000:2018. The IEC 60050-351 pattern deliberately leaves availability out, since that standard defines no such entry, so a model needing it in a control context takes it from here.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Bias -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Bias">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">A systematic difference in treatment of certain objects, people or groups in comparison to others.</rdfs:comment>
        <rdfs:label xml:lang="en">Bias</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.4. A quality a model states a measured value for, so that the value can be compared across versions of a system.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Explainability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Explainability">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The property of an AI system to express important factors influencing its results in a way that humans can understand.</rdfs:comment>
        <rdfs:label xml:lang="en">Explainability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.7. Note 1 to the entry states that it is about the reasons for a result rather than about the internals of the system.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Performance -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Performance">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">A measurable result.</rdfs:comment>
        <rdfs:label xml:lang="en">Performance</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.25. Note 1 to the entry states that performance can relate to quantitative or qualitative findings, which is why the pattern prescribes no scale for it.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Predictability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Predictability">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The property of an AI system that enables reliable assumptions by stakeholders about its outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Predictability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.8. Not the same as prediction, 3.1.27: this is about what stakeholders can assume of the system, not about what the system computes.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Reliability -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Reliability">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The property of consistent intended behaviour and results.</rdfs:comment>
        <rdfs:label xml:lang="en">Reliability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.9, taken from ISO/IEC 27000:2018.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Resilience -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Resilience">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The ability of a system to recover operational condition quickly following an incident.</rdfs:comment>
        <rdfs:label xml:lang="en">Resilience</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.10. Recovery after a fault, as against robustness, which is holding up during one.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Robustness -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Robustness">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The ability of a system to maintain its level of performance under any circumstances.</rdfs:comment>
        <rdfs:label xml:lang="en">Robustness</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.12. The quality an AI system in an automated plant is usually held to, since the circumstances there are not the ones it was trained under.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989/instances#Trustworthiness -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989/instances#Trustworthiness">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">The ability to meet stakeholder expectations in a verifiable way.</rdfs:comment>
        <rdfs:label xml:lang="en">Trustworthiness</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.16. The entry that clause 5.15 treats as the sum of the qualities above rather than as one alongside them.</skos:note>
    </owl:NamedIndividual>
    


