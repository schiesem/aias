#################################################################

###  https://w3id.org/aias/odp/iso22989#VariableCharacteristic
<https://w3id.org/aias/odp/iso22989#VariableCharacteristic> rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/aias/odp/iso22989/instances#Availability
:Availability rdf:type owl:NamedIndividual ,
                       <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
              rdfs:comment "The property of being accessible and usable on demand by an authorized entity."@en ;
              rdfs:label "Availability"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.3, taken from ISO/IEC 27000:2018. The IEC 60050-351 pattern deliberately leaves availability out, since that standard defines no such entry, so a model needing it in a control context takes it from here."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Bias
:Bias rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
      rdfs:comment "A systematic difference in treatment of certain objects, people or groups in comparison to others."@en ;
      rdfs:label "Bias"@en ;
      <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.4. A quality a model states a measured value for, so that the value can be compared across versions of a system."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Explainability
:Explainability rdf:type owl:NamedIndividual ,
                         <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
                rdfs:comment "The property of an AI system to express important factors influencing its results in a way that humans can understand."@en ;
                rdfs:label "Explainability"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.7. Note 1 to the entry states that it is about the reasons for a result rather than about the internals of the system."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Performance
:Performance rdf:type owl:NamedIndividual ,
                      <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
             rdfs:comment "A measurable result."@en ;
             rdfs:label "Performance"@en ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.1.25. Note 1 to the entry states that performance can relate to quantitative or qualitative findings, which is why the pattern prescribes no scale for it."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Predictability
:Predictability rdf:type owl:NamedIndividual ,
                         <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
                rdfs:comment "The property of an AI system that enables reliable assumptions by stakeholders about its outputs."@en ;
                rdfs:label "Predictability"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.8. Not the same as prediction, 3.1.27: this is about what stakeholders can assume of the system, not about what the system computes."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Reliability
:Reliability rdf:type owl:NamedIndividual ,
                      <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
             rdfs:comment "The property of consistent intended behaviour and results."@en ;
             rdfs:label "Reliability"@en ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.9, taken from ISO/IEC 27000:2018."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Resilience
:Resilience rdf:type owl:NamedIndividual ,
                     <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
            rdfs:comment "The ability of a system to recover operational condition quickly following an incident."@en ;
            rdfs:label "Resilience"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.10. Recovery after a fault, as against robustness, which is holding up during one."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Robustness
:Robustness rdf:type owl:NamedIndividual ,
                     <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
            rdfs:comment "The ability of a system to maintain its level of performance under any circumstances."@en ;
            rdfs:label "Robustness"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.12. The quality an AI system in an automated plant is usually held to, since the circumstances there are not the ones it was trained under."@en .


###  https://w3id.org/aias/odp/iso22989/instances#Trustworthiness
:Trustworthiness rdf:type owl:NamedIndividual ,
                          <https://w3id.org/aias/odp/iso22989#VariableCharacteristic> ;
                 rdfs:comment "The ability to meet stakeholder expectations in a verifiable way."@en ;
                 rdfs:label "Trustworthiness"@en ;
                 <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 22989, 3.5.16. The entry that clause 5.15 treats as the sum of the qualities above rather than as one alongside them."@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Availability
                        :Bias
                        :Explainability
                        :Performance
                        :Predictability
                        :Reliability
                        :Resilience
                        :Robustness
                        :Trustworthiness
                      )
] .


