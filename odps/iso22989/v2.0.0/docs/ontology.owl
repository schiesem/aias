    <!-- https://w3id.org/aias/odp/iso22989#Cloud -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989#Cloud">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
        <rdfs:comment xml:lang="en">An AI system running on remote infrastructure, away from the process it serves.</rdfs:comment>
        <rdfs:label xml:lang="en">Cloud</rdfs:label>
        <skos:note xml:lang="en">Discussed in ISO/IEC 22989, clause 8.6.2, without an entry.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989#Edge -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989#Edge">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
        <rdfs:comment xml:lang="en">An AI system running near the process it serves, on local devices.</rdfs:comment>
        <rdfs:label xml:lang="en">Edge</rdfs:label>
        <skos:note xml:lang="en">Discussed in ISO/IEC 22989, clause 8.6.2, without an entry.</skos:note>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/aias/odp/iso22989#Hybrid -->


    <owl:NamedIndividual rdf:about="https://w3id.org/aias/odp/iso22989#Hybrid">
        <rdf:type rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
        <rdfs:comment xml:lang="en">An AI system split between local devices and remote infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Hybrid</rdfs:label>
        <skos:note xml:lang="en">The combination of the two above. A system whose components run in different places is recorded this way.</skos:note>
    </owl:NamedIndividual>
    


