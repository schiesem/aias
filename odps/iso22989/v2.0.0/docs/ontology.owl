    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iso22989#basedOnAlgorithm -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#basedOnAlgorithm">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIFunction"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Model"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <rdfs:comment xml:lang="en">Relates a model to the algorithm describing its structure, or a function to the algorithm it executes.</rdfs:comment>
        <rdfs:label xml:lang="en">based on algorithm</rdfs:label>
        <skos:note xml:lang="en">The relation separating the procedure from its execution. A training is based on a training algorithm, a model on a model algorithm, and an evaluation on an evaluation algorithm.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#basedOnLearning -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#basedOnLearning">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#MLAlgorithm"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
        <rdfs:comment xml:lang="en">Relates a machine learning algorithm to the kind of learning it performs.</rdfs:comment>
        <rdfs:label xml:lang="en">based on learning</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.9 to 3.3.17. Functional: an algorithm performs one kind of learning.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#consistsOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#consistsOf">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIComponent"/>
        <rdfs:comment xml:lang="en">Relates an AI system to a component constructing it.</rdfs:comment>
        <rdfs:label xml:lang="en">consists of</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.2 defines the component as a functional element constructing an AI system.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#consistsOfStep -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#consistsOfStep">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcessing"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">Relates a data processing function to the steps it is made of.</rdfs:comment>
        <rdfs:label xml:lang="en">consists of step</rdfs:label>
        <skos:note xml:lang="en">The step from the function to what it actually does, so that a model can record an order of preparation rather than one opaque activity.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#creates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#creates">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Inference"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Prediction"/>
        <rdfs:comment xml:lang="en">Relates an inference to the prediction it produces.</rdfs:comment>
        <rdfs:label xml:lang="en">creates</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.27 defines the prediction as the primary output of an AI system when provided with input data.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#determines -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#determines">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#ModelParameter"/>
        <rdfs:comment xml:lang="en">Relates a training to the model parameters it determines.</rdfs:comment>
        <rdfs:label xml:lang="en">determines</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.15 defines training as the process determining or improving the parameters. This relation is that determining, and it is what turns an algorithm into a model.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#forCharacteristic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#forCharacteristic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">Relates a characteristic value to the characteristic it quantifies.</rdfs:comment>
        <rdfs:label xml:lang="en">for characteristic</rdfs:label>
        <skos:note xml:lang="en">Functional: one value quantifies exactly one characteristic.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#fulfilsTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#fulfilsTask">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Prediction"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">Relates a prediction to the task it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">fulfils task</rdfs:label>
        <skos:note xml:lang="en">What closes the circle from the output back to the objective the system was built for, 3.1.4.

Functional: one prediction addresses one task. A prediction serving two purposes is two predictions.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasCharacteristicValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasCharacteristicValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AISystem"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Model"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <rdfs:comment xml:lang="en">Relates an AI system, a component or a model to a value it states for one of its characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">has characteristic value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasControllability -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasControllability">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Controllability"/>
        <rdfs:comment xml:lang="en">Relates an AI system to a recorded way for an external agent to intervene in its functioning.</rdfs:comment>
        <rdfs:label xml:lang="en">has controllability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.6. Recorded as a relation to a thing rather than as a value, since what matters is what the intervention consists of.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasDataSink -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasDataSink">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Storing"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataSink"/>
        <rdfs:comment xml:lang="en">Relates a storing to where the data goes.</rdfs:comment>
        <rdfs:label xml:lang="en">has data sink</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work**, after ISO/IEC 22989, clause 8.6.1.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasDataSource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasDataSource">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Acquisition"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataSource"/>
        <rdfs:comment xml:lang="en">Relates an acquisition to where the data comes from.</rdfs:comment>
        <rdfs:label xml:lang="en">has data source</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work**, after ISO/IEC 22989, clause 8.6.1. One of the two relations reaching outside the AI system.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasDesign -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasDesign">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#SystemDesign"/>
        <rdfs:comment xml:lang="en">Relates an AI system to where it runs.</rdfs:comment>
        <rdfs:label xml:lang="en">has design</rdfs:label>
        <skos:note xml:lang="en">Functional: a system has one design, and a system split between two places is recorded as hybrid rather than as both.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasFunction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasFunction">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AISystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">Relates an AI system or a component to a function it performs.</rdfs:comment>
        <rdfs:label xml:lang="en">has function</rdfs:label>
        <skos:note xml:lang="en">The step from what a system is to what it does. Where a system has components, the functions are related to those rather than to the system, so that two components performing the same kind of function stay apart.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasHyperparameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasHyperparameter">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Hyperparameter"/>
        <rdfs:comment xml:lang="en">Relates an algorithm to a characteristic chosen in advance that affects its behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">has hyperparameter</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.4. Placed on the algorithm superclass, so a model algorithm and an evaluation algorithm may carry one as well.

Not functional. An algorithm carries as many hyperparameters as it was set up with, and the value of each is reached from the hyperparameter by hasSetting.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasLabel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasLabel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Data"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Sample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Label"/>
        <rdfs:comment xml:lang="en">Relates a sample or a dataset to the label assigned to it.</rdfs:comment>
        <rdfs:label xml:lang="en">has label</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.10. Whether data carries labels is what separates supervised learning, 3.3.12, from unsupervised learning, 3.3.17.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasParameter">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#ModelParameter"/>
        <rdfs:comment xml:lang="en">Relates a model to an internal variable affecting how it computes its outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">has parameter</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.8. Only a learned model has these, which is why a symbolic model carries hyperparameters instead.

The name leads to the model parameter, 3.3.8, and not to the hyperparameter, 3.3.4. The two entries are close enough in wording that the distinction is worth stating: this one is determined by a training, the other is chosen before it.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasRisk -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasRisk">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Risk"/>
        <rdfs:comment xml:lang="en">Relates an AI system to a risk recorded for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.11, and clause 6.2.2, which asks stakeholders to assess risks across the whole life cycle.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasSetting -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasSetting">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Hyperparameter"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <rdfs:comment xml:lang="en">Relates a hyperparameter to the value chosen for it.</rdfs:comment>
        <rdfs:label xml:lang="en">has setting</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.4 defines the hyperparameter as selected prior to training. Its value is therefore set rather than measured, and it is reached by a relation of its own rather than through forCharacteristic.

Both relations end at the same class, and the direction they run in is what keeps them apart. A characteristic value points to the quality it quantifies, and a hyperparameter points to the value it was given. A model can then be asked which of its values were stated and which were established, which is the first question an audit of a training asks.

Functional: a hyperparameter carries one value. Two runs at different learning rates are two hyperparameter individuals rather than one with two values, since the value belongs to the run and not to the name.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasTask">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">Relates an AI system to a task it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">has task</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.35. A system may address more than one task, which is why this is not functional.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#hasType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#hasType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AIComponent"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#AISystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
        <rdfs:comment xml:lang="en">Relates an AI system or a component to the kind of technique it is based on.</rdfs:comment>
        <rdfs:label xml:lang="en">has type</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.33 and 3.1.34.

Deliberately not functional. Clause 5.9 discusses combining the two approaches, so a system may carry both.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isAcquiredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isAcquiredBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Acquisition"/>
        <rdfs:comment xml:lang="en">Relates data to the acquisition that obtained it.</rdfs:comment>
        <rdfs:label xml:lang="en">is acquired by</rdfs:label>
        <skos:note xml:lang="en">What makes the origin of data traceable. Data without one is data a model cannot account for.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isComposedOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isComposedOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Data"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#DataSet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Data"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Sample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Relates a dataset to the data it groups, or data to the samples it consists of.</rdfs:comment>
        <rdfs:label xml:lang="en">is composed of</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.5 and 3.2.13. One relation for both levels, since the standard describes a grouping in each case.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isCreatedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isCreatedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#MLModel"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
        <rdfs:comment xml:lang="en">Relates a machine learning model to the training that produced it.</rdfs:comment>
        <rdfs:label xml:lang="en">is created by</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.14 calls the result of training a trained model. An empty answer for a model means it was not learned.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isEvaluatedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isEvaluatedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Evaluation"/>
        <rdfs:comment xml:lang="en">Relates a model to an evaluation performed on it.</rdfs:comment>
        <rdfs:label xml:lang="en">is evaluated by</rdfs:label>
        <skos:note xml:lang="en">The counterpart of isValidatedBy, for the assessment of a final model before deployment.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isExecutedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isExecutedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Inference"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">Relates an inference to the model performing it.</rdfs:comment>
        <rdfs:label xml:lang="en">is executed by</rdfs:label>
        <skos:note xml:lang="en">Both kinds of model execute inferences: 3.1.17 states that a premise is either a fact, a rule, a model, a feature or raw data.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isProcessedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isProcessedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">Relates data to a data process step applied to it.</rdfs:comment>
        <rdfs:label xml:lang="en">is processed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isStoredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isStoredBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Storing"/>
        <rdfs:comment xml:lang="en">Relates data to the storing that persisted it.</rdfs:comment>
        <rdfs:label xml:lang="en">is stored by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#isValidatedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#isValidatedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Validation"/>
        <rdfs:comment xml:lang="en">Relates a model to a validation performed on it.</rdfs:comment>
        <rdfs:label xml:lang="en">is validated by</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.18.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#performedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#performedBy">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#AIComponent"/>
        <rdfs:comment xml:lang="en">Relates a function to the component performing it.</rdfs:comment>
        <rdfs:label xml:lang="en">performed by</rdfs:label>
        <skos:note xml:lang="en">The inverse reading of hasFunction, stated separately so a model may record either direction.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#realisedByModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#realisedByModel">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AIComponent"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">Relates a component to the model carrying its behaviour.</rdfs:comment>
        <rdfs:label xml:lang="en">realised by model</rdfs:label>
        <skos:note xml:lang="en">The step from the structural element to what makes it work. A component without a model performs functions but decides nothing.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#usesData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#usesData">
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Relates a function to the data it works on.</rdfs:comment>
        <rdfs:label xml:lang="en">uses data</rdfs:label>
        <skos:note xml:lang="en">Which kind of data belongs to which function follows from the entries: 3.3.16 for training, 3.2.15 for validation, 3.2.14 for evaluation and 3.2.12 for inference in operation.</skos:note>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#usesMetric -->


    <owl:ObjectProperty rdf:about="https://w3id.org/aias/odp/iso22989#usesMetric">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#Evaluation"/>
                    <rdf:Description rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationAlgorithm"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso22989#EvaluationMetric"/>
        <rdfs:comment xml:lang="en">Relates an evaluation or an evaluation algorithm to the metric it measures against.</rdfs:comment>
        <rdfs:label xml:lang="en">uses metric</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** The standard describes evaluation without naming the measure it uses.</skos:note>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iso22989#isLabelled -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iso22989#isLabelled">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the samples of a dataset carry labels.</rdfs:comment>
        <rdfs:label xml:lang="en">is labelled</rdfs:label>
        <skos:note xml:lang="en">The property 3.3.12 and 3.3.17 turn on. Stated on the data rather than derived from the presence of labels, so that a model can record the intent before the labels exist.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#quantity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iso22989#quantity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The numeric quantity of a characteristic value.</rdfs:comment>
        <rdfs:label xml:lang="en">quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/aias/odp/iso22989#unit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/aias/odp/iso22989#unit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unit of a characteristic value, where the characteristic has one.</rdfs:comment>
        <rdfs:label xml:lang="en">unit</rdfs:label>
        <skos:note xml:lang="en">A literal rather than a reference to a unit ontology, so that the pattern stays free of further imports. Several qualities are dimensionless, in which case a model leaves this out.</skos:note>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/aias/odp/iso22989#AIComponent -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#AIComponent">
        <rdfs:comment xml:lang="en">A functional element that constructs an AI system.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Component</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.2.

The class is what a model needs as soon as one system carries more than one approach. A system combining a learned classifier with a rule-based decision has two components, each performing its own functions, and without them the two would be indistinguishable.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#AIFunction -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#AIFunction">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#AISystem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">An activity in the life cycle of an AI system, transforming inputs into outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Function</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard describes the activities in clause 5.10 and clause 6.2 without naming a superclass for them.

Note that clause 8.3 of the standard uses the term AI function in a narrower sense, for computing a prediction alone. This class is broader on purpose, since a model has to record the whole life cycle rather than the operating step only.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#AISystem -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#AISystem">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#CharacteristicValue"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#VariableCharacteristic"/>
        <rdfs:comment xml:lang="en">An engineered system that generates outputs such as content, forecasts, recommendations or decisions for a given set of human-defined objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">AI System</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.4. The entry adds that the system can use various techniques and approaches to develop a model representing data, knowledge or processes.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#AIType -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#AIType">
        <rdfs:comment xml:lang="en">The kind of technique an AI system is based on, that is symbolic or subsymbolic.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Type</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines symbolic AI, 3.1.33, and subsymbolic AI, 3.1.34, and compares them in clause 5.9, but names no common superclass for the two.

The two kinds are deliberately **not** disjoint. Neither entry excludes the other, and clause 5.9 discusses combining them, so a system may be typed as both.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Acquisition -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Acquisition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">The function obtaining data from a data source.</rdfs:comment>
        <rdfs:label xml:lang="en">Acquisition</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** Discussed in ISO/IEC 22989, clause 8.6.1, without an entry. One of the two functions reaching outside the AI system, which makes it a handover point to whatever supplies the data.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Algorithm -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Algorithm">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">A parameterisable mathematical procedure, described apart from any execution of it.</rdfs:comment>
        <rdfs:label xml:lang="en">Algorithm</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** ISO/IEC 22989 defines the machine learning algorithm, 3.3.6, but no general algorithm and no superclass for the kinds below.

The class exists so that the hyperparameter, 3.3.4, has one place to attach to. The standard defines the hyperparameter for the machine learning algorithm, whereas a model algorithm and an evaluation algorithm carry one as well, for example the number of layers of a network or the threshold of a metric.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Annotation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Annotation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">The process of attaching a set of descriptive information to data without any change to that data.</rdfs:comment>
        <rdfs:label xml:lang="en">Annotation</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.1.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Augmentation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Augmentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">The process of creating synthetic samples by modifying or utilizing the existing data.</rdfs:comment>
        <rdfs:label xml:lang="en">Augmentation</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.3.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#CharacteristicValue -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#CharacteristicValue">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">The value a model assigns to one characteristic, together with its unit.</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic Value</rdfs:label>
        <skos:note xml:lang="en">Reified so that a value can be referred to and annotated with its source or the conditions it holds under, in the same arrangement and for the same reason as the characteristic value of the IEC 60050-351 pattern.

Two relations end here and they run in opposite directions. A value points to the quality it quantifies through forCharacteristic, and a hyperparameter points to the value it was given through hasSetting. What separates them is where the value comes from: the first is established, the second is chosen.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Classification -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Classification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">A task assigning inputs to discrete classes.</rdfs:comment>
        <rdfs:label xml:lang="en">Classification</rdfs:label>
        <skos:note xml:lang="en">Named in note 2 to ISO/IEC 22989, 3.1.35, and discussed in clause 9, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Clustering -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Clustering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">A task identifying groups of similar samples.</rdfs:comment>
        <rdfs:label xml:lang="en">Clustering</rdfs:label>
        <skos:note xml:lang="en">Named in note 2 to ISO/IEC 22989, 3.1.35, and discussed in clause 5.11.2, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Control -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Control">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">Purposeful action on or in a process to meet specified objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Control</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.5, which takes the definition from IEC 61800-7-1:2015, 3.2.6.

Modelled as a function alongside training, inference and the rest. The entry sits in clause 3.5 among the terms related to trustworthiness, but that is a grouping by subject rather than a statement about the kind of term: the definition says action, which is what the other functions are as well. A system therefore relates to it through hasFunction like any other activity.

**The wording is identical to IEC 60050-351, 351-42-19**, and both trace back to the same source. The two are the same concept rather than merely similar ones, and the alignment relates them with owl:equivalentClass. This pattern states nothing about the other, since referencing another namespace would drag it along wherever this pattern is used.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Controllability -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Controllability">
        <rdfs:comment xml:lang="en">The property of an AI system that allows a human or another external agent to intervene in the system&apos;s functioning.</rdfs:comment>
        <rdfs:label xml:lang="en">Controllability</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.6.

Modelled as a class rather than as a named quality because a model states what the intervention consists of, not a number. It is the entry that matters most for an AI system inside an automated plant.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Data -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Data">
        <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">A collection of samples an AI system acquires, processes or computes outputs for.</rdfs:comment>
        <rdfs:label xml:lang="en">Data</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines the dataset, 3.2.5, and the sample, 3.2.13, and grades data by its use, but names no class between the atom and the collection.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#DataProcess -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#DataProcess">
        <rdfs:comment xml:lang="en">A step preparing data, transforming input data into output data.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Process</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines the steps below, 3.2.1 to 3.2.8, and names further ones in clause 5.10, but no common superclass.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#DataProcessing -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#DataProcessing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">The function transforming input data into output data.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Processing</rdfs:label>
        <skos:note xml:lang="en">Described in ISO/IEC 22989, clause 5.10, without an entry of its own. What it consists of is recorded through the data process steps.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#DataSet -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#DataSet">
        <rdfs:comment xml:lang="en">A collection of data with a shared format.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Set</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.5.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#DataSink -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#DataSink">
        <rdfs:comment xml:lang="en">Where data is stored, for example a database or a cloud service.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Sink</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** The counterpart of the data source.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#DataSource -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#DataSource">
        <rdfs:comment xml:lang="en">Where data is acquired from, for example a sensor or a database.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Source</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** Discussed in ISO/IEC 22989, clause 8.6.1, without an entry. One of the two points at which an AI system meets what surrounds it.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Evaluation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Evaluation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">The function assessing the performance of a final model before it is deployed.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** Described in ISO/IEC 22989, clause 5.10 and clause 6.2.8, without an entry. It is what evaluation data, 3.2.14, exists for.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#EvaluationAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationAlgorithm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <rdfs:comment xml:lang="en">The procedure assessing a model against an evaluation metric.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation Algorithm</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** ISO/IEC 22989 describes evaluation in clause 5.10 without naming a procedure for it.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#EvaluationData -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Data used to assess the performance of a final model.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation Data</rdfs:label>
        <skos:altLabel xml:lang="en">test data</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.14, where the entry carries both names, test data and evaluation data.

Note 1 states that it is disjoint from training data and validation data. The pattern asserts that disjointness, since evaluating a model on data it was trained on says nothing about its performance.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#EvaluationMetric -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#EvaluationMetric">
        <rdfs:comment xml:lang="en">What an evaluation measures a model against, for example an F1 score or an error rate.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation Metric</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** The standard discusses evaluation without defining the measure it uses. A concrete metric is recorded as a named individual of this class.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Filtering -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Filtering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">A step removing data that is not to be used further.</rdfs:comment>
        <rdfs:label xml:lang="en">Filtering</rdfs:label>
        <skos:note xml:lang="en">Named in ISO/IEC 22989, clause 5.10, among the preparation steps, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Generation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Generation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">A task producing new outputs, such as text, images or audio, from learned representations.</rdfs:comment>
        <rdfs:label xml:lang="en">Generation</rdfs:label>
        <skos:note xml:lang="en">Discussed in ISO/IEC 22989, clause 9.2, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Hyperparameter -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Hyperparameter">
        <rdfs:comment xml:lang="en">A characteristic of an algorithm that affects its behaviour, chosen in advance rather than determined by training.</rdfs:comment>
        <rdfs:label xml:lang="en">Hyperparameter</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.4, which defines it as a characteristic of a machine learning algorithm affecting its learning process, selected prior to training.

This pattern places it on the algorithm superclass, so that a model algorithm and an evaluation algorithm may carry one as well: the number of layers of a network, or the threshold of a rule. Applying the entry beyond machine learning is a reading of it rather than the entry itself, and a rule threshold recorded here is such a case.

The value chosen for it is reached by hasSetting, not by forCharacteristic. A hyperparameter is set before a training and a quality of clause 3.5 is established by one, and the two relations keep that difference readable.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Imputation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Imputation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">A procedure where missing data are replaced by estimated or modelled data.</rdfs:comment>
        <rdfs:label xml:lang="en">Imputation</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.8.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Inference -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Inference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">Reasoning by which conclusions are derived from known premises.</rdfs:comment>
        <rdfs:label xml:lang="en">Inference</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.17. Note 1 to the entry states that in AI a premise is either a fact, a rule, a model, a feature or raw data, which is why both a symbolic and a subsymbolic system perform inference.

Note 2 adds that the term refers both to the process and its result. This pattern uses it for the process and records the result as a prediction, 3.1.27.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#InputData -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#InputData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Data for which an AI system calculates a predicted output or inference.</rdfs:comment>
        <rdfs:label xml:lang="en">Input Data</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.9. What an inference runs on, whatever its use elsewhere in the life cycle.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Label -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Label">
        <rdfs:comment xml:lang="en">A target variable assigned to a sample.</rdfs:comment>
        <rdfs:label xml:lang="en">Label</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.10. Whether data carries labels is what 3.3.12 and 3.3.17 turn on.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Labelling -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Labelling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">A step assigning labels to samples.</rdfs:comment>
        <rdfs:label xml:lang="en">Labelling</rdfs:label>
        <skos:note xml:lang="en">Named in ISO/IEC 22989, clause 5.10, without an entry of its own. The step that produces what 3.2.10 defines and what supervised learning, 3.3.12, requires.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#LearningType -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#LearningType">
        <rdfs:comment xml:lang="en">The kind of machine learning an algorithm performs.</rdfs:comment>
        <rdfs:label xml:lang="en">Learning Type</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines the four kinds below, 3.3.9, 3.3.11, 3.3.12 and 3.3.17, and discusses them in clause 5.11, but names no common superclass.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#MLAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#MLAlgorithm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#TrainingAlgorithm"/>
        <rdfs:comment xml:lang="en">An algorithm to determine parameters of a machine learning model from data according to given criteria.</rdfs:comment>
        <rdfs:label xml:lang="en">Machine Learning Algorithm</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.6. The only algorithm the standard defines. What kind of learning it performs is recorded through basedOnLearning.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#MLModel -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#MLModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Model"/>
        <rdfs:comment xml:lang="en">A mathematical construct that generates an inference or prediction based on input data or information.</rdfs:comment>
        <rdfs:label xml:lang="en">Machine Learning Model</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.7. 3.3.14 calls the result of training a trained model.

Kept below the general model on purpose. Every machine learning model is a model, but a model is not necessarily learned, and a pattern that knew only this class could not record a symbolic system at all.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#MachineLearning -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#MachineLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
        <rdfs:comment xml:lang="en">The process of optimizing model parameters through computational techniques, such that the model&apos;s behaviour reflects the data or experience.</rdfs:comment>
        <rdfs:label xml:lang="en">Machine Learning</rdfs:label>
        <skos:altLabel xml:lang="en">ML</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.5.

Modelled as a subclass of training rather than as a separate class: it is the case of training in which the parameters are optimised computationally. A symbolic system has a model without any training at all.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Model -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Model">
        <rdfs:comment xml:lang="en">A physical, mathematical or otherwise logical representation of a system, entity, phenomenon, process or data.</rdfs:comment>
        <rdfs:label xml:lang="en">Model</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.23.

Both kinds of AI rest on models: 3.1.33 and 3.1.34 each reference this entry rather than the machine learning one. A rule-based system therefore instantiates this class and nothing below it.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#ModelAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#ModelAlgorithm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <rdfs:comment xml:lang="en">The procedure describing the structure of a model, such as the architecture of a neural network or a set of rules.</rdfs:comment>
        <rdfs:label xml:lang="en">Model Algorithm</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work**, derived from ISO/IEC 22989, 3.1.23 and 3.3.7.

It is what a model is before its parameters are known. The distinction matters because the same architecture trained on different data yields different models, and a model records which of the two it is talking about.

A concrete architecture is recorded as a named individual of this class rather than as a subclass, which keeps the pattern independent of libraries and methods.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#ModelParameter -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#ModelParameter">
        <rdfs:comment xml:lang="en">An internal variable of a model that affects how it computes its outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Model Parameter</rdfs:label>
        <skos:altLabel xml:lang="en">parameter</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.8. Note 1 to the entry names the weights in a neural network as an example.

Determined by training, which is what separates it from the hyperparameter below.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Normalization -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Normalization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">A step bringing data onto a common scale.</rdfs:comment>
        <rdfs:label xml:lang="en">Normalization</rdfs:label>
        <skos:note xml:lang="en">Named in ISO/IEC 22989, clause 5.10, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Prediction -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Prediction">
        <rdfs:comment xml:lang="en">The primary output of an AI system when provided with input data or information.</rdfs:comment>
        <rdfs:label xml:lang="en">Prediction</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.27.

Note 2 to the entry states that prediction does not necessarily refer to predicting something in the future, and note 1 that predictions can be followed by further outputs such as recommendations, decisions and actions.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#ProductionData -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#ProductionData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Data acquired during the operation phase of an AI system, for which a deployed system calculates a predicted output or inference.</rdfs:comment>
        <rdfs:label xml:lang="en">Production Data</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.12.

Not part of the disjointness above. It arises during operation, so it cannot overlap with data that existed before deployment.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Regression -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Regression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Task"/>
        <rdfs:comment xml:lang="en">A task predicting continuous quantities.</rdfs:comment>
        <rdfs:label xml:lang="en">Regression</rdfs:label>
        <skos:note xml:lang="en">Named in note 2 to ISO/IEC 22989, 3.1.35, without an entry of its own.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#ReinforcementLearning -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#ReinforcementLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
        <rdfs:comment xml:lang="en">Learning of an optimal sequence of actions to maximize a reward through interaction with an environment.</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforcement Learning</rdfs:label>
        <skos:altLabel xml:lang="en">RL</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.9. The only one of the four that does not turn on whether the data is labelled, since it learns from interaction rather than from a dataset.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Retraining -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Retraining">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Training"/>
        <rdfs:comment xml:lang="en">Updating a trained model by training with different training data.</rdfs:comment>
        <rdfs:label xml:lang="en">Retraining</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.10. A model that records it can tell a deployed model from the one it replaced, which is what clause 6.2.7 and 6.2.8 ask for.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Risk -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Risk">
        <rdfs:comment xml:lang="en">The effect of uncertainty on objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.11. Clause 6.2.2 asks stakeholders to assess risks across the whole life cycle, and this class is where a model records the result.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Sample -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Sample">
        <rdfs:comment xml:lang="en">An atomic data element processed in quantities by a machine learning algorithm or an AI system.</rdfs:comment>
        <rdfs:label xml:lang="en">Sample</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.13.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Sampling -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Sampling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#DataProcess"/>
        <rdfs:comment xml:lang="en">The process to select a subset of data samples intended to present patterns and trends similar to that of the larger dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">Sampling</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.4.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#SemiSupervisedLearning -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#SemiSupervisedLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
        <rdfs:comment xml:lang="en">Machine learning that makes use of both labelled and unlabelled data during training.</rdfs:comment>
        <rdfs:label xml:lang="en">Semi-supervised Machine Learning</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.11.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Storing -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Storing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">The function persisting data to a data sink, so that it stays available.</rdfs:comment>
        <rdfs:label xml:lang="en">Storing</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** Discussed in ISO/IEC 22989, clause 8.6.1, without an entry. The counterpart of acquisition, and the second function reaching outside the system.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#SubsymbolicAI -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#SubsymbolicAI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
        <rdfs:comment xml:lang="en">AI based on techniques and models that use an implicit encoding of information, that can be derived from experience or raw data.</rdfs:comment>
        <rdfs:label xml:lang="en">Subsymbolic AI</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.34.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#SupervisedLearning -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#SupervisedLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
        <rdfs:comment xml:lang="en">Machine learning that makes only use of labelled data during training.</rdfs:comment>
        <rdfs:label xml:lang="en">Supervised Machine Learning</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.12. Whether the data carries a label, 3.2.10, is what separates this from unsupervised learning.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#SymbolicAI -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#SymbolicAI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIType"/>
        <rdfs:comment xml:lang="en">AI based on techniques and models that manipulate symbols and structures according to explicitly defined rules to obtain inferences.</rdfs:comment>
        <rdfs:label xml:lang="en">Symbolic AI</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.33. Note 1 to the entry adds that symbolic AI produces declarative outputs, whereas subsymbolic AI rests on statistical approaches and produces outputs with a given probability of error.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#SystemDesign -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#SystemDesign">
        <rdfs:comment xml:lang="en">Where an AI system runs, that is on cloud infrastructure, near the process at the edge, or split between the two.</rdfs:comment>
        <rdfs:label xml:lang="en">System Design</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** Clause 8.6.2 of the standard discusses cloud and edge computing without defining the choice between them as a term.

The class is kept because it is what connects an AI system to the plant it runs in: the design says which device carries which part of the system, which is the handover the alignment needs.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Task -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Task">
        <rdfs:comment xml:lang="en">An action required to achieve a specific goal.</rdfs:comment>
        <rdfs:label xml:lang="en">Task</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.1.35. Note 1 to the entry adds that actions can be physical or cognitive, note 2 lists classification, regression, ranking, clustering and dimensionality reduction as examples.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Training -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Training">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">The process to determine or to improve the parameters of a machine learning model, based on a machine learning algorithm, by using training data.</rdfs:comment>
        <rdfs:label xml:lang="en">Training</rdfs:label>
        <skos:altLabel xml:lang="en">model training</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.15.

The entry names all three ingredients: an algorithm, training data and the parameters that come out. A training missing any of them is not one, which is what makes this function the place where the difference between an algorithm and a model arises.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#TrainingAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#TrainingAlgorithm">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Algorithm"/>
        <rdfs:comment xml:lang="en">The procedure determining the parameters of a model from data according to given criteria.</rdfs:comment>
        <rdfs:label xml:lang="en">Training Algorithm</rdfs:label>
        <skos:note xml:lang="en">**Construct of this work.** ISO/IEC 22989, 3.3.6 defines the machine learning case of it, which this pattern carries as the subclass below.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#TrainingData -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#TrainingData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Data used to train a machine learning model.</rdfs:comment>
        <rdfs:label xml:lang="en">Training Data</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.16.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#UnsupervisedLearning -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#UnsupervisedLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#LearningType"/>
        <rdfs:comment xml:lang="en">Machine learning that makes only use of unlabelled data during training.</rdfs:comment>
        <rdfs:label xml:lang="en">Unsupervised Machine Learning</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.3.17.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Validation -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Validation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">Confirmation, through the provision of objective evidence, that the requirements for a specific intended use or application have been fulfilled.</rdfs:comment>
        <rdfs:label xml:lang="en">Validation</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.18. Clause 6.2.4 treats validation together with verification as one stage of the life cycle. Validation asks whether the right system was built, verification whether the system was built right.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#ValidationData -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#ValidationData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#Data"/>
        <rdfs:comment xml:lang="en">Data used to compare the performance of different candidate models.</rdfs:comment>
        <rdfs:label xml:lang="en">Validation Data</rdfs:label>
        <skos:altLabel xml:lang="en">development data</skos:altLabel>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.2.15. Note 1 to the entry states that validation data is disjoint from test data and generally also from training data.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#VariableCharacteristic -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#VariableCharacteristic">
        <rdfs:comment xml:lang="en">A named property of an AI system to which a model assigns a value, such as robustness or reliability.</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic</rdfs:label>
        <skos:note xml:lang="en">**Collecting class of this pattern.** The standard defines the qualities of clause 3.5 without naming what they have in common. Named individuals are supplied in ISO22989-instances.ttl.</skos:note>
    </owl:Class>
    


    <!-- https://w3id.org/aias/odp/iso22989#Verification -->


    <owl:Class rdf:about="https://w3id.org/aias/odp/iso22989#Verification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso22989#AIFunction"/>
        <rdfs:comment xml:lang="en">Confirmation, through the provision of objective evidence, that specified requirements have been fulfilled.</rdfs:comment>
        <rdfs:label xml:lang="en">Verification</rdfs:label>
        <skos:note xml:lang="en">ISO/IEC 22989, 3.5.17. See the note on validation for the difference between the two.</skos:note>
    </owl:Class>
    


