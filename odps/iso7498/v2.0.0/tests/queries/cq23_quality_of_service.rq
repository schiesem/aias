# CQ 23: Which quality of service is stated for a communication?
#
# ISO/IEC 7498-1, 5.10 and 7.4.4. The value is reified, so it carries its
# parameter, its quantity and its unit.
PREFIX iso7498: <https://w3id.org/aias/odp/iso7498#>
PREFIX inst: <https://w3id.org/aias/odp/iso7498/instances#>
SELECT ?communication ?parameter ?quantity ?unit WHERE {
  ?communication iso7498:hasQualityOfService ?qos .
  ?qos iso7498:hasValue ?v .
  ?v iso7498:forParameter ?p ; iso7498:quantity ?quantity ; iso7498:unit ?unit .
  BIND(REPLACE(STR(?p), ".*#", "") AS ?parameter)
} ORDER BY ?communication ?parameter
