@prefix iso7498: <https://w3id.org/aias/odp/iso7498#> .
@prefix inst:    <https://w3id.org/aias/odp/iso7498/instances#> .
@prefix ex:      <https://w3id.org/aias/example/iso7498/tc2#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Test case 2: the same communication refined to level 2.
#
# After ISO/IEC 7498-1, Figures 9 and 11. Test case 1 with the architecture of
# clause 5 filled in for the three lower layers, which is what a model does
# when the detail is needed.
#
# Only layers 2 to 4 are refined. The standard requires no model to elaborate
# all seven, and leaving the rest at level 1 shows that the two levels coexist:
# the communication of test case 1 remains valid alongside the detail.

<https://w3id.org/aias/example/iso7498/tc2>
    a owl:Ontology ;
    rdfs:label "ISO 7498 test case 2: communication refined to level 2"@en ;
    rdfs:comment "Subsystems, entities, service access points and the encapsulation of Figure 9, after ISO/IEC 7498-1, clause 5."@en ;
    owl:imports <https://w3id.org/aias/odp/iso7498/instances/2.0.0> .

#################################################################
#    Open systems, as in test case 1
#################################################################

ex:SystemA a iso7498:OpenSystem ; rdfs:label "System A"@en ;
    iso7498:hasSubsystem ex:A_Transport , ex:A_Network , ex:A_DataLink .

ex:SystemB a iso7498:OpenSystem ; rdfs:label "System B"@en ;
    iso7498:hasSubsystem ex:B_Transport , ex:B_Network , ex:B_DataLink .

ex:CommunicationAB
    a iso7498:ConnectionModeAssociation ;
    rdfs:label "Communication A to B"@en ;
    iso7498:hasSourceSystem ex:SystemA ;
    iso7498:hasTargetSystem ex:SystemB ;
    iso7498:hasDirection inst:TwoWayAlternate ;
    iso7498:usesLayer inst:ApplicationLayer ;
    iso7498:usesTechnology inst:MQTT , inst:TCP , inst:IPv4 , inst:Ethernet ;
    iso7498:transmits ex:TransportPDU .

#################################################################
#    Subsystems, one per layer and system, 5.2.2.1
#################################################################

ex:A_Transport a iso7498:Subsystem ; rdfs:label "A transport subsystem"@en ;
    iso7498:atLayer inst:TransportLayer ; iso7498:hasEntity ex:A_TransportEntity .
ex:A_Network   a iso7498:Subsystem ; rdfs:label "A network subsystem"@en ;
    iso7498:atLayer inst:NetworkLayer   ; iso7498:hasEntity ex:A_NetworkEntity .
ex:A_DataLink  a iso7498:Subsystem ; rdfs:label "A data link subsystem"@en ;
    iso7498:atLayer inst:DataLinkLayer  ; iso7498:hasEntity ex:A_DataLinkEntity .

ex:B_Transport a iso7498:Subsystem ; rdfs:label "B transport subsystem"@en ;
    iso7498:atLayer inst:TransportLayer ; iso7498:hasEntity ex:B_TransportEntity .
ex:B_Network   a iso7498:Subsystem ; rdfs:label "B network subsystem"@en ;
    iso7498:atLayer inst:NetworkLayer   ; iso7498:hasEntity ex:B_NetworkEntity .
ex:B_DataLink  a iso7498:Subsystem ; rdfs:label "B data link subsystem"@en ;
    iso7498:atLayer inst:DataLinkLayer  ; iso7498:hasEntity ex:B_DataLinkEntity .

#################################################################
#    Entities and their peers, 5.2.1.3 and 5.2.1.11
#
#    Peer entities are entities within the same layer. The relation is
#    symmetric, so asserting it once suffices.
#################################################################

ex:A_TransportEntity a iso7498:Entity ; rdfs:label "A transport entity"@en ;
    iso7498:atLayer inst:TransportLayer ;
    iso7498:employsProtocol ex:TransportProtocol ;
    iso7498:providesService ex:TransportService ;
    iso7498:peerEntity ex:B_TransportEntity .

ex:A_NetworkEntity a iso7498:Entity ; rdfs:label "A network entity"@en ;
    iso7498:atLayer inst:NetworkLayer ;
    iso7498:providesService ex:NetworkService ;
    iso7498:peerEntity ex:B_NetworkEntity .

ex:A_DataLinkEntity a iso7498:Entity ; rdfs:label "A data link entity"@en ;
    iso7498:atLayer inst:DataLinkLayer ;
    iso7498:providesService ex:DataLinkService ;
    iso7498:peerEntity ex:B_DataLinkEntity .

ex:B_TransportEntity a iso7498:Entity ; rdfs:label "B transport entity"@en ;
    iso7498:atLayer inst:TransportLayer ;
    iso7498:employsProtocol ex:TransportProtocol .

ex:B_NetworkEntity a iso7498:Entity ; rdfs:label "B network entity"@en ;
    iso7498:atLayer inst:NetworkLayer .

ex:B_DataLinkEntity a iso7498:Entity ; rdfs:label "B data link entity"@en ;
    iso7498:atLayer inst:DataLinkLayer .

#################################################################
#    Services and protocols
#################################################################

ex:TransportService a iso7498:Service ; rdfs:label "Transport service"@en ;
    iso7498:atLayer inst:TransportLayer .
ex:NetworkService a iso7498:Service ; rdfs:label "Network service"@en ;
    iso7498:atLayer inst:NetworkLayer .
ex:DataLinkService a iso7498:Service ; rdfs:label "Data link service"@en ;
    iso7498:atLayer inst:DataLinkLayer .

ex:TransportProtocol a iso7498:Protocol ; rdfs:label "Transport protocol"@en ;
    rdfs:comment "The set of rules the two transport entities agree on, 5.8.2.3."@en ;
    iso7498:atLayer inst:TransportLayer .

#################################################################
#    Service access points, 5.5.5 and 5.5.2
#
#    An access point attaches to one entity of its layer and to one entity of
#    the layer above, and both lie in the same system.
#################################################################

ex:A_TransportSAP a iso7498:ServiceAccessPoint ; rdfs:label "A transport SAP"@en ;
    rdfs:comment "Where the transport entity of system A provides its service to the layer above."@en ;
    iso7498:attachedTo ex:A_TransportEntity .

ex:A_NetworkSAP a iso7498:ServiceAccessPoint ; rdfs:label "A network SAP"@en ;
    iso7498:attachedTo ex:A_NetworkEntity , ex:A_TransportEntity .

ex:A_DataLinkSAP a iso7498:ServiceAccessPoint ; rdfs:label "A data link SAP"@en ;
    iso7498:attachedTo ex:A_DataLinkEntity , ex:A_NetworkEntity .

#################################################################
#    Encapsulation, Figure 9
#
#    A protocol data unit of one layer becomes the service data unit of the
#    layer below, which together with that layer's control information forms
#    its protocol data unit. The chain runs from transport down to data link.
#################################################################

ex:TransportPDU a iso7498:ProtocolDataUnit ; rdfs:label "Transport PDU"@en ;
    iso7498:atLayer inst:TransportLayer ;
    iso7498:hasControlInformation ex:TransportPCI ;
    iso7498:hasUserData ex:ApplicationData ;
    iso7498:mapsToServiceDataUnit ex:NetworkSDU .

ex:NetworkSDU a iso7498:ServiceDataUnit ; rdfs:label "Network SDU"@en ;
    rdfs:comment "The transport PDU seen as payload by the network layer."@en ;
    iso7498:atLayer inst:NetworkLayer .

ex:NetworkPDU a iso7498:ProtocolDataUnit ; rdfs:label "Network PDU"@en ;
    iso7498:atLayer inst:NetworkLayer ;
    iso7498:hasControlInformation ex:NetworkPCI ;
    iso7498:mapsToServiceDataUnit ex:DataLinkSDU .

ex:DataLinkSDU a iso7498:ServiceDataUnit ; rdfs:label "Data link SDU"@en ;
    rdfs:comment "The network PDU seen as payload by the data link layer."@en ;
    iso7498:atLayer inst:DataLinkLayer .

ex:DataLinkPDU a iso7498:ProtocolDataUnit ; rdfs:label "Data link PDU"@en ;
    iso7498:atLayer inst:DataLinkLayer ;
    iso7498:hasControlInformation ex:DataLinkPCI .

ex:TransportPCI a iso7498:ProtocolControlInformation ; rdfs:label "Transport PCI"@en ;
    iso7498:atLayer inst:TransportLayer .
ex:NetworkPCI a iso7498:ProtocolControlInformation ; rdfs:label "Network PCI"@en ;
    iso7498:atLayer inst:NetworkLayer .
ex:DataLinkPCI a iso7498:ProtocolControlInformation ; rdfs:label "Data link PCI"@en ;
    iso7498:atLayer inst:DataLinkLayer .

ex:ApplicationData a iso7498:UserData ; rdfs:label "Application data"@en ;
    rdfs:comment "The data transferred on behalf of the layer above, 5.6.1.2."@en ;
    iso7498:atLayer inst:ApplicationLayer .
