<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/aias/odp/iso7498/instances#AMQP
:AMQP rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
      rdfs:comment "Advanced message queuing protocol, after ISO/IEC 19464."@en ;
      rdfs:label "AMQP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer
:ApplicationLayer rdf:type owl:NamedIndividual ,
                           <https://w3id.org/aias/odp/iso7498#Layer> ;
                  <https://w3id.org/aias/odp/iso7498#layerNumber> 7 ;
                  rdfs:comment "The highest layer, providing the sole means for an application process to access the OSI environment. It has no boundary with a higher layer."@en ;
                  rdfs:label "Application Layer"@en ;
                  <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.1.2. Consists of the application entities that cooperate in the OSI environment, 6.1.4."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Availability
:Availability rdf:type owl:NamedIndividual ,
                       <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
              rdfs:comment "The share of time a communication is usable."@en ;
              rdfs:label "Availability"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "Not named in ISO/IEC 7498-1, 7.4.4. Added because engineering models record it."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Bit
:Bit rdf:type owl:NamedIndividual ,
              <https://w3id.org/aias/odp/iso7498#ServiceDataUnit> ;
     <https://w3id.org/aias/odp/iso7498#atLayer> :PhysicalLayer ;
     rdfs:comment "The service data unit of the physical layer."@en ;
     rdfs:label "Bit"@en ;
     <http://www.w3.org/2004/02/skos/core#note> "The one practice term ISO/IEC 7498-1 names: 7.6.4.5 refers to physical service data units, that is bits, and 7.7.3.3.1 to the transparent transmission of bit streams."@en .


###  https://w3id.org/aias/odp/iso7498/instances#CANopen
:CANopen rdf:type owl:NamedIndividual ,
                  <https://w3id.org/aias/odp/iso7498#Technology> ;
         <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
         rdfs:comment "Communication protocol for embedded automation on CAN, after EN 50325-4."@en ;
         rdfs:label "CANopen"@en .


###  https://w3id.org/aias/odp/iso7498/instances#DHCP
:DHCP rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
      rdfs:comment "Dynamic host configuration protocol."@en ;
      rdfs:label "DHCP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer
:DataLinkLayer rdf:type owl:NamedIndividual ,
                        <https://w3id.org/aias/odp/iso7498#Layer> ;
               <https://w3id.org/aias/odp/iso7498#layerNumber> 2 ;
               rdfs:comment "Provides the functional and procedural means for the transfer of data between network entities and detects and possibly corrects errors occurring in the physical layer."@en ;
               rdfs:label "Data Link Layer"@en ;
               <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.6.2."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Datagram
:Datagram rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#ProtocolDataUnit> ;
          <https://w3id.org/aias/odp/iso7498#atLayer> :TransportLayer ;
          rdfs:comment "The protocol data unit of a connectionless-mode transport or network service."@en ;
          rdfs:label "Datagram"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1. Named by the protocol standards of connectionless-mode services."@en .


###  https://w3id.org/aias/odp/iso7498/instances#EstablishmentDelay
:EstablishmentDelay rdf:type owl:NamedIndividual ,
                             <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
                    rdfs:comment "The elapsed time between the request to establish a connection and its confirmation."@en ;
                    rdfs:label "Establishment Delay"@en ;
                    <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.4.4. Applies to connection-mode communication only."@en .


###  https://w3id.org/aias/odp/iso7498/instances#EtherCAT
:EtherCAT rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#Technology> ;
          <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
          rdfs:comment "Real-time capable fieldbus technology on Ethernet, after IEC 61158."@en ;
          rdfs:label "EtherCAT"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Ethernet
:Ethernet rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#Technology> ;
          <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
          rdfs:comment "Frame based data link technology after IEEE 802.3."@en ;
          rdfs:label "Ethernet"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Ethernet1000BASE-T
:Ethernet1000BASE-T rdf:type owl:NamedIndividual ,
                             <https://w3id.org/aias/odp/iso7498#Technology> ;
                    <https://w3id.org/aias/odp/iso7498#realisesLayer> :PhysicalLayer ;
                    rdfs:comment "Gigabit Ethernet over twisted pair, 1000 Mbit/s."@en ;
                    rdfs:label "1000BASE-T"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Ethernet100BASE-TX
:Ethernet100BASE-TX rdf:type owl:NamedIndividual ,
                             <https://w3id.org/aias/odp/iso7498#Technology> ;
                    <https://w3id.org/aias/odp/iso7498#realisesLayer> :PhysicalLayer ;
                    rdfs:comment "Fast Ethernet over twisted pair, 100 Mbit/s."@en ;
                    rdfs:label "100BASE-TX"@en .


###  https://w3id.org/aias/odp/iso7498/instances#FTP
:FTP rdf:type owl:NamedIndividual ,
              <https://w3id.org/aias/odp/iso7498#Technology> ;
     <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
     rdfs:comment "File transfer protocol."@en ;
     rdfs:label "FTP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Frame
:Frame rdf:type owl:NamedIndividual ,
                <https://w3id.org/aias/odp/iso7498#ProtocolDataUnit> ;
       <https://w3id.org/aias/odp/iso7498#atLayer> :DataLinkLayer ;
       rdfs:comment "The protocol data unit of the data link layer."@en ;
       rdfs:label "Frame"@en ;
       <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1. A note to 7.6.4.5 observes that the delimiting and synchronisation functions of the data link layer are sometimes referred to as framing, but the standard defines no such data unit."@en .


###  https://w3id.org/aias/odp/iso7498/instances#HTTP
:HTTP rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
      rdfs:comment "Hypertext transfer protocol."@en ;
      rdfs:label "HTTP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#HTTPS
:HTTPS rdf:type owl:NamedIndividual ,
                <https://w3id.org/aias/odp/iso7498#Technology> ;
       <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
       rdfs:comment "Hypertext transfer protocol over a transport layer security connection."@en ;
       rdfs:label "HTTPS"@en .


###  https://w3id.org/aias/odp/iso7498/instances#IOLink
:IOLink rdf:type owl:NamedIndividual ,
                 <https://w3id.org/aias/odp/iso7498#Technology> ;
        <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
        rdfs:comment "Point to point communication with sensors and actuators, after IEC 61131-9."@en ;
        rdfs:label "IO-Link"@en .


###  https://w3id.org/aias/odp/iso7498/instances#IPv4
:IPv4 rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :NetworkLayer ;
      rdfs:comment "Internet protocol version 4."@en ;
      rdfs:label "IPv4"@en .


###  https://w3id.org/aias/odp/iso7498/instances#IPv6
:IPv6 rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :NetworkLayer ;
      rdfs:comment "Internet protocol version 6."@en ;
      rdfs:label "IPv6"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Jitter
:Jitter rdf:type owl:NamedIndividual ,
                 <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
        rdfs:comment "The variation of transit delay between successive transfers."@en ;
        rdfs:label "Jitter"@en ;
        <http://www.w3.org/2004/02/skos/core#note> "Not named in ISO/IEC 7498-1, 7.4.4. Added because it is what makes a communication suitable or unsuitable for a control task."@en .


###  https://w3id.org/aias/odp/iso7498/instances#MQTT
:MQTT rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
      rdfs:comment "Publish and subscribe messaging protocol for constrained devices, after ISO/IEC 20922."@en ;
      rdfs:label "MQTT"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Modbus
:Modbus rdf:type owl:NamedIndividual ,
                 <https://w3id.org/aias/odp/iso7498#Technology> ;
        <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
        rdfs:comment "Request and response protocol widely used in industrial equipment."@en ;
        rdfs:label "Modbus"@en .


###  https://w3id.org/aias/odp/iso7498/instances#NetworkLayer
:NetworkLayer rdf:type owl:NamedIndividual ,
                       <https://w3id.org/aias/odp/iso7498#Layer> ;
              <https://w3id.org/aias/odp/iso7498#layerNumber> 3 ;
              rdfs:comment "Provides the means to establish, maintain and terminate network connections between open systems and the means to exchange data units over them, independently of routing and relay considerations."@en ;
              rdfs:label "Network Layer"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.5.2."@en .


###  https://w3id.org/aias/odp/iso7498/instances#OPCUA
:OPCUA rdf:type owl:NamedIndividual ,
                <https://w3id.org/aias/odp/iso7498#Technology> ;
       <https://w3id.org/aias/odp/iso7498#realisesLayer> :ApplicationLayer ;
       rdfs:comment "Platform independent service oriented architecture for industrial interoperability, after IEC 62541."@en ;
       rdfs:label "OPC UA"@en .


###  https://w3id.org/aias/odp/iso7498/instances#OneWay
:OneWay rdf:type owl:NamedIndividual ,
                 <https://w3id.org/aias/odp/iso7498#CommunicationDirection> ;
        rdfs:comment "Data communication in one pre-assigned direction."@en ;
        rdfs:label "One-way"@en ;
        <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 5.3.1.16. The transmission underlying it is simplex, 5.3.1.12. A sensor reporting to a collector without receiving anything back is of this kind."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Packet
:Packet rdf:type owl:NamedIndividual ,
                 <https://w3id.org/aias/odp/iso7498#ProtocolDataUnit> ;
        <https://w3id.org/aias/odp/iso7498#atLayer> :NetworkLayer ;
        rdfs:comment "The protocol data unit of the network layer."@en ;
        rdfs:label "Packet"@en ;
        <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1. Named by the network layer protocol standards."@en .


###  https://w3id.org/aias/odp/iso7498/instances#PhysicalLayer
:PhysicalLayer rdf:type owl:NamedIndividual ,
                        <https://w3id.org/aias/odp/iso7498#Layer> ;
               <https://w3id.org/aias/odp/iso7498#layerNumber> 1 ;
               rdfs:comment "Provides the mechanical, electrical, functional and procedural means to activate, maintain and de-activate physical connections for bit transmission between data link entities."@en ;
               rdfs:label "Physical Layer"@en ;
               <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.7.2."@en .


###  https://w3id.org/aias/odp/iso7498/instances#PresentationLayer
:PresentationLayer rdf:type owl:NamedIndividual ,
                            <https://w3id.org/aias/odp/iso7498#Layer> ;
                   <https://w3id.org/aias/odp/iso7498#layerNumber> 6 ;
                   rdfs:comment "Provides for the representation of information that application entities either communicate or refer to in their communication, so that the syntax used is preserved in meaning."@en ;
                   rdfs:label "Presentation Layer"@en ;
                   <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.2.2."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Priority
:Priority rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
          rdfs:comment "The precedence a communication takes over others competing for the same resources."@en ;
          rdfs:label "Priority"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 5.10 mentions priority among the characteristics selectable through quality of service."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Profibus
:Profibus rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#Technology> ;
          <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
          rdfs:comment "Fieldbus for automation with master and slave access, after IEC 61158 and IEC 61784."@en ;
          rdfs:label "PROFIBUS"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "Its master and slave access makes a segment two-way alternate in the sense of 5.3.1.15: both sides send, but never at the same time."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Profinet
:Profinet rdf:type owl:NamedIndividual ,
                   <https://w3id.org/aias/odp/iso7498#Technology> ;
          <https://w3id.org/aias/odp/iso7498#realisesLayer> :DataLinkLayer ;
          rdfs:comment "Industrial Ethernet standard for automation, after IEC 61158 and IEC 61784."@en ;
          rdfs:label "PROFINET"@en .


###  https://w3id.org/aias/odp/iso7498/instances#ResidualErrorRate
:ResidualErrorRate rdf:type owl:NamedIndividual ,
                            <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
                   rdfs:comment "The ratio of data lost, duplicated, or delivered incorrectly to data transferred in total."@en ;
                   rdfs:label "Residual Error Rate"@en ;
                   <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.4.4."@en .


###  https://w3id.org/aias/odp/iso7498/instances#Segment
:Segment rdf:type owl:NamedIndividual ,
                  <https://w3id.org/aias/odp/iso7498#ProtocolDataUnit> ;
         <https://w3id.org/aias/odp/iso7498#atLayer> :TransportLayer ;
         rdfs:comment "The protocol data unit of the transport layer."@en ;
         rdfs:label "Segment"@en ;
         <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1 in this sense. The standard uses segmenting as the name of a function, 5.8.1.9, that maps one service data unit onto multiple protocol data units."@en .


###  https://w3id.org/aias/odp/iso7498/instances#SessionLayer
:SessionLayer rdf:type owl:NamedIndividual ,
                       <https://w3id.org/aias/odp/iso7498#Layer> ;
              <https://w3id.org/aias/odp/iso7498#layerNumber> 5 ;
              rdfs:comment "Provides the means for cooperating presentation entities to organise and synchronise their dialogue and to manage their data exchange."@en ;
              rdfs:label "Session Layer"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.3.2."@en .


###  https://w3id.org/aias/odp/iso7498/instances#TCP
:TCP rdf:type owl:NamedIndividual ,
              <https://w3id.org/aias/odp/iso7498#Technology> ;
     <https://w3id.org/aias/odp/iso7498#realisesLayer> :TransportLayer ;
     rdfs:comment "Transmission control protocol, connection oriented."@en ;
     rdfs:label "TCP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#Throughput
:Throughput rdf:type owl:NamedIndividual ,
                     <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
            rdfs:comment "The rate at which data is transferred over a communication."@en ;
            rdfs:label "Throughput"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.4.4."@en .


###  https://w3id.org/aias/odp/iso7498/instances#TransitDelay
:TransitDelay rdf:type owl:NamedIndividual ,
                       <https://w3id.org/aias/odp/iso7498#QoSParameter> ;
              rdfs:comment "The elapsed time between the request to transfer data and its delivery."@en ;
              rdfs:label "Transit Delay"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.4.4. This is the parameter an engineering model uses to record latency."@en .


###  https://w3id.org/aias/odp/iso7498/instances#TransportLayer
:TransportLayer rdf:type owl:NamedIndividual ,
                         <https://w3id.org/aias/odp/iso7498#Layer> ;
                <https://w3id.org/aias/odp/iso7498#layerNumber> 4 ;
                rdfs:comment "Provides transparent transfer of data between session entities, relieving them of any concern with how reliable and cost effective transfer is achieved."@en ;
                rdfs:label "Transport Layer"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 7.4.2. Clause 7.4.4 names the quality of service parameters of this layer."@en .


###  https://w3id.org/aias/odp/iso7498/instances#TwoWayAlternate
:TwoWayAlternate rdf:type owl:NamedIndividual ,
                          <https://w3id.org/aias/odp/iso7498#CommunicationDirection> ;
                 rdfs:comment "Data communication in both directions, one direction at a time."@en ;
                 rdfs:label "Two-way Alternate"@en ;
                 <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 5.3.1.15. The transmission underlying it is half duplex, 5.3.1.11, where an entity of the layer above chooses the direction. A master and slave bus segment is of this kind: both sides send, but never at once."@en .


###  https://w3id.org/aias/odp/iso7498/instances#TwoWaySimultaneous
:TwoWaySimultaneous rdf:type owl:NamedIndividual ,
                             <https://w3id.org/aias/odp/iso7498#CommunicationDirection> ;
                    rdfs:comment "Data communication in both directions at the same time."@en ;
                    rdfs:label "Two-way Simultaneous"@en ;
                    <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 5.3.1.14. The transmission underlying it is duplex, 5.3.1.10. A full duplex Ethernet link is of this kind."@en .


###  https://w3id.org/aias/odp/iso7498/instances#UDP
:UDP rdf:type owl:NamedIndividual ,
              <https://w3id.org/aias/odp/iso7498#Technology> ;
     <https://w3id.org/aias/odp/iso7498#realisesLayer> :TransportLayer ;
     rdfs:comment "User datagram protocol, connectionless."@en ;
     rdfs:label "UDP"@en .


###  https://w3id.org/aias/odp/iso7498/instances#WLAN
:WLAN rdf:type owl:NamedIndividual ,
               <https://w3id.org/aias/odp/iso7498#Technology> ;
      <https://w3id.org/aias/odp/iso7498#realisesLayer> :PhysicalLayer ;
      rdfs:comment "Wireless local area network after IEEE 802.11."@en ;
      rdfs:label "WLAN"@en .


