}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-08-17"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "TODO: author name, ORCID"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "Named individuals for the ISO/IEC 7498-1 ontology design pattern: the seven layers of the reference model, the protocol data units practice names per layer, common technologies of industrial communication, and the quality of service parameters.\n\nThey are kept apart from the pattern so that the terminology and the vocabulary can be maintained separately. A model importing only the pattern gets the classes; one importing this file gets the vocabulary as well, and need not declare that MQTT is an application layer technology for itself."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "TODO: institution"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1 Pattern: Named Individuals"
  } ],
  "http://purl.org/ontology/bibo/status" : [ {
    "@language" : "en",
    "@value" : "Draft"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "iso7498-inst"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/aias/odp/iso7498/instances#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Three groups of individual, with different standing.\n\nThe seven layers are normative: ISO/IEC 7498-1, 6.1.2 enumerates them and gives each a number.\n\nThe protocol data units and the technologies are conventional. Frame, packet, and segment do not occur in the standard, and 1.3 states that it implies no particular technology. They are supplied because an engineering model needs them and because naming them once keeps models comparable. The list of technologies is open by design.\n\nThe quality of service parameters follow 7.4.4 for the four the standard names, and extend beyond it where practice requires, which is marked at the affected individuals."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/2.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances/2.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.0.0"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#AMQP",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Advanced message queuing protocol, after ISO/IEC 19464."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "AMQP"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The highest layer, providing the sole means for an application process to access the OSI environment. It has no boundary with a higher layer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Application Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.1.2. Consists of the application entities that cooperate in the OSI environment, 6.1.4."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "7"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Availability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The share of time a communication is usable."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Availability"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not named in ISO/IEC 7498-1, 7.4.4. Added because engineering models record it."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Bit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#ServiceDataUnit" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The service data unit of the physical layer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Bit"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "The one practice term ISO/IEC 7498-1 names: 7.6.4.5 refers to physical service data units, that is bits, and 7.7.3.3.1 to the transparent transmission of bit streams."
  } ],
  "https://w3id.org/aias/odp/iso7498#atLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#PhysicalLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#CANopen",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Communication protocol for embedded automation on CAN, after EN 50325-4."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "CANopen"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#DHCP",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dynamic host configuration protocol."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DHCP"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides the functional and procedural means for the transfer of data between network entities and detects and possibly corrects errors occurring in the physical layer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data Link Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.6.2."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "2"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Datagram",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#ProtocolDataUnit" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The protocol data unit of a connectionless-mode transport or network service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Datagram"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 7498-1. Named by the protocol standards of connectionless-mode services."
  } ],
  "https://w3id.org/aias/odp/iso7498#atLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#TransportLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#EstablishmentDelay",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The elapsed time between the request to establish a connection and its confirmation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Establishment Delay"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.4.4. Applies to connection-mode communication only."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#EtherCAT",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
