  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 7498-1. A note to 7.6.4.5 observes that the delimiting and synchronisation functions of the data link layer are sometimes referred to as framing, but the standard defines no such data unit."
  } ],
  "https://w3id.org/aias/odp/iso7498#atLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#HTTP",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hypertext transfer protocol."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "HTTP"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#HTTPS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hypertext transfer protocol over a transport layer security connection."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "HTTPS"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#IOLink",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Point to point communication with sensors and actuators, after IEC 61131-9."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "IO-Link"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#IPv4",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Internet protocol version 4."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "IPv4"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#NetworkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#IPv6",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Internet protocol version 6."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "IPv6"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#NetworkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Jitter",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The variation of transit delay between successive transfers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Jitter"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not named in ISO/IEC 7498-1, 7.4.4. Added because it is what makes a communication suitable or unsuitable for a control task."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#MQTT",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Publish and subscribe messaging protocol for constrained devices, after ISO/IEC 20922."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MQTT"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Modbus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Request and response protocol widely used in industrial equipment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Modbus"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#NetworkLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides the means to establish, maintain and terminate network connections between open systems and the means to exchange data units over them, independently of routing and relay considerations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Network Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.5.2."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "3"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#OPCUA",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Platform independent service oriented architecture for industrial interoperability, after IEC 62541."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OPC UA"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#ApplicationLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#OneWay",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#CommunicationDirection" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data communication in one pre-assigned direction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "One-way"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 5.3.1.16. The transmission underlying it is simplex, 5.3.1.12. A sensor reporting to a collector without receiving anything back is of this kind."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Packet",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#ProtocolDataUnit" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The protocol data unit of the network layer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Packet"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 7498-1. Named by the network layer protocol standards."
  } ],
  "https://w3id.org/aias/odp/iso7498#atLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#NetworkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#PhysicalLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides the mechanical, electrical, functional and procedural means to activate, maintain and de-activate physical connections for bit transmission between data link entities."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Physical Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.7.2."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "1"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#PresentationLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides for the representation of information that application entities either communicate or refer to in their communication, so that the syntax used is preserved in meaning."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Presentation Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.2.2."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "6"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Priority",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The precedence a communication takes over others competing for the same resources."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Priority"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 5.10 mentions priority among the characteristics selectable through quality of service."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Profibus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Fieldbus for automation with master and slave access, after IEC 61158 and IEC 61784."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PROFIBUS"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Its master and slave access makes a segment two-way alternate in the sense of 5.3.1.15: both sides send, but never at the same time."
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Profinet",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Industrial Ethernet standard for automation, after IEC 61158 and IEC 61784."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "PROFINET"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#DataLinkLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#ResidualErrorRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The ratio of data lost, duplicated, or delivered incorrectly to data transferred in total."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Residual Error Rate"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.4.4."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Segment",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#ProtocolDataUnit" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The protocol data unit of the transport layer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Segment"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "Not a term of ISO/IEC 7498-1 in this sense. The standard uses segmenting as the name of a function, 5.8.1.9, that maps one service data unit onto multiple protocol data units."
  } ],
  "https://w3id.org/aias/odp/iso7498#atLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#TransportLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#SessionLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides the means for cooperating presentation entities to organise and synchronise their dialogue and to manage their data exchange."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Session Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.3.2."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "5"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#TCP",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Technology" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Transmission control protocol, connection oriented."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "TCP"
  } ],
  "https://w3id.org/aias/odp/iso7498#realisesLayer" : [ {
    "@id" : "https://w3id.org/aias/odp/iso7498/instances#TransportLayer"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#Throughput",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The rate at which data is transferred over a communication."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Throughput"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.4.4."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#TransitDelay",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#QoSParameter" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The elapsed time between the request to transfer data and its delivery."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Transit Delay"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.4.4. This is the parameter an engineering model uses to record latency."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#TransportLayer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#Layer" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Provides transparent transfer of data between session entities, relieving them of any concern with how reliable and cost effective transfer is achieved."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Transport Layer"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 7.4.2. Clause 7.4.4 names the quality of service parameters of this layer."
  } ],
  "https://w3id.org/aias/odp/iso7498#layerNumber" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#integer",
    "@value" : "4"
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#TwoWayAlternate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#CommunicationDirection" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data communication in both directions, one direction at a time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Two-way Alternate"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 5.3.1.15. The transmission underlying it is half duplex, 5.3.1.11, where an entity of the layer above chooses the direction. A master and slave bus segment is of this kind: both sides send, but never at once."
  } ]
}, {
  "@id" : "https://w3id.org/aias/odp/iso7498/instances#TwoWaySimultaneous",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "https://w3id.org/aias/odp/iso7498#CommunicationDirection" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Data communication in both directions at the same time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Two-way Simultaneous"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "ISO/IEC 7498-1, 5.3.1.14. The transmission underlying it is duplex, 5.3.1.10. A full duplex Ethernet link is of this kind."
