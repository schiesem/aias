#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/aias/odp/iso7498#hasDataUnit
:hasDataUnit rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Communication
                                         :Layer
                                       )
                         ] ;
             rdfs:range :DataUnit ;
             rdfs:comment "Relates a layer, or a communication itself, to the data unit it processes or transmits."@en ,
                          "Verbindet eine Schicht oder die Kommunikation selbst mit der Dateneinheit, die sie verarbeitet oder überträgt."@de ;
             rdfs:label "has data unit"@en ,
                        "hat Dateneinheit"@de ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "hasDU"@en ;
             <http://www.w3.org/2004/02/skos/core#note> """One relation with two domains: the content transmitted is assigned to the respective layer, or to the communication directly.

hasDU is kept as an alternative label, since that is the short form the relation is commonly written as."""@en .


###  https://w3id.org/aias/odp/iso7498#hasLayer
:hasLayer rdf:type owl:ObjectProperty ;
          rdfs:domain :Communication ;
          rdfs:range :Layer ;
          rdfs:comment "Relates a communication to a layer it is structured into."@en ,
                       "Verbindet eine Kommunikation mit einer Schicht, in die sie gegliedert ist."@de ;
          rdfs:label "has layer"@en ,
                     "hat Schicht"@de .


###  https://w3id.org/aias/odp/iso7498#hasName
:hasName rdf:type owl:ObjectProperty ;
         rdfs:domain :Communication ;
         rdfs:range :Name ;
         rdfs:comment "Relates a communication to its designation."@en ,
                      "Verbindet eine Kommunikation mit ihrer Bezeichnung."@de ;
         rdfs:label "has name"@en ,
                    "hat Namen"@de .


###  https://w3id.org/aias/odp/iso7498#usesTechnology
:usesTechnology rdf:type owl:ObjectProperty ;
                rdfs:domain :Layer ;
                rdfs:range :Technology ;
                rdfs:comment "Relates a layer to the technology realising it."@en ,
                             "Verbindet eine Schicht mit der Technologie, die sie realisiert."@de ;
                rdfs:label "nutzt Technologie"@de ,
                           "uses technology"@en ;
                <http://www.w3.org/2004/02/skos/core#note> "Whether a given technology fits the layer it is claimed for is not checked here. Nothing stops a model from placing MQTT at the network layer."@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/aias/odp/iso7498#Application
:Application rdf:type owl:Class ;
             rdfs:subClassOf :Layer ;
             rdfs:comment "Provides services such as file transfer or remote access directly to the application, using the services of the layers below."@en ,
                          "Stellt direkt der Anwendung Dienste wie Dateiübertragung oder Remote-Zugriff zur Verfügung und nutzt dafür die Dienste der unteren Schichten."@de ;
             rdfs:label "Anwendungsschicht"@de ,
                        "Application Layer"@en ;
             <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.1."@en .


###  https://w3id.org/aias/odp/iso7498#Bit
:Bit rdf:type owl:Class ;
     rdfs:subClassOf :DataUnit ;
     rdfs:comment "Dateneinheit der Bitübertragungsschicht."@de ,
                  "The data unit of the physical layer."@en ;
     rdfs:label "Bit"@de ,
                "Bit"@en ;
     <http://www.w3.org/2004/02/skos/core#note> "The one practice term ISO/IEC 7498-1 names: 7.7.3.3.1 refers to the transparent transmission of bit streams."@en .


###  https://w3id.org/aias/odp/iso7498#Communication
:Communication rdf:type owl:Class ;
               rdfs:comment "A connection between at least two system components describing the directed exchange of data."@en ,
                            "Verbindung zwischen mindestens zwei Systemkomponenten, die den gerichteten Austausch von Daten beschreibt."@de ;
               rdfs:label "Communication"@en ,
                          "Kommunikation"@de ;
               <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, definition 4.2.10. The standard itself calls this an association. Communication is the plainer term, and is the one used here."@en .


###  https://w3id.org/aias/odp/iso7498#DHCP
:DHCP rdf:type owl:Class ;
      rdfs:subClassOf :Technology ;
      rdfs:comment "Dynamic Host Configuration Protocol, eine Technologie der Anwendungsschicht."@de ,
                   "The Dynamic Host Configuration Protocol, a technology of the application layer."@en ;
      rdfs:label "DHCP"@de ,
                 "DHCP"@en .


###  https://w3id.org/aias/odp/iso7498#Data
:Data rdf:type owl:Class ;
      rdfs:subClassOf :DataUnit ;
      rdfs:comment "Dateneinheit der oberen Schichten, also das, was eine Anwendung austauscht."@de ,
                   "The data unit of the upper layers, that is what an application exchanges."@en ;
      rdfs:label "Data"@en ,
                 "Daten"@de ;
      <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1 for a data unit. It stands for what an application exchanges, without separating the payload of a single transmission from a dataset as a whole."@en .


###  https://w3id.org/aias/odp/iso7498#DataLink
:DataLink rdf:type owl:Class ;
          rdfs:subClassOf :Layer ;
          rdfs:comment "Bildet aus Bits Datenrahmen und regelt den Zugriff auf das Übertragungsmedium."@de ,
                       "Forms frames out of bits and governs access to the transmission medium."@en ;
          rdfs:label "Data Link Layer"@en ,
                     "Sicherungsschicht"@de ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.6."@en .


###  https://w3id.org/aias/odp/iso7498#DataUnit
:DataUnit rdf:type owl:Class ;
          rdfs:comment "A delimited, coherent quantity of data processed or transmitted by a layer of the OSI model as one unit."@en ,
                       "Abgegrenzte, zusammenhängende Datenmenge, die von einer Schicht des OSI-Modells als Einheit verarbeitet oder übertragen wird."@de ;
          rdfs:label "Data Unit"@en ,
                     "Dateneinheit"@de ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "DU"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 5.6."@en .


###  https://w3id.org/aias/odp/iso7498#Ethernet
:Ethernet rdf:type owl:Class ;
          rdfs:subClassOf :Technology ;
          rdfs:comment "A family of technologies of the data link layer."@en ,
                       "Technologiefamilie der Sicherungsschicht."@de ;
          rdfs:label "Ethernet"@de ,
                     "Ethernet"@en .


###  https://w3id.org/aias/odp/iso7498#Ethernet1000BASET
:Ethernet1000BASET rdf:type owl:Class ;
                   rdfs:subClassOf :Technology ;
                   rdfs:comment "Gigabit Ethernet over twisted pair cabling, a technology of the physical layer."@en ,
                                "Gigabit-Ethernet über Twisted-Pair-Verkabelung, eine Technologie der Bitübertragungsschicht."@de ;
                   rdfs:label "1000BASE-T"@de ,
                              "1000BASE-T"@en ;
                   <http://www.w3.org/2004/02/skos/core#note> "A class name beginning with a digit is awkward in a namespace, so the class is called Ethernet1000BASET and carries the practice name 1000BASE-T as its label."@en .


###  https://w3id.org/aias/odp/iso7498#FTP
:FTP rdf:type owl:Class ;
     rdfs:subClassOf :Technology ;
     rdfs:comment "File Transfer Protocol, eine Technologie der Anwendungsschicht."@de ,
                  "The File Transfer Protocol, a technology of the application layer."@en ;
     rdfs:label "FTP"@de ,
                "FTP"@en .


###  https://w3id.org/aias/odp/iso7498#Frame
:Frame rdf:type owl:Class ;
       rdfs:subClassOf :DataUnit ;
       rdfs:comment "Dateneinheit der Sicherungsschicht."@de ,
                    "The data unit of the data link layer."@en ;
       rdfs:label "Datenrahmen"@de ,
                  "Frame"@en ;
       <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1. A note to 7.6.4.5 observes that the delimiting function of the data link layer is sometimes referred to as framing, but the standard defines no such data unit."@en .


###  https://w3id.org/aias/odp/iso7498#HTTP
:HTTP rdf:type owl:Class ;
      rdfs:subClassOf :Technology ;
      rdfs:comment "Hypertext Transfer Protocol, eine Technologie der Anwendungsschicht."@de ,
                   "The Hypertext Transfer Protocol, a technology of the application layer."@en ;
      rdfs:label "HTTP"@de ,
                 "HTTP"@en .


###  https://w3id.org/aias/odp/iso7498#HTTPS
:HTTPS rdf:type owl:Class ;
       rdfs:subClassOf :Technology ;
       rdfs:comment "HTTP over a secured connection, a technology of the application layer."@en ,
                    "HTTP über eine gesicherte Verbindung, eine Technologie der Anwendungsschicht."@de ;
       rdfs:label "HTTPS"@de ,
                  "HTTPS"@en .


###  https://w3id.org/aias/odp/iso7498#IP
:IP rdf:type owl:Class ;
    rdfs:subClassOf :Technology ;
    rdfs:comment "Internet Protocol, eine Technologie der Vermittlungsschicht."@de ,
                 "The Internet Protocol, a technology of the network layer."@en ;
    rdfs:label "IP"@de ,
               "IP"@en .


###  https://w3id.org/aias/odp/iso7498#Layer
:Layer rdf:type owl:Class ;
       rdfs:comment "A delimited group of functions carrying out defined communication tasks at a given level of abstraction."@en ,
                    "Abgegrenzte Funktionsgruppe, die auf einem bestimmten Abstraktionsniveau definierte Kommunikationsaufgaben erfüllt."@de ;
       rdfs:label "Layer"@en ,
                  "Schicht"@de ;
       <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, 5.2.1.2. Clause 6.1.2 enumerates exactly seven layers."@en .


###  https://w3id.org/aias/odp/iso7498#MQTT
:MQTT rdf:type owl:Class ;
      rdfs:subClassOf :Technology ;
      rdfs:comment "A publish and subscribe protocol of the application layer."@en ,
                   "Publish-Subscribe-Protokoll der Anwendungsschicht."@de ;
      rdfs:label "MQTT"@de ,
                 "MQTT"@en .


###  https://w3id.org/aias/odp/iso7498#Name
:Name rdf:type owl:Class ;
      rdfs:comment "Bezeichnung, unter der eine Kommunikation bekannt ist."@de ,
                   "The designation under which a communication is known."@en ;
      rdfs:label "Name"@de ,
                 "Name"@en ;
      <http://www.w3.org/2004/02/skos/core#note> "Not a class of ISO/IEC 7498-1. A construct of this model, so that a communication can be referred to by a name of its own."@en .


###  https://w3id.org/aias/odp/iso7498#Network
:Network rdf:type owl:Class ;
         rdfs:subClassOf :Layer ;
         rdfs:comment "Organises the forwarding of data packet by packet across several networks."@en ,
                      "Organisiert die paketweise Weiterleitung von Daten über mehrere Netze hinweg."@de ;
         rdfs:label "Network Layer"@en ,
                    "Vermittlungsschicht"@de ;
         <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.5."@en .


###  https://w3id.org/aias/odp/iso7498#Packet
:Packet rdf:type owl:Class ;
        rdfs:subClassOf :DataUnit ;
        rdfs:comment "Dateneinheit der Vermittlungsschicht."@de ,
                     "The data unit of the network layer."@en ;
        rdfs:label "Packet"@en ,
                   "Paket"@de ;
        <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1, but of the network layer protocol standards."@en .


###  https://w3id.org/aias/odp/iso7498#Physical
:Physical rdf:type owl:Class ;
          rdfs:subClassOf :Layer ;
          rdfs:comment "Transmits raw bits as electrical, optical or radio signals over a physical medium."@en ,
                       "Überträgt rohe Bits als elektrische, optische oder Funksignale über ein physisches Medium."@de ;
          rdfs:label "Bitübertragungsschicht"@de ,
                     "Physical Layer"@en ;
          <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.7."@en .


###  https://w3id.org/aias/odp/iso7498#Presentation
:Presentation rdf:type owl:Class ;
              rdfs:subClassOf :Layer ;
              rdfs:comment "Converts data into a common format and carries out coding, compression and where required encryption."@en ,
                           "Wandelt Daten in ein gemeinsames Format und übernimmt Codierung, Kompression und gegebenenfalls Verschlüsselung."@de ;
              rdfs:label "Darstellungsschicht"@de ,
                         "Presentation Layer"@en ;
              <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.2."@en .


###  https://w3id.org/aias/odp/iso7498#Segment
:Segment rdf:type owl:Class ;
         rdfs:subClassOf :DataUnit ;
         rdfs:comment "Dateneinheit der Transportschicht."@de ,
                      "The data unit of the transport layer."@en ;
         rdfs:label "Segment"@de ,
                    "Segment"@en ;
         <http://www.w3.org/2004/02/skos/core#note> "Not a term of ISO/IEC 7498-1 in this sense. The standard uses segmenting as the name of a function, 5.8.1.9, that maps one service data unit onto several protocol data units."@en .


###  https://w3id.org/aias/odp/iso7498#Session
:Session rdf:type owl:Class ;
         rdfs:subClassOf :Layer ;
         rdfs:comment "Manages sessions between applications, their establishment, control and synchronisation."@en ,
                      "Verwaltet Sitzungen zwischen Anwendungen, deren Aufbau, Steuerung und Synchronisation."@de ;
         rdfs:label "Session Layer"@en ,
                    "Sitzungsschicht"@de ;
         <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.3."@en .


###  https://w3id.org/aias/odp/iso7498#TCP
:TCP rdf:type owl:Class ;
     rdfs:subClassOf :Technology ;
     rdfs:comment "The Transmission Control Protocol, a technology of the transport layer."@en ,
                  "Transmission Control Protocol, eine Technologie der Transportschicht."@de ;
     rdfs:label "TCP"@de ,
                "TCP"@en .


###  https://w3id.org/aias/odp/iso7498#Technology
:Technology rdf:type owl:Class ;
            rdfs:comment "A concrete protocol or transmission technique realising the tasks of a layer."@en ,
                         "Konkretes Protokoll oder Übertragungsverfahren, das die Aufgaben einer Schicht realisiert."@de ;
            rdfs:label "Technologie"@de ,
                       "Technology"@en ;
            <http://www.w3.org/2004/02/skos/core#note> "Not a class of ISO/IEC 7498-1. Clause 1.3 states that the fact a system is open implies no particular implementation or technology, so the standard names none."@en .


###  https://w3id.org/aias/odp/iso7498#Transport
:Transport rdf:type owl:Class ;
           rdfs:subClassOf :Layer ;
           rdfs:comment "Provides end-to-end connections between communicating partners and segments data streams."@en ,
                        "Stellt Ende-zu-Ende-Verbindungen zwischen Kommunikationspartnern bereit und segmentiert Datenströme."@de ;
           rdfs:label "Transport Layer"@en ,
                      "Transportschicht"@de ;
           <http://www.w3.org/2004/02/skos/core#note> "ISO/IEC 7498-1, clause 7.4."@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Application
                :DataLink
                :Network
                :Physical
                :Presentation
                :Session
                :Transport
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Bit
                :Data
                :Frame
                :Packet
                :Segment
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Communication
                :DataUnit
                :Layer
                :Name
                :Technology
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DHCP
                :Ethernet
                :Ethernet1000BASET
                :FTP
                :HTTP
                :HTTPS
                :IP
                :MQTT
                :TCP
              )
] .


