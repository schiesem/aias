  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#DHCP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="de">Dynamic Host Configuration Protocol, eine Technologie der Anwendungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Dynamic Host Configuration Protocol, a technology of the application layer.</rdfs:comment>
