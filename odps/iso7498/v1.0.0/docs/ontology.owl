    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">A family of technologies of the data link layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">Technologiefamilie der Sicherungsschicht.</rdfs:comment>
    <rdfs:label xml:lang="de">Ethernet</rdfs:label>
    <rdfs:label xml:lang="en">Ethernet</rdfs:label>
  </rdf:Description>
