  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Ethernet1000BASET">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">Gigabit Ethernet over twisted pair cabling, a technology of the physical layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">Gigabit-Ethernet über Twisted-Pair-Verkabelung, eine Technologie der Bitübertragungsschicht.</rdfs:comment>
    <rdfs:label xml:lang="de">1000BASE-T</rdfs:label>
    <rdfs:label xml:lang="en">1000BASE-T</rdfs:label>
    <skos:note xml:lang="en">A class name beginning with a digit is awkward in a namespace, so the class is called Ethernet1000BASET and carries the practice name 1000BASE-T as its label.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N403e6f84aace4fa19de25192b1252da9">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Packet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="de">Dateneinheit der Vermittlungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The data unit of the network layer.</rdfs:comment>
    <rdfs:label xml:lang="en">Packet</rdfs:label>
    <rdfs:label xml:lang="de">Paket</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 7498-1, but of the network layer protocol standards.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3d98fd78785c411e88ecbb59df7afc61">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Communication"/>
