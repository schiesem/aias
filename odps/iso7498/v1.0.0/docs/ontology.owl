  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Transport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Provides end-to-end connections between communicating partners and segments data streams.</rdfs:comment>
    <rdfs:comment xml:lang="de">Stellt Ende-zu-Ende-Verbindungen zwischen Kommunikationspartnern bereit und segmentiert Datenströme.</rdfs:comment>
    <rdfs:label xml:lang="en">Transport Layer</rdfs:label>
    <rdfs:label xml:lang="de">Transportschicht</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.4.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#DataUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A delimited, coherent quantity of data processed or transmitted by a layer of the OSI model as one unit.</rdfs:comment>
    <rdfs:comment xml:lang="de">Abgegrenzte, zusammenhängende Datenmenge, die von einer Schicht des OSI-Modells als Einheit verarbeitet oder übertragen wird.</rdfs:comment>
    <rdfs:label xml:lang="en">Data Unit</rdfs:label>
    <rdfs:label xml:lang="de">Dateneinheit</rdfs:label>
    <skos:altLabel xml:lang="en">DU</skos:altLabel>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 5.6.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4e1aaadec2f24b8886c078589c9a94c3">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Physical"/>
