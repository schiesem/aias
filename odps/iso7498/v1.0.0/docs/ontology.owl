  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#DataLink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="de">Bildet aus Bits Datenrahmen und regelt den Zugriff auf das Übertragungsmedium.</rdfs:comment>
    <rdfs:comment xml:lang="en">Forms frames out of bits and governs access to the transmission medium.</rdfs:comment>
    <rdfs:label xml:lang="en">Data Link Layer</rdfs:label>
    <rdfs:label xml:lang="de">Sicherungsschicht</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.6.</skos:note>
  </rdf:Description>
