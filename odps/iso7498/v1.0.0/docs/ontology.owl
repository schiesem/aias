  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#HTTP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="de">Hypertext Transfer Protocol, eine Technologie der Anwendungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Hypertext Transfer Protocol, a technology of the application layer.</rdfs:comment>
    <rdfs:label xml:lang="de">HTTP</rdfs:label>
    <rdfs:label xml:lang="en">HTTP</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Frame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="de">Dateneinheit der Sicherungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The data unit of the data link layer.</rdfs:comment>
    <rdfs:label xml:lang="de">Datenrahmen</rdfs:label>
    <rdfs:label xml:lang="en">Frame</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 7498-1. A note to 7.6.4.5 observes that the delimiting function of the data link layer is sometimes referred to as framing, but the standard defines no such data unit.</skos:note>
  </rdf:Description>
