   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:schema="https://schema.org/"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"

   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
   xmlns:iso7498="https://w3id.org/aias/odp/iso7498#">
  <rdf:Description rdf:nodeID="N4545e7990a9744b2b84ac867bca8b9de">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#MQTT"/>
    <rdf:rest rdf:nodeID="N97c821e097b7480785574961c608e8cc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#IP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="de">Internet Protocol, eine Technologie der Vermittlungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The Internet Protocol, a technology of the network layer.</rdfs:comment>
    <rdfs:label xml:lang="de">IP</rdfs:label>
    <rdfs:label xml:lang="en">IP</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Session">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Manages sessions between applications, their establishment, control and synchronisation.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verwaltet Sitzungen zwischen Anwendungen, deren Aufbau, Steuerung und Synchronisation.</rdfs:comment>
    <rdfs:label xml:lang="en">Session Layer</rdfs:label>
    <rdfs:label xml:lang="de">Sitzungsschicht</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.3.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Physical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Transmits raw bits as electrical, optical or radio signals over a physical medium.</rdfs:comment>
    <rdfs:comment xml:lang="de">Überträgt rohe Bits als elektrische, optische oder Funksignale über ein physisches Medium.</rdfs:comment>
    <rdfs:label xml:lang="de">Bitübertragungsschicht</rdfs:label>
    <rdfs:label xml:lang="en">Physical Layer</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.7.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Communication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A connection between at least two system components describing the directed exchange of data.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindung zwischen mindestens zwei Systemkomponenten, die den gerichteten Austausch von Daten beschreibt.</rdfs:comment>
    <rdfs:label xml:lang="en">Communication</rdfs:label>
    <rdfs:label xml:lang="de">Kommunikation</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, definition 4.2.10. The standard itself calls this an association. Communication is the plainer term, and is the one used here.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#hasName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso7498#Communication"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso7498#Name"/>
    <rdfs:comment xml:lang="en">Relates a communication to its designation.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Kommunikation mit ihrer Bezeichnung.</rdfs:comment>
    <rdfs:label xml:lang="en">has name</rdfs:label>
    <rdfs:label xml:lang="de">hat Namen</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#MQTT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">A publish and subscribe protocol of the application layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">Publish-Subscribe-Protokoll der Anwendungsschicht.</rdfs:comment>
    <rdfs:label xml:lang="de">MQTT</rdfs:label>
    <rdfs:label xml:lang="en">MQTT</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#usesTechnology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">Relates a layer to the technology realising it.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Schicht mit der Technologie, die sie realisiert.</rdfs:comment>
    <rdfs:label xml:lang="de">nutzt Technologie</rdfs:label>
    <rdfs:label xml:lang="en">uses technology</rdfs:label>
    <skos:note xml:lang="en">Whether a given technology fits the layer it is claimed for is not checked here. Nothing stops a model from placing MQTT at the network layer.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Presentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Converts data into a common format and carries out coding, compression and where required encryption.</rdfs:comment>
    <rdfs:comment xml:lang="de">Wandelt Daten in ein gemeinsames Format und übernimmt Codierung, Kompression und gegebenenfalls Verschlüsselung.</rdfs:comment>
    <rdfs:label xml:lang="de">Darstellungsschicht</rdfs:label>
    <rdfs:label xml:lang="en">Presentation Layer</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.2.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#HTTPS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">HTTP over a secured connection, a technology of the application layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">HTTP über eine gesicherte Verbindung, eine Technologie der Anwendungsschicht.</rdfs:comment>
    <rdfs:label xml:lang="de">HTTPS</rdfs:label>
    <rdfs:label xml:lang="en">HTTPS</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/aias/odp/iso7498/1.0.0"/>
    <dcterms:abstract xml:lang="en">An ontology design pattern for describing the communication between the components of an automated plant, following the layered architecture of ISO/IEC 7498-1, the Basic Reference Model of Open Systems Interconnection. A communication is structured into the seven layers of the reference model, each layer is realised by a technology such as Ethernet, IP or MQTT, and the content carried is a data unit assigned either to a layer or to the communication itself. The layers, the technologies and the kinds of data unit are modelled as subclasses. The pattern is one of three subdomain patterns of the AIAS information model and is meant to be imported and aligned rather than used on its own.</dcterms:abstract>
    <dcterms:bibliographicCitation xml:lang="en">M. Schieseck, P. Topalis, L. Reinpold, F. Gehlhoff and A. Fay, "A Formal Model for Artificial Intelligence Applications in Automation Systems," 2024 IEEE 29th International Conference on Emerging Technologies and Factory Automation (ETFA), Padova, Italy, IEEE, September 2024. DOI 10.1109/ETFA61755.2024.10710890</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-01</dcterms:created>
    <dcterms:creator>Alexander Fay</dcterms:creator>
    <dcterms:creator>Felix Gehlhoff</dcterms:creator>
    <dcterms:creator>Lasse Reinpold</dcterms:creator>
    <dcterms:creator>Marvin Schieseck</dcterms:creator>
    <dcterms:creator>Philip Topalis</dcterms:creator>
    <dcterms:hasVersion rdf:resource="https://w3id.org/aias/odp/iso7498"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-02</dcterms:modified>
    <dcterms:publisher>Helmut-Schmidt-Universität / Universität der Bundeswehr Hamburg</dcterms:publisher>
    <dcterms:rights xml:lang="en">This research is funded by dtec.bw – Digitalization and Technology Research Center of the Bundeswehr. dtec.bw is funded by the European Union – NextGenerationEU</dcterms:rights>
    <dcterms:source rdf:resource="https://www.iso.org/standard/20269.html"/>
    <dcterms:subject xml:lang="en">ISO/IEC 7498-1</dcterms:subject>
    <dcterms:subject xml:lang="en">Industrial Communication</dcterms:subject>
    <dcterms:subject xml:lang="en">Network Protocol</dcterms:subject>
    <dcterms:subject xml:lang="en">OSI Reference Model</dcterms:subject>
    <dcterms:subject xml:lang="en">Ontology Design Pattern</dcterms:subject>
    <dcterms:title xml:lang="en">ISO/IEC 7498-1 Ontology Design Pattern</dcterms:title>
    <bibo:doi>10.1109/ETFA61755.2024.10710890</bibo:doi>
    <bibo:status xml:lang="en">Draft</bibo:status>
    <vann:preferredNamespacePrefix>iso7498</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/aias/odp/iso7498#</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Normative basis: ISO/IEC 7498-1:1994.

Twenty-six classes and four relations. Every definition carries a German wording alongside its English translation.

The layers, the technologies and the kinds of data unit are modelled as subclasses.

Scope: the layered structure of a communication and what travels over it. The open system with its subsystems and entities, services and protocols, the transmission modes and the quality of service are not covered.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <foaf:fundedBy rdf:resource="https://dtecbw.de/"/>
    <schema:codeRepository rdf:resource="https://github.com/schiesem/aias"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N324e59aadcbc4d038d1bbe2670ff3054">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Technology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A concrete protocol or transmission technique realising the tasks of a layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">Konkretes Protokoll oder Übertragungsverfahren, das die Aufgaben einer Schicht realisiert.</rdfs:comment>
    <rdfs:label xml:lang="de">Technologie</rdfs:label>
    <rdfs:label xml:lang="en">Technology</rdfs:label>
    <skos:note xml:lang="en">Not a class of ISO/IEC 7498-1. Clause 1.3 states that the fact a system is open implies no particular implementation or technology, so the standard names none.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N66f75f2a24d341228a0202272dda1cba">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Session"/>
    <rdf:rest rdf:nodeID="N0488e14956db40ff8c017357fa8160fc"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Organises the forwarding of data packet by packet across several networks.</rdfs:comment>
    <rdfs:comment xml:lang="de">Organisiert die paketweise Weiterleitung von Daten über mehrere Netze hinweg.</rdfs:comment>
    <rdfs:label xml:lang="en">Network Layer</rdfs:label>
    <rdfs:label xml:lang="de">Vermittlungsschicht</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.5.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#hasLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/iso7498#Communication"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Relates a communication to a layer it is structured into.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Kommunikation mit einer Schicht, in die sie gegliedert ist.</rdfs:comment>
    <rdfs:label xml:lang="en">has layer</rdfs:label>
    <rdfs:label xml:lang="de">hat Schicht</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4d3c3feb987e465eacb78124ad953e9e">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Name"/>
    <rdf:rest rdf:nodeID="N403e6f84aace4fa19de25192b1252da9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#TCP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="en">The Transmission Control Protocol, a technology of the transport layer.</rdfs:comment>
    <rdfs:comment xml:lang="de">Transmission Control Protocol, eine Technologie der Transportschicht.</rdfs:comment>
    <rdfs:label xml:lang="de">TCP</rdfs:label>
    <rdfs:label xml:lang="en">TCP</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#hasDataUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="Na89156f428984fd5b6e503a8f1978289"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="en">Relates a layer, or a communication itself, to the data unit it processes or transmits.</rdfs:comment>
    <rdfs:comment xml:lang="de">Verbindet eine Schicht oder die Kommunikation selbst mit der Dateneinheit, die sie verarbeitet oder überträgt.</rdfs:comment>
    <rdfs:label xml:lang="en">has data unit</rdfs:label>
    <rdfs:label xml:lang="de">hat Dateneinheit</rdfs:label>
    <skos:altLabel xml:lang="en">hasDU</skos:altLabel>
    <skos:note xml:lang="en">One relation with two domains: the content transmitted is assigned to the respective layer, or to the communication directly.

hasDU is kept as an alternative label, since that is the short form the relation is commonly written as.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5318af2ecbc8408a941c15364afd93f4">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdf:rest rdf:nodeID="N724fe8622980445a879fd93d0490816f"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#note">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N75ba92411459405a870f2d6f77aa6438">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Ethernet1000BASET"/>
    <rdf:rest rdf:nodeID="Nde8a8da93ed540c5982f6145a749a083"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Layer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A delimited group of functions carrying out defined communication tasks at a given level of abstraction.</rdfs:comment>
    <rdfs:comment xml:lang="de">Abgegrenzte Funktionsgruppe, die auf einem bestimmten Abstraktionsniveau definierte Kommunikationsaufgaben erfüllt.</rdfs:comment>
    <rdfs:label xml:lang="en">Layer</rdfs:label>
    <rdfs:label xml:lang="de">Schicht</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, 5.2.1.2. Clause 6.1.2 enumerates exactly seven layers.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Application">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Layer"/>
    <rdfs:comment xml:lang="en">Provides services such as file transfer or remote access directly to the application, using the services of the layers below.</rdfs:comment>
    <rdfs:comment xml:lang="de">Stellt direkt der Anwendung Dienste wie Dateiübertragung oder Remote-Zugriff zur Verfügung und nutzt dafür die Dienste der unteren Schichten.</rdfs:comment>
    <rdfs:label xml:lang="de">Anwendungsschicht</rdfs:label>
    <rdfs:label xml:lang="en">Application Layer</rdfs:label>
    <skos:note xml:lang="en">ISO/IEC 7498-1, clause 7.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbacac9570d6f4dd784f6e743b5bbbb5d">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Presentation"/>
    <rdf:rest rdf:nodeID="N66f75f2a24d341228a0202272dda1cba"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#FTP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#Technology"/>
    <rdfs:comment xml:lang="de">File Transfer Protocol, eine Technologie der Anwendungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The File Transfer Protocol, a technology of the application layer.</rdfs:comment>
    <rdfs:label xml:lang="de">FTP</rdfs:label>
    <rdfs:label xml:lang="en">FTP</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="de">Dateneinheit der Transportschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The data unit of the transport layer.</rdfs:comment>
    <rdfs:label xml:lang="de">Segment</rdfs:label>
    <rdfs:label xml:lang="en">Segment</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 7498-1 in this sense. The standard uses segmenting as the name of a function, 5.8.1.9, that maps one service data unit onto several protocol data units.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="de">Dateneinheit der oberen Schichten, also das, was eine Anwendung austauscht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The data unit of the upper layers, that is what an application exchanges.</rdfs:comment>
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <rdfs:label xml:lang="de">Daten</rdfs:label>
    <skos:note xml:lang="en">Not a term of ISO/IEC 7498-1 for a data unit. It stands for what an application exchanges, without separating the payload of a single transmission from a dataset as a whole.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Bit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/iso7498#DataUnit"/>
    <rdfs:comment xml:lang="de">Dateneinheit der Bitübertragungsschicht.</rdfs:comment>
    <rdfs:comment xml:lang="en">The data unit of the physical layer.</rdfs:comment>
    <rdfs:label xml:lang="de">Bit</rdfs:label>
    <rdfs:label xml:lang="en">Bit</rdfs:label>
    <skos:note xml:lang="en">The one practice term ISO/IEC 7498-1 names: 7.7.3.3.1 refers to the transparent transmission of bit streams.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N49abd6856047456eb951a5fe047fa3e3">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Packet"/>
    <rdf:rest rdf:nodeID="N3ccaea3bc377427c97d9ebb1921bf9e4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/iso7498#Name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="de">Bezeichnung, unter der eine Kommunikation bekannt ist.</rdfs:comment>
    <rdfs:comment xml:lang="en">The designation under which a communication is known.</rdfs:comment>
    <rdfs:label xml:lang="de">Name</rdfs:label>
    <rdfs:label xml:lang="en">Name</rdfs:label>
    <skos:note xml:lang="en">Not a class of ISO/IEC 7498-1. A construct of this model, so that a communication can be referred to by a name of its own.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1504cdae65a641ed83172e609c75be71">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/iso7498#Ethernet"/>
