  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A network describing a technical process. Its nodes are the states of products, energies and information, its directed edges are the transformation steps carried out by process operators.</rdfs:comment>
    <rdfs:comment xml:lang="de">Netz zur Beschreibung technischer Prozesse, dessen Knoten die Zustände von Produkten und dessen gerichtete Kanten die Umwandlungsschritte durch Prozessoperatoren darstellen.</rdfs:comment>
    <rdfs:label xml:lang="en">Process</rdfs:label>
    <rdfs:label xml:lang="de">Prozess</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1, page 8.</skos:note>
  </rdf:Description>
