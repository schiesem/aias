    {
      "iri": "https://w3id.org/aias/odp/vdi3682#TechnicalResource",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.2.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Technische Ressource",
        "IRI-based": "TechnicalResource",
        "en": "Technical Resource"
      },
      "comment": {
        "de": "Physische Komponenten, aus denen automatisierte Anlagen aufgebaut sind und die die Umwandlungen der Produkte durch Prozessoperatoren realisieren.",
        "en": "Physical components of which automated plants are built and which realise the transformations carried out by process operators."
      },
      "id": "6",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#Process",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1, page 8.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Prozess",
        "IRI-based": "Process",
        "en": "Process"
      },
      "comment": {
        "de": "Netz zur Beschreibung technischer Prozesse, dessen Knoten die Zustände von Produkten und dessen gerichtete Kanten die Umwandlungsschritte durch Prozessoperatoren darstellen.",
        "en": "A network describing a technical process. Its nodes are the states of products, energies and information, its directed edges are the transformation steps carried out by process operators."
      },
      "id": "12",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#Product",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1, page 8. A product is not a kind of state: it has one, which hasState records. The thing and the condition it is in are kept apart, so the same sheet of metal before and after a stamping is one product in two states.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Produkt",
        "IRI-based": "Product",
        "en": "Product"
      },
      "comment": {
        "de": "Dinge der realen Welt, die im Rahmen eines technischen Prozesses umgewandelt werden.",
        "en": "Things of the real world that are transformed within a technical process."
      },
      "id": "19",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#State",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 2, Figure 2 carries state as a class of the information model. Part 1 avoids the term in the graphical notation, where the three kinds appear directly.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Zustand",
        "IRI-based": "State",
        "en": "State"
      },
      "comment": {
        "de": "Zustand eines Produkts, einer Energie oder einer Information an einer bestimmten Stelle eines Prozesses, entweder vor einer Umwandlung oder danach.",
        "en": "The condition of a product, an energy or an information at a given point of a process, either before a transformation or after it."
      },
      "id": "13",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#AlternativeFlow",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.2.2 models alternative process runs as separate flows, again without additional graphical elements. The class is a design decision of this pattern.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Alternativfluss",
        "IRI-based": "AlternativeFlow",
        "en": "Alternative Flow"
      },
      "comment": {
        "de": "Fluss, der Teil eines getrennten Flusses ist und sich gegenseitig ausschließende Prozesswege bezeichnet.",
        "en": "A flow that is part of a separate flow denoting mutually exclusive process paths."
      },
      "id": "4",
      "superClasses": [
        "1"
      ],
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#Flow",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1, page 8. Figure 3 lists the flow among the eight symbols of the graphical notation, where it is an edge rather than an object. Reifying it as a class is a design decision of this pattern.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Fluss",
        "IRI-based": "Flow",
        "en": "Flow"
      },
      "subClasses": [
        "4",
        "9"
      ],
      "comment": {
        "de": "Gerichtete Verbindung von Produkten zwischen Prozessoperatoren.",
        "en": "A directed connection of products between process operators."
      },
      "id": "1",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#Energy",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Energie",
        "IRI-based": "Energy",
        "en": "Energy"
      },
      "comment": {
        "de": "Energie, die von einem Prozessoperator benötigt oder freigesetzt wird, beispielsweise elektrische Energie oder Wärme.",
        "en": "Energy required or released by a process operator, for example electrical energy or heat."
      },
      "id": "17",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#ProcessOperator",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1, pages 8 and 9.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Prozessoperator",
        "IRI-based": "ProcessOperator",
        "en": "Process Operator"
      },
      "comment": {
        "de": "Vorgang, durch den der Eingangszustand von Produkten, Energien oder Informationen in einen Ausgangszustand umgewandelt wird.",
        "en": "An operation transforming the input state of products, energies or information into an output state."
      },
      "id": "2",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#ParallelFlow",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.2.1 models parallel process runs as a partially shared flow and requires no additional graphical elements for them. The class is a design decision of this pattern.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Parallelfluss",
        "IRI-based": "ParallelFlow",
        "en": "Parallel Flow"
      },
      "comment": {
        "de": "Fluss, der Teil eines teilweise gemeinsamen Flusses ist und nebenläufig ablaufende Prozessschritte bezeichnet.",
        "en": "A flow that is part of a partially shared flow denoting process steps running concurrently."
      },
      "id": "9",
      "superClasses": [
        "1"
      ],
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#SystemBorder",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1. The standard calls this the Systemgrenze, which is a system limit rather than a border. The class name follows the English wording of the standard's own translation.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Systemgrenze",
        "IRI-based": "SystemBorder",
        "en": "System Border"
      },
      "comment": {
        "de": "Grenze, die den Betrachtungshorizont eines Prozesses festlegt. Unter bestimmten Bedingungen kann sie auch als Bilanzgrenze für ein- und ausgehende Produkte und Energien aufgefasst werden.",
        "en": "The boundary determining the observation horizon of a process. Under certain conditions it may also be regarded as a balance limit for incoming and outgoing products and energies."
      },
      "id": "11",
      "attributes": []
    },
    {
      "iri": "https://w3id.org/aias/odp/vdi3682#Information",
      "baseIri": "https://w3id.org/aias/odp/vdi3682",
      "instances": 0,
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "VDI 3682 Part 1, Section 4.1.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "Information",
        "IRI-based": "Information",
        "en": "Information"
      },
      "comment": {
        "de": "Information, die ein Prozessoperator zur Durchführung seiner Umwandlung benötigt oder die durch ihn entsteht.",
        "en": "Information required by a process operator to carry out its transformation, or information created by it."
      },
      "id": "18",
      "attributes": []
    }
