      "range": "13",
      "annotations": {
        "note": [
          {
            "identifier": "note",
            "language": "en",
            "value": "Used in two places. A flow carries a state, and a product, an energy or an information has one. The thing is therefore separate from the condition it is in, which is what lets one product appear in a process before and after a transformation.",
            "type": "label"
          }
        ]
      },
      "label": {
        "de": "hat Zustand",
        "IRI-based": "hasState",
        "en": "has state"
      },
      "domain": "16",
      "comment": {
