      "abstract": [
        {
          "identifier": "abstract",
          "language": "en",
          "value": "An ontology design pattern for the formalised description of technical processes according to VDI/VDE 3682 part 1. A process is described as a network: process operators transform the state of products, energies and information, flows connect the operators, technical resources are assigned to the operators that carry them out, and a system border bounds what is described. Every definition carries the German wording of the standard alongside its English translation. The pattern is one of three subdomain patterns of the AIAS information model and is meant to be imported and aligned rather than used on its own.",
          "type": "label"
        }
      ],
      "title": [
        {
          "identifier": "title",
          "language": "en",
          "value": "VDI 3682 Ontology Design Pattern",
          "type": "label"
        }
      ],
