  {
    "@id": "https://w3id.org/aias/odp/vdi3682#hasInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a process operator to a flow entering it."
      },
      {
        "@language": "de",
        "@value": "Verbindet einen Prozessoperator mit einem in ihn eingehenden Fluss."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#ProcessOperator"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has input"
      },
      {
        "@language": "de",
        "@value": "hat Eingang"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#Flow"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#isInput"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The flow is the input, not the state. The state is reached from the flow through hasState, one step further along."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@language": "en",
        "@value": "An ontology design pattern for the formalised description of technical processes according to VDI/VDE 3682 part 1. A process is described as a network: process operators transform the state of products, energies and information, flows connect the operators, technical resources are assigned to the operators that carry them out, and a system border bounds what is described. Every definition carries the German wording of the standard alongside its English translation. The pattern is one of three subdomain patterns of the AIAS information model and is meant to be imported and aligned rather than used on its own."
      }
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@language": "en",
        "@value": "M. Schieseck, P. Topalis, L. Reinpold, F. Gehlhoff and A. Fay, \"A Formal Model for Artificial Intelligence Applications in Automation Systems,\" 2024 IEEE 29th International Conference on Emerging Technologies and Factory Automation (ETFA), Padova, Italy, IEEE, September 2024. DOI 10.1109/ETFA61755.2024.10710890"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-09-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Alexander Fay"
      },
      {
        "@value": "Felix Gehlhoff"
      },
      {
        "@value": "Lasse Reinpold"
      },
      {
        "@value": "Marvin Schieseck"
      },
      {
        "@value": "Philip Topalis"
      }
    ],
    "http://purl.org/dc/terms/hasVersion": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682"
      }
    ],
    "http://purl.org/dc/terms/license": [
