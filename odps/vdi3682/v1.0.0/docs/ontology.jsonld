      },
      {
        "@language": "en",
        "@value": "Technical Process"
      },
      {
        "@language": "en",
        "@value": "VDI 3682"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "VDI 3682 Ontology Design Pattern"
      }
    ],
    "http://purl.org/ontology/bibo/doi": [
      {
        "@value": "10.1109/ETFA61755.2024.10710890"
      }
    ],
    "http://purl.org/ontology/bibo/status": [
      {
        "@language": "en",
        "@value": "Draft"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "vdi3682"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/aias/odp/vdi3682#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Normative basis: VDI/VDE 3682 Part 1 and Part 2, issue May 2015.\r\n\r\nTwelve classes and seven relations. Every definition carries the German wording of the standard alongside its English translation, since the standard is issued bilingually.\r\n\r\nScope: Part 1 in full, and from Part 2 the state as a class of the information model. The attribute structure of Part 2 Section 4.4 is not covered."
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682/1.0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ],
    "http://xmlns.com/foaf/0.1/fundedBy": [
      {
        "@id": "https://dtecbw.de/"
      }
    ],
    "https://schema.org/codeRepository": [
      {
        "@id": "https://github.com/schiesem/aias"
      }
    ]
  },
  {
    "@id": "http://purl.org/vocab/vann/preferredNamespaceUri",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "http://www.w3.org/2001/XMLSchema#date",
    "@type": [
      "http://www.w3.org/2000/01/rdf-schema#Datatype"
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/license",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "http://purl.org/ontology/bibo/status",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#isOutput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a flow to the process operator it leaves."
      },
      {
        "@language": "de",
        "@value": "Verbindet einen Fluss mit dem Prozessoperator, aus dem er ausgeht."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#Flow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is output of"
      },
      {
        "@language": "de",
        "@value": "ist Ausgang von"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#ProcessOperator"
      }
    ]
  },
  {
    "@id": "http://xmlns.com/foaf/0.1/fundedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#Product",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "de",
        "@value": "Dinge der realen Welt, die im Rahmen eines technischen Prozesses umgewandelt werden."
      },
      {
        "@language": "en",
        "@value": "Things of the real world that are transformed within a technical process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Product"
      },
      {
        "@language": "de",
        "@value": "Produkt"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VDI 3682 Part 1, Section 4.1, page 8. A product is not a kind of state: it has one, which hasState records. The thing and the condition it is in are kept apart, so the same sheet of metal before and after a stamping is one product in two states."
      }
    ]
  },
  {
    "@id": "http://purl.org/vocab/vann/preferredNamespacePrefix",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#SystemBorder",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "de",
        "@value": "Grenze, die den Betrachtungshorizont eines Prozesses festlegt. Unter bestimmten Bedingungen kann sie auch als Bilanzgrenze für ein- und ausgehende Produkte und Energien aufgefasst werden."
      },
      {
        "@language": "en",
        "@value": "The boundary determining the observation horizon of a process. Under certain conditions it may also be regarded as a balance limit for incoming and outgoing products and energies."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "System Border"
      },
      {
        "@language": "de",
        "@value": "Systemgrenze"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VDI 3682 Part 1, Section 4.1. The standard calls this the Systemgrenze, which is a system limit rather than a border. The class name follows the English wording of the standard's own translation."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/modified",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "http://www.w3.org/2004/02/skos/core#note",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#Process",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A network describing a technical process. Its nodes are the states of products, energies and information, its directed edges are the transformation steps carried out by process operators."
      },
      {
        "@language": "de",
        "@value": "Netz zur Beschreibung technischer Prozesse, dessen Knoten die Zustände von Produkten und dessen gerichtete Kanten die Umwandlungsschritte durch Prozessoperatoren darstellen."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Process"
      },
      {
        "@language": "de",
        "@value": "Prozess"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VDI 3682 Part 1, Section 4.1, page 8."
      }
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#isInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a flow to the process operator it enters."
      },
      {
        "@language": "de",
        "@value": "Verbindet einen Fluss mit dem Prozessoperator, in den er eingeht."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#Flow"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is input of"
      },
      {
        "@language": "de",
        "@value": "ist Eingang von"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#ProcessOperator"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The inverse of hasInput. Both directions are stated because a model may describe a process from either end."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/title",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/aias/odp/vdi3682#consistsOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a process to the elements describing it."
      },
      {
        "@language": "de",
        "@value": "Verbindet einen Prozess mit den Elementen, die ihn beschreiben."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/aias/odp/vdi3682#Process"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "de",
        "@value": "besteht aus"
      },
      {
        "@language": "en",
        "@value": "consists of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "_:genid1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The range takes in the process itself, which is how decomposition is recorded here: a process consists of further processes."
      }
    ]
  },
  {
    "@id": "_:genid1",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/aias/odp/vdi3682#Process"
          },
          {
            "@id": "https://w3id.org/aias/odp/vdi3682#ProcessOperator"
          },
          {
            "@id": "https://w3id.org/aias/odp/vdi3682#State"
          },
          {
            "@id": "https://w3id.org/aias/odp/vdi3682#SystemBorder"
          }
        ]
      }
    ]
  }
]