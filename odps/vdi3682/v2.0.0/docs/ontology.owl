  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#isCharacterizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#Characteristic"/>
    <rdfs:comment xml:lang="en">Relates an object of the formalised process description to one of its characteristics.</rdfs:comment>
    <rdfs:label xml:lang="en">is characterized by</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 3.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N436aeabfb1044fb58a24e423a3c6e933">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
