  <rdf:Description rdf:about="http://purl.org/dc/terms/publisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8694c6ab7dea4460a3148ecfa76da52f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#consistsOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#isComposedOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:comment xml:lang="en">Relates a process operator to the more detailed process operators it decomposes into.</rdfs:comment>
    <rdfs:label xml:lang="en">is composed of</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1. Only process operators may be decomposed.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/created">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#ParallelFlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:comment xml:lang="en">A flow that is part of a partially shared flow denoting process steps running concurrently.</rdfs:comment>
    <rdfs:label xml:lang="en">Parallel Flow</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.2.1 recommends modelling parallel process runs as a partially shared flow and explicitly requires no additional graphical elements for them. Introducing a class for the parallel flow is therefore a design decision of this pattern rather than an adoption from the standard.

A parallel flow states that a single connection belongs to a concurrent run. Grouping several connections into one conjunction is expressed through the dependency property between the states involved.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#externalReference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">A reference from an object to an external identification system such as AKZ, KKS or NE 100.</rdfs:comment>
    <rdfs:label xml:lang="en">external reference</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1 and Part 2, Section 5.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf964effa92e34a83931bbdee6a9772f9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:nodeID="N5b7f9090d053414695b53d1ded080982"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Neae3ce6325b54a6091e850e3768b79f4">
    <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/vdi3682#consistsOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasSuccessor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <owl:propertyChainAxiom rdf:nodeID="N6a8ddf1520d94b5086ce3418de38fd1b"/>
    <rdfs:comment xml:lang="en">Relates a process operator to a process operator following it. Inferred, not modelled.</rdfs:comment>
    <rdfs:label xml:lang="en">has successor</rdfs:label>
    <skos:note xml:lang="en">Adopted from the VDI 3682 ODP of Helmut Schmidt University.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N65079db3d2c848609624d5818261e018">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N33f9f30b76db4c639834336f748b1ca5">
    <rdf:first rdf:nodeID="N17b0d0bb4c984af9ac995f2052a63fd9"/>
    <rdf:rest rdf:nodeID="N5a026e9955084b5393f3c5cdec5b08af"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#descriptiveElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Characteristic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The describing part of a characteristic.</rdfs:comment>
    <rdfs:label xml:lang="en">descriptive element</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 5 and Figure 6. The standard fixes the part but leaves its content open.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
