  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#category">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Characteristic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The name of a characteristic.</rdfs:comment>
    <rdfs:label xml:lang="en">category</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 5.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasSubProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:nodeID="Ne66e23bb49614d69ab50e181f7a91c76"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <owl:propertyChainAxiom rdf:nodeID="Nfb7bab5a9bee4d0085a13b6ea039529a"/>
    <rdfs:comment xml:lang="en">Relates a process operator to the process describing its decomposition. Inferred, not modelled.</rdfs:comment>
    <rdfs:label xml:lang="en">has sub process</rdfs:label>
    <skos:note xml:lang="en">Adopted from the VDI 3682 ODP of Helmut Schmidt University. The chain follows isComposedOf and the inverse of consistsOf.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#dependency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <rdfs:comment xml:lang="en">Expresses that two states are required together rather than as alternatives to one another.</rdfs:comment>
    <rdfs:label xml:lang="en">dependency</rdfs:label>
    <skos:note xml:lang="en">Adopted from the VDI 3682 ODP of Helmut Schmidt University and not contained in the standard itself.

Under the open world assumption several inputs of one process operator always denote alternatives. Where inputs are required jointly, this has to be stated explicitly. The property acts as a conjunction between states, so that an expression such as "A and B, or C and D" becomes representable: dependency is asserted between A and B and between C and D.

The property complements ParallelFlow. A parallel flow qualifies a single connection, whereas dependency groups several connections into one conjunction.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#TechnicalResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A physical component of an automated plant that realises the transformation carried out by a process operator.</rdfs:comment>
    <rdfs:label xml:lang="en">Technical Resource</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.2. The class is what a process needs to say who does the work: an operator states what happens, a resource states what performs it, and the assignment ties the two.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbb11b214f11243eb81c15b06b6f6c8e3">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#hasAssignment"/>
    <rdf:rest rdf:nodeID="N6f51064511e842e086c442fae6709f8c"/>
  </rdf:Description>
