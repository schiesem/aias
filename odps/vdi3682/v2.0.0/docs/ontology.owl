    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#hasInput"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb4b0c740e4ea407fa8576a86d2cb5d95">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#consistsOf"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasOperatorSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasSource"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:comment xml:lang="en">Relates a flow to the process operator it originates from.</rdfs:comment>
    <rdfs:label xml:lang="en">has operator source</rdfs:label>
    <skos:note xml:lang="en">Set by the modelling tool according to the type of the connected element. Carries the chain inferring hasOutput.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf70dd4e9812b443bac247da52690557f">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdf:rest rdf:nodeID="N15bd7dbabd794424916f38735cbdc987"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasUpperProcess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N1161fd713d424c0886d681f77e5970aa"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <owl:propertyChainAxiom rdf:nodeID="N0312b4f0f39c45849f7599f183f3d424"/>
    <rdfs:comment xml:lang="en">Relates a process operator to its parent process. Inferred, not modelled.</rdfs:comment>
    <rdfs:label xml:lang="en">has upper process</rdfs:label>
    <skos:note xml:lang="en">Adopted from the VDI 3682 ODP of Helmut Schmidt University. The chain follows the inverse of isComposedOf and the inverse of consistsOf.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#Attribute"/>
    <rdfs:comment xml:lang="en">The attribute uniquely identifying an object and its characteristics over the life cycle of a process description.</rdfs:comment>
    <rdfs:label xml:lang="en">Identification</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1, after IEC 61360-1. It carries a unique ident, a long name, a short name, references to external identification systems, a version number and a revision number.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N17b0d0bb4c984af9ac995f2052a63fd9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#hasOutput"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Characteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#Attribute"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:comment xml:lang="en">An attribute describing a process specific property of an object. It consists of a category, a descriptive element and a relational element.</rdfs:comment>
    <rdfs:label xml:lang="en">Characteristic</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.2 and Figures 5 to 7.

The standard fixes this three-part structure but does not prescribe a vocabulary of properties. The entries shown in its figures, such as setpoint value or validity limits, are examples closed by an open placeholder. Non-functional properties of resources therefore have to draw their vocabulary from a further standard.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Energy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Information"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Product"/>
    <rdfs:comment xml:lang="en">Energy required or released by a process operator, for example electrical energy or heat. Energy occurs as input and as output of a process.</rdfs:comment>
    <rdfs:label xml:lang="en">Energy</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasInput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="Ne4ff2d76e5ff4c98ae646691ced54a91"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:propertyChainAxiom rdf:nodeID="Nb7aa3bdeeff743f2891261564c21b172"/>
    <rdfs:comment xml:lang="en">Relates a process operator to a state entering it. Inferred from the reified flows, not modelled directly.</rdfs:comment>
    <rdfs:label xml:lang="en">has input</rdfs:label>
    <skos:note xml:lang="en">The chain reads: a flow leading to this operator originates from that state. Typed sub properties keep the inference from firing between two states or two operators.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nea2557d0c3934bcbba769c2803ae4f3c">
    <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasOutput"/>
  </rdf:Description>
