  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#isWithin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N2dd91f8a27c24dff8f6e60e8dda18ab3"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <rdfs:comment xml:lang="en">Relates a state, a process operator or a flow to the system limit enclosing it.</rdfs:comment>
    <rdfs:label xml:lang="en">is within</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1 introduces the system limit as the observation horizon but does not name a relation locating elements inside it. This relation is an addition of this pattern, required to determine which elements lie within a given system limit and whether that limit may serve as a balance limit.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1eaa068f3b4a4723a45ab5cd55350c6a">
