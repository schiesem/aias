  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#shortName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The coded name of an object.</rdfs:comment>
    <rdfs:label xml:lang="en">short name</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N79911e9505f044639f94dc94e19a15e6">
    <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/vdi3682#isComposedOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:range rdf:nodeID="Nccec012933de43258da12b40947ff6fa"/>
    <rdfs:comment xml:lang="en">Relates a flow to the element it originates from.</rdfs:comment>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <skos:note xml:lang="en">Super property of the two typed source properties. Chains are defined on the typed sub properties only, so that inference cannot fire between two elements of the same kind.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4adf0d94b45849b389b1aa3f8aa36d9f">
    <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasOperatorTarget"/>
  </rdf:Description>
