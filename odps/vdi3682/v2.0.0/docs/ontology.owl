  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#AlternativeFlow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#ParallelFlow"/>
    <rdfs:comment xml:lang="en">A flow that is part of a separate flow denoting mutually exclusive process paths.</rdfs:comment>
    <rdfs:label xml:lang="en">Alternative Flow</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.2.2 models alternative process runs as separate flows, again without additional graphical elements. Introducing a class for the alternative flow is a design decision of this pattern. Where alternative flows are present, the system limit must not be used as a balance limit.</skos:note>
  </rdf:Description>
