    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na46e9d2dc2e24fa6b3b7743aa26f1063">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <rdf:rest rdf:nodeID="Ne2b9a47990dd438cb59dea9a07fc1d9d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#State">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">The condition of a product, an energy or an information at a given point of a process, either as the status ante operationem before a transformation or as the status post operationem after it.</rdfs:comment>
    <rdfs:label xml:lang="en">State</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 2 carries state as a class of the information model. Part 1, Section 4.1 deliberately avoids the term in the graphical notation because it is considered ambiguous there, and works with product, energy and information directly. This pattern follows Part 2.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbf6f655150ee4f3288bf193d0868754d">
    <rdf:first rdf:nodeID="Neae3ce6325b54a6091e850e3768b79f4"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/rights">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Assignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Attribute"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">The structural connection through which the execution of a process operator is assigned to a technical resource.</rdfs:comment>
    <rdfs:label xml:lang="en">Assignment</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Figure 3 carries this relation as the usage symbol, an edge of the graphical notation.

Reifying the assignment as a class is a design decision of this pattern, taken for the same reasons as the reification of the flow. The VDI 3682 ODP of Helmut Schmidt University models it as the object property isAssignedTo.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N97ac3f76fceb4727833b54774b413409">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#hasInput"/>
    <rdf:rest rdf:nodeID="N6ef8812c38464a8fa0f32f589b6164fb"/>
  </rdf:Description>
