   xmlns:vdi3682="https://w3id.org/aias/odp/vdi3682#">
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Flow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">A directed connection transporting a product, an energy or an information between a state and a process operator.</rdfs:comment>
    <rdfs:label xml:lang="en">Flow</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Figure 3 lists the flow as one of the eight symbols of the graphical notation, where it is an edge rather than an object.

Reifying the flow as a class is a design decision of this pattern and deviates from the VDI 3682 ODP of Helmut Schmidt University, which models flows as object properties. A reified flow can be identified, annotated and marked as parallel or alternative, none of which an edge can carry.

The direct properties hasInput and hasOutput are retained and inferred from the reified flows through property chains, so that reasoning over predecessor and successor is unaffected by the reification.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#isIdentifiedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:comment xml:lang="en">Relates an object of the formalised process description to its identification.</rdfs:comment>
    <rdfs:label xml:lang="en">is identified by</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 3, cardinality one.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#relationalElement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Characteristic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The relation establishing part of a characteristic.</rdfs:comment>
    <rdfs:label xml:lang="en">relational element</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 5 and Figure 7.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N0df8a608c40846e9b109cf247ea591f0"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:propertyChainAxiom rdf:nodeID="N92772a9bfff447d486fea052c75311c9"/>
    <rdfs:comment xml:lang="en">Relates a process operator to a state leaving it. Inferred from the reified flows, not modelled directly.</rdfs:comment>
    <rdfs:label xml:lang="en">has output</rdfs:label>
    <skos:note xml:lang="en">The chain reads: a flow originating from this operator leads to that state.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nef867e46981c47099cd28cb5a47a4c8e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="Nb58c3f2cb8104703b1091454358ab1a6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#consistsOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <rdfs:range rdf:nodeID="Nc64553dd282b497ebb2e5f50bd8dadd3"/>
    <rdfs:comment xml:lang="en">Relates a process to the elements it contains, namely its states, process operators and its system limit.</rdfs:comment>
    <rdfs:label xml:lang="en">consists of</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Figure 2, aggregation.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nb4b0c740e4ea407fa8576a86d2cb5d95"/>
    <rdfs:subClassOf rdf:nodeID="N49c1ee6135bb45e48039fe438f922054"/>
    <rdfs:subClassOf rdf:nodeID="N8694c6ab7dea4460a3148ecfa76da52f"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">A network describing a technical process. Its nodes are the states of products, energies and information, its directed edges are the transformation steps carried out by process operators.</rdfs:comment>
    <rdfs:label xml:lang="en">Process</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1. Part 2, Figure 2 constrains a process to exactly one system limit, at least one process operator and at least two states.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasStateTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasTarget"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <rdfs:comment xml:lang="en">Relates a flow to the state it leads to.</rdfs:comment>
    <rdfs:label xml:lang="en">has state target</rdfs:label>
    <skos:note xml:lang="en">Set by the modelling tool according to the type of the connected element. Carries the chain inferring hasOutput.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nccec012933de43258da12b40947ff6fa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N1397bd89ffe543b6b56557ad32154567"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Attribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">A property of an object of the formalised process description. Two kinds of attribute exist, the identification and the characteristics.</rdfs:comment>
    <rdfs:label xml:lang="en">Attribute</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5 and Figure 3.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#versionNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The version of an object. A new version arises when the values of its attributes change.</rdfs:comment>
    <rdfs:label xml:lang="en">version number</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1. This property is a standard backed anchor for tracking the model states of an AI application across the engineering method.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/aias/odp/vdi3682/2.0.0"/>
    <dcterms:bibliographicCitation>TODO: citation of the accompanying publication</dcterms:bibliographicCitation>
    <dcterms:contributor>TODO: co-authors</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-14</dcterms:created>
    <dcterms:creator>TODO: author name, ORCID</dcterms:creator>
    <dcterms:description xml:lang="en">Ontology design pattern for the formalised description of technical processes according to VDI/VDE 3682 Part 1 (concept and graphic representation) and Part 2 (information model), issue May 2015.

The pattern covers the process network of states and process operators, the technical resources realising the operators, the system limit bounding the observation horizon, and the attribute structure of identification and characteristics.

The pattern is one of four subdomain patterns of the AIAS information model, which describes AI applications in automated plants together with the automated plant and the technical process. It is designed to be imported through owl:imports and aligned by way of the AIAS alignment ontology.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:publisher>TODO: institution</dcterms:publisher>
    <dcterms:rights>TODO: funding statement, projects EKI and OptiFlex, dtec.bw</dcterms:rights>
    <dcterms:source rdf:resource="https://www.vdi.de/richtlinien/details/vdivde-3682-blatt-1-formalisierte-prozessbeschreibungen-konzept-und-grafische-darstellung"/>
    <dcterms:title xml:lang="en">VDI 3682 Ontology Design Pattern</dcterms:title>
    <bibo:status xml:lang="en">Draft</bibo:status>
    <vann:preferredNamespacePrefix>vdi3682</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/aias/odp/vdi3682#</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Normative basis: VDI/VDE 3682 Part 1 and Part 2, issue May 2015.

Relation to prior work: this pattern is built independently but adopts several design decisions from the VDI 3682 ODP of the Institute of Automation Technology at Helmut Schmidt University (https://github.com/hsu-aut/IndustrialStandard-ODP-VDI3682, MIT licence). Adopted are the property chains for predecessor, successor, sub process and upper process, the defined class axiom for ProcessOperator, the dependency property expressing conjunction between states under the open world assumption, and the attribute structure of Identification and Characteristic.

Structural deviations from that pattern are deliberate and documented at the affected elements: flows are reified as classes rather than expressed as object properties, assignments are reified as classes, and the system limit carries an explicit containment relation. See the notes on Flow, Assignment and SystemLimit.</rdfs:comment>
    <owl:versionInfo>2.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5fb513d6a0b748bb82e085d27bd2c3ac">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <rdf:rest rdf:nodeID="N49fc5caa408c40248c99c31d2786e4b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <rdfs:comment xml:lang="en">Things of the real world that are transformed within a technical process. The generic term also covers flows of materials and substances.</rdfs:comment>
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#ProcessOperator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nef867e46981c47099cd28cb5a47a4c8e"/>
    <rdfs:subClassOf rdf:nodeID="N793ff730543b4e26b203190c66008eef"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#SystemLimit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">An operation transforming the input state of products, energies or information into an output state. The process operator realises this transformation by means of technical resources.</rdfs:comment>
    <rdfs:label xml:lang="en">Process Operator</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1. Only process operators may be decomposed; states are not decomposed (Part 1, Section 2).

The defined class axiom follows the VDI 3682 ODP of Helmut Schmidt University: anything with an input and an output that is contained in a process is a process operator. Anything with an input and an output alone may also be a process.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb7aa3bdeeff743f2891261564c21b172">
    <rdf:first rdf:nodeID="N4adf0d94b45849b389b1aa3f8aa36d9f"/>
    <rdf:rest rdf:nodeID="N612a0a0fa3034b548f47a0d82d2c260b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasPredecessor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <owl:inverseOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasSuccessor"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <owl:propertyChainAxiom rdf:nodeID="N97ac3f76fceb4727833b54774b413409"/>
    <rdfs:comment xml:lang="en">Relates a process operator to a process operator preceding it. Inferred, not modelled.</rdfs:comment>
    <rdfs:label xml:lang="en">has predecessor</rdfs:label>
    <skos:note xml:lang="en">Adopted from the VDI 3682 ODP of Helmut Schmidt University. Two operators are never adjacent directly; the chain passes through the shared state.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#revisionNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The revision of an object, describing its accredited version.</rdfs:comment>
    <rdfs:label xml:lang="en">revision number</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N30b4214d33634b6f8606cded53b8247e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#hasInput"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#longName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The preferred name of an object.</rdfs:comment>
    <rdfs:label xml:lang="en">long name</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#uniqueIdent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Identification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The unique code identifying an object.</rdfs:comment>
    <rdfs:label xml:lang="en">unique ident</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 2, Section 5.1, after IEC 61360-1.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#Assignment"/>
    <rdfs:comment xml:lang="en">Relates a process operator to an assignment describing which technical resource realises it.</rdfs:comment>
    <rdfs:label xml:lang="en">has assignment</rdfs:label>
    <skos:note xml:lang="en">Directed counterpart of the usage symbol of VDI 3682 Part 1, Figure 3.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5a026e9955084b5393f3c5cdec5b08af">
    <rdf:first rdf:nodeID="Nf964effa92e34a83931bbdee6a9772f9"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasOperatorTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/aias/odp/vdi3682#hasTarget"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:comment xml:lang="en">Relates a flow to the process operator it leads to.</rdfs:comment>
    <rdfs:label xml:lang="en">has operator target</rdfs:label>
    <skos:note xml:lang="en">Set by the modelling tool according to the type of the connected element. Carries the chain inferring hasInput.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#SystemLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">The boundary determining the observation horizon of a process. Under certain conditions it may also be regarded as a balance limit for incoming and outgoing products and energies.</rdfs:comment>
    <rdfs:label xml:lang="en">System Limit</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1. The system limit must not be used as a balance limit when alternative process runs are described.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#assignedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Assignment"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <rdfs:comment xml:lang="en">Relates an assignment to the technical resource realising the assigned process operator.</rdfs:comment>
    <rdfs:label xml:lang="en">assigned resource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2a229cdfbfaa41c6858173c709ec4dbb">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#Process"/>
    <rdf:rest rdf:nodeID="N88fcef360e7c46d8b01f65ad600589d9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#isAssignedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
    <rdfs:range rdf:resource="https://w3id.org/aias/odp/vdi3682#TechnicalResource"/>
    <owl:propertyChainAxiom rdf:nodeID="Nbb11b214f11243eb81c15b06b6f6c8e3"/>
    <rdfs:comment xml:lang="en">Relates a process operator directly to the technical resource realising it. Inferred from the reified assignment, not modelled directly.</rdfs:comment>
    <rdfs:label xml:lang="en">is assigned to</rdfs:label>
    <skos:note xml:lang="en">Shortcut across the reified assignment, provided so that queries need not traverse the reification. The VDI 3682 ODP of Helmut Schmidt University carries this property as the primary modelling construct.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#Information">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
    <owl:disjointWith rdf:resource="https://w3id.org/aias/odp/vdi3682#Product"/>
    <rdfs:comment xml:lang="en">Information required by a process operator to carry out its transformation, or information created by it.</rdfs:comment>
    <rdfs:label xml:lang="en">Information</rdfs:label>
    <skos:note xml:lang="en">VDI 3682 Part 1, Section 4.1. One of the three kinds of state a process moves, alongside product and energy.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aias/odp/vdi3682#hasTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/aias/odp/vdi3682#Flow"/>
    <rdfs:range rdf:nodeID="Nc619f872795e4a66bd92475eb0190142"/>
    <rdfs:comment xml:lang="en">Relates a flow to the element it leads to.</rdfs:comment>
    <rdfs:label xml:lang="en">has target</rdfs:label>
    <skos:note xml:lang="en">Super property of the two typed target properties.</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2b9a47990dd438cb59dea9a07fc1d9d">
    <rdf:first rdf:resource="https://w3id.org/aias/odp/vdi3682#ProcessOperator"/>
