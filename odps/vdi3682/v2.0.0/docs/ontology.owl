  <rdf:Description rdf:nodeID="N49c1ee6135bb45e48039fe438f922054">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/aias/odp/vdi3682#consistsOf"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/aias/odp/vdi3682#State"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb58c3f2cb8104703b1091454358ab1a6">
    <rdf:first rdf:nodeID="N30b4214d33634b6f8606cded53b8247e"/>
