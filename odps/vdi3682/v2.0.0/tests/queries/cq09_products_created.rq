# CQ 09: Which products arise in the process, and which are consumed again?
#
# Reports the operators a product touches and in which role. The ordering along
# the process comes from hasSuccessor, which question 05 covers.
PREFIX vdi3682: <https://w3id.org/aias/odp/vdi3682#>
SELECT ?product ?role ?operator WHERE {
  ?product a vdi3682:Product .
  { ?operator vdi3682:hasInput  ?product . BIND("consumed by" AS ?role) }
  UNION
  { ?operator vdi3682:hasOutput ?product . BIND("produced by" AS ?role) }
} ORDER BY ?product ?role ?operator
