# CQ 11: Which states are neither input nor output of an operator?
#
# DISTINCT, because a state reached through several operators would otherwise
# be reported once per operator. The question asks about the state, not about
# how many ways lead to it.
#
# On these test cases every reported state is an endpoint of the process, which
# is correct. The query exists to find dangling intermediate states, which
# would be modelling errors.
PREFIX vdi3682: <https://w3id.org/aias/odp/vdi3682#>
SELECT DISTINCT ?state ?issue WHERE {
  { ?state a/^<http://www.w3.org/2000/01/rdf-schema#subClassOf>* vdi3682:State .
    ?op vdi3682:hasInput ?state .
    FILTER NOT EXISTS { ?any vdi3682:hasOutput ?state }
    BIND("never produced" AS ?issue) }
  UNION
  { ?op2 vdi3682:hasOutput ?state .
    FILTER NOT EXISTS { ?any2 vdi3682:hasInput ?state }
    BIND("never consumed" AS ?issue) }
} ORDER BY ?state
