# CQ 08: Of which kind are the states of a case: product, energy or information?
#
# Asserted types, not inferred ones. The three subtypes are disjoint, so each
# state carries exactly one of them.
PREFIX vdi3682: <https://w3id.org/aias/odp/vdi3682#>
SELECT ?stateType ?state WHERE {
  ?state a ?stateType .
  FILTER(?stateType IN (vdi3682:Product, vdi3682:Energy, vdi3682:Information))
} ORDER BY ?stateType ?state
